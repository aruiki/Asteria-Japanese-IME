diff --git a/src/data/kotori/BUILD.bazel b/src/data/kotori/BUILD.bazel
new file mode 100644
index 000000000..9ad496ce6
--- /dev/null
+++ b/src/data/kotori/BUILD.bazel
@@ -0,0 +1,66 @@
+# Kotori: MSI に同梱する物(docs/adr/0016、0017)。モデル(*.gguf)はコミットしないので、ビルドの前に
+# ここに置く(mozc/README.md)。
+package(default_visibility = ["//visibility:public"])
+
+exports_files([
+    "short_lexicon.tsv",
+    "short_lexicon.json",
+    "NOTICE-short-lexicon.txt",
+    "fast_collocations.txt",
+    "fast_collocations.json",
+    "NOTICE-fast-collocations.txt",
+    "zenz-v2.5-small-q8_0.gguf",
+    "zenz-v2.5-native-generator-20261017-q8_0.gguf",
+    "native_generator.json",
+    "zenz-v2.5-medium-q8_0.gguf",
+    "tinyswallow-1.5b-q5_k_m.gguf",
+    "NOTICE-zenz.txt",
+    "NOTICE-tinyswallow.txt",
+    "NOTICE-third-party.txt",
+    "LICENSE-llvm-openmp.txt",
+    "LICENSE-GPL-3.0.txt",
+    "license.rtf",
+    "banner.bmp",
+    "dialog.bmp",
+])
+
+# Kotori: 最終比較した公開語彙を既定の辞書へ加える。falseは回帰比較専用。
+config_setting(
+    name = "without_short_lexicon",
+    define_values = {"asteria_short_lexicon": "false"},
+)
+
+genrule(
+    name = "empty_short_lexicon",
+    outs = ["empty_short_lexicon.tsv"],
+    cmd = "printf '' > $@",
+)
+
+filegroup(
+    name = "short_lexicon_data",
+    srcs = select({
+        ":without_short_lexicon": [":empty_short_lexicon"],
+        "//conditions:default": ["short_lexicon.tsv"],
+    }),
+)
+
+# Kotori: 2024年以降のWikipediaの記事題名から作る固有名詞・新語の辞書(mozc/tools/build_name_lexicon.py)。
+# 開発用の評価で確かめるまでは既定で入れない。trueのときだけ name_lexicon.tsv を辞書へ加える。
+config_setting(
+    name = "with_name_lexicon",
+    define_values = {"asteria_name_lexicon": "true"},
+)
+
+genrule(
+    name = "empty_name_lexicon",
+    outs = ["empty_name_lexicon.tsv"],
+    cmd = "printf '' > $@",
+)
+
+filegroup(
+    name = "name_lexicon_data",
+    srcs = select({
+        ":with_name_lexicon": ["name_lexicon.tsv"],
+        "//conditions:default": [":empty_name_lexicon"],
+    }),
+)
