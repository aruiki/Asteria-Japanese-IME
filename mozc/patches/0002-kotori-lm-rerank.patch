+  // 裏で計算中の先回りの変換と、変換の要求が来ている読み(読み + TAB + 前の文)。job_mu_ で守る。
+  mutable std::string running_convert_;
+  mutable std::string running_preview_;  // MemoKey、job_mu_ で守る。
+  mutable ConversionRequest::KotoriInputGeneration running_preview_input_;
+  // 最後に変換した読み(読み + TAB + 前の文)。先回りの変換でやり直さない。job_mu_ で守る。
+  mutable std::string last_converted_key_;
+  // 最後に要求(変換・Tab)が終わった時刻(steady_clock、マイクロ秒)。
+  mutable std::atomic<int64_t> last_request_us_{0};
+  mutable std::string urgent_key_;
+  mutable std::deque<Entry> cache_;
+  // 文全体で選んだ結果(MemoKey と結果)。job_mu_ で守る。
+  mutable std::deque<std::pair<std::string, std::optional<Best>>> memo_;
+  // 入力中の候補を取り直すまでの時間(ms。KOTORI_LM_LIVE_FIRST / KOTORI_LM_LIVE_NEXT。
+  // 負なら GPU の有無で決める。KOTORI_LM_LIVE=0 で取り直さない。docs/adr/0039)。
+  bool live_ = true;
+  int live_first_ms_ = -1;
+  int live_next_ms_ = -1;
+  mutable std::atomic<uint64_t> model_epoch_{1};
+  // job_mu_で保護。FindMemo/StoreMemo/Applyはこの同じ識別情報を照合する。
+  mutable std::shared_ptr<const CorrectionModels> correction_models_;
+  std::atomic<bool> stop_{false};
+  // 裏の予測の仕事が新しく来たか(来たら今の計算をやめる)。
+  mutable std::atomic<bool> new_job_{false};
+  // 変換の要求が来ている数(裏の予測はこれが 1 以上なら途中でやめる)。
+  mutable std::atomic<int> urgent_{0};
+  // 裏の予測を始めるまでに、次の打鍵を待つ時間(ms)。軽い計算と作り直し。負なら計算しない。
+  // KOTORI_LM_LIGHT_DELAY / KOTORI_LM_FULL_DELAY。
+  int light_delay_ms_ = 0;
+  int full_delay_ms_ = 600;
+  // 軽い計算(打鍵ごと)の続きの数(読み全体の変換、打ちかけを除いた変換)とトークン数。
+  // KOTORI_LM_LIGHT_BEAMS="全体,打ちかけ,トークン"。
+  int light_beams_ = 2;
+  int light_head_beams_ = 3;
+  int light_tokens_ = 6;
+  // 軽い計算の最後に LLM で並べ直すか(KOTORI_LM_LIGHT_RANK)。
+  bool light_rank_ = true;
+  // サジェストに出す AI の予測の数。
+  int suggest_count_ = 2;
+  // 文全体の選択に入れる、ラティスの文全体の候補の数(KOTORI_LM_NSENT)。
+  size_t max_sentences_ = 4;
+  bool sentence_ = true;
+  bool post_segment_ = false;
+  bool right_context_ = true;
+  double lambda_lm_ = 1.0;
+  double lambda_llm_ = 0.7;
+  // 生成した文(ラティスにない文)の点数から引く値。LLM なし / あり。
+  double gen_penalty_ = 0.5;
+  double gen_penalty_llm_ = 0.0;
+  double lambda_lattice_ = 1.0;
+  double temperature_ = 1000.0;
+  int threads_ = 4;
+  std::string env_model_path_;
+  std::string env_llm_path_;
+  std::string model_dir_;
+  std::string runtime_dir_;
+};
