+TEST(ConversionRequestTest, KotoriGenerationSurvivesCopyAndView) {
+  auto owner = std::make_shared<std::atomic<uint64_t>>(3);
+  ConversionRequest::KotoriInputGeneration generation{owner, 3};
+  const auto original = ConversionRequestBuilder()
+      .SetKotoriInputGeneration(generation).Build();
+  const auto copied = ConversionRequestBuilder().SetConversionRequest(original).Build();
