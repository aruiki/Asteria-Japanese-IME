diff --git a/src/rewriter/zenz_scorer.cc b/src/rewriter/zenz_scorer.cc
new file mode 100644
index 000000000..b04585b07
--- /dev/null
+++ b/src/rewriter/zenz_scorer.cc
@@ -0,0 +1,871 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/zenz_scorer.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+#include "base/util.h"
+#include "llama.h"
+#include "rewriter/llama_runtime.h"
+
+namespace mozc {
+namespace {
+
+// このスレッドの生成を途中でやめるかを返す関数(ZenzScorer::SetThreadCancel)。
+thread_local std::function<bool()> tl_cancel;
+
+constexpr uint32_t kNumContext = 2048;
+// 1 回の計算で扱うトークン数。大きいと、結果(ロジット)を受け取る領域が語彙数 × この数だけ要る
+// (LLM は語彙が 15 万なので、4096 だと約 2.5 GB)。
+// 256 にすると、512 と速さは同じで VRAM が約 170 MB 減る(docs/adr/0032)。
+constexpr int kBatch = 256;
+constexpr int kMaxCandidates = 32;
+constexpr size_t kMaxContextChars = 40;
+
+// UTF-8 の文字列を文字(コードポイント)ごとの文字列にする。
+std::vector<std::string> SplitChars(absl::string_view s) {
+  std::vector<std::string> out;
+  for (size_t i = 0; i < s.size();) {
+    const unsigned char c = s[i];
+    size_t n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+    n = std::min(n, s.size() - i);
+    out.emplace_back(s.substr(i, n));
+    i += n;
+  }
+  return out;
+}
+
+// 改行を落とし、空白を全角空白にする(Zenzai と同じ)。
+std::string Normalize(absl::string_view text) {
+  std::string out;
+  for (const std::string& c : SplitChars(text)) {
+    if (c == "\n" || c == "\r") continue;
+    out += (c == " ") ? "\xE3\x80\x80" : c;
+  }
+  return out;
+}
+
+// ひらがな(U+3041..U+3096)をカタカナにする。
+std::string ToKatakana(absl::string_view reading) {
+  std::string out;
+  for (const std::string& c : SplitChars(reading)) {
+    if (c.size() == 3 && static_cast<unsigned char>(c[0]) == 0xE3) {
+      const uint32_t cp =
+          ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+      if (cp >= 0x3041 && cp <= 0x3096) {
+        const uint32_t k = cp + 0x60;
+        out += static_cast<char>(0xE0 | (k >> 12));
+        out += static_cast<char>(0x80 | ((k >> 6) & 0x3F));
+        out += static_cast<char>(0x80 | (k & 0x3F));
+        continue;
+      }
+    }
+    out += c;
+  }
+  return out;
+}
+
+std::vector<llama_token> Tokenize(const llama_vocab* vocab,
+                                  const std::string& text, bool special = false) {
+  std::vector<llama_token> tokens(text.size() + 8);
+  int n = llama_tokenize(vocab, text.data(), text.size(), tokens.data(),
+                         tokens.size(), false, special);
+  if (n < 0) {
+    tokens.resize(-n);
+    n = llama_tokenize(vocab, text.data(), text.size(), tokens.data(),
+                       tokens.size(), false, special);
+  }
+  tokens.resize(std::max(n, 0));
+  return tokens;
+}
+
+// log Σ exp(logits)。対数確率は logits[t] - LogSumExp。
+// 最大値より 20 以上小さい値は足さない(exp(-20) ≈ 2e-9。語彙が 15 万でも誤差は 3e-4 以下)。
+// LLM は語彙が大きく、すべての exp を計算すると CPU の時間の大半になるため。
+float LogSumExp(const float* logits, int n) {
+  const float max = *std::max_element(logits, logits + n);
+  static const bool exact = std::getenv("KOTORI_LM_EXACT_LSE") != nullptr;
+  const float cut = exact ? -std::numeric_limits<float>::infinity() : max - 20.f;
+  float sum = 0;
+  for (int i = 0; i < n; ++i) {
+    if (logits[i] > cut) sum += std::exp(logits[i] - max);
+  }
+  return max + std::log(sum);
+}
+
+// logits の上位 k 件のトークン(大きい順)。k は小さい(ビームの数)ので、1 回の走査で選ぶ。
+void TopK(const float* logits, int n, int k, std::vector<int>* out) {
+  out->clear();
+  float floor = -std::numeric_limits<float>::infinity();
+  for (int i = 0; i < n; ++i) {
+    if (static_cast<int>(out->size()) == k && logits[i] <= floor) continue;
+    auto it = std::find_if(out->begin(), out->end(),
+                           [&](int j) { return logits[j] < logits[i]; });
+    out->insert(it, i);
+    if (static_cast<int>(out->size()) > k) out->pop_back();
+    if (static_cast<int>(out->size()) == k) floor = logits[out->back()];
+  }
+}
+
+std::vector<float> LogSoftmax(const float* logits, int n) {
+  float max = -std::numeric_limits<float>::infinity();
+  for (int i = 0; i < n; ++i) max = std::max(max, logits[i]);
+  double sum = 0;
+  for (int i = 0; i < n; ++i) sum += std::exp(logits[i] - max);
+  const float lse = max + static_cast<float>(std::log(sum));
+  std::vector<float> out(n);
+  for (int i = 0; i < n; ++i) out[i] = logits[i] - lse;
+  return out;
+}
+
+// 計算量の累計(ZenzScorer::Stats)。[0] が zenz、[1] が LLM。
+struct Counters {
+  std::atomic<int64_t> work_us{0}, decode_us{0}, calls{0}, tokens{0};
+};
+Counters g_stats[2];
+
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// 範囲の時間を work_us に足す。
+class WorkTimer {
+ public:
+  explicit WorkTimer(bool zenz) : c_(g_stats[zenz ? 0 : 1]), t0_(NowUs()) {}
+  ~WorkTimer() { c_.work_us += NowUs() - t0_; }
+
+ private:
+  Counters& c_;
+  int64_t t0_;
+};
+
+int Decode(llama_context* ctx, const llama_batch& b, bool zenz) {
+  Counters& c = g_stats[zenz ? 0 : 1];
+  const int64_t t0 = NowUs();
+  const int rc = llama_decode(ctx, b);
+  // GPU の計算の終わりまで待って数える(結果を読むときにどのみち待つ)。
+  if (rc == 0) llama_synchronize(ctx);
+  c.decode_us += NowUs() - t0;
+  ++c.calls;
+  c.tokens += b.n_tokens;
+  if (std::getenv("KOTORI_LM_TRACE") != nullptr) {
+    std::fprintf(stderr, "[decode] %s n=%d %.1fms\n", zenz ? "zenz" : "llm",
+                 b.n_tokens, (NowUs() - t0) / 1000.0);
+  }
+  return rc;
+}
+
+}  // namespace
+
+std::string ZenzScorer::Stats() {
+  char buf[256];
+  auto f = [](const Counters& c) {
+    return std::make_tuple(c.work_us.load() / 1000.0, c.decode_us.load() / 1000.0,
+                           static_cast<long long>(c.calls.load()),
+                           static_cast<long long>(c.tokens.load()));
+  };
+  const auto [zw, zd, zc, zt] = f(g_stats[0]);
+  const auto [lw, ld, lc, lt] = f(g_stats[1]);
+  std::snprintf(buf, sizeof(buf),
+                "zenz work=%.0fms decode=%.0fms calls=%lld tokens=%lld | "
+                "llm work=%.0fms decode=%.0fms calls=%lld tokens=%lld",
+                zw, zd, zc, zt, lw, ld, lc, lt);
+  return buf;
+}
+
+std::string ZenzScorer::Prompt(absl::string_view left_context,
+                               absl::string_view reading) {
+  std::vector<std::string> ctx = SplitChars(Normalize(left_context));
+  if (ctx.size() > kMaxContextChars) {
+    ctx.erase(ctx.begin(), ctx.end() - kMaxContextChars);
+  }
+  std::string out = "\xEE\xB8\x80";  // U+EE00
+  out += Normalize(ToKatakana(reading));
+  if (!ctx.empty()) {
+    out += "\xEE\xB8\x82";  // U+EE02
+    for (const std::string& c : ctx) out += c;
+  }
+  out += "\xEE\xB8\x81";  // U+EE01
+  return out;
+}
+
+std::unique_ptr<ZenzScorer> ZenzScorer::Open(const std::string& path,
+                                             int threads,
+                                             const std::string& runtime_dir,
+                                             bool identify_model) {
+  // Kotori: 読み込みの前にハッシュと読み取り専用の共有ハンドルを取得する。
+  // ハッシュを取得できなくても既存の採点は使い、自由生成補正だけを無効にする。
+  auto identity = identify_model ? KotoriModelIdentity::Open(path) : nullptr;
+  if (!EnsureLlamaRuntime(runtime_dir)) return nullptr;
+  llama_model_params mp = llama_model_default_params();
+  // 選んだ GPU 1 つだけに全部の層を載せる(なければ CPU で動く)。ほかの GPU(内蔵 GPU など)には
+  // 分けない(docs/adr/0024)。
+  ggml_backend_dev_t devices[2] = {LlamaGpuDevice(), nullptr};
+  mp.devices = devices;
+  mp.n_gpu_layers = devices[0] != nullptr ? 999 : 0;
+  // GPU に載せるなら、ファイルをメモリに写したまま持たない(RAM を使い続けないため)。
+  if (devices[0] != nullptr) mp.load_mode = LLAMA_LOAD_MODE_NONE;
+  llama_model* model = llama_model_load_from_file(path.c_str(), mp);
+  if (model == nullptr) return nullptr;
+  llama_context_params cp = llama_context_default_params();
+  cp.n_ctx = kNumContext;
+  cp.n_batch = kBatch;
+  cp.n_ubatch = kBatch;
+  cp.n_seq_max = kMaxCandidates + 1;
+  cp.n_threads = threads;
+  cp.n_threads_batch = threads;
+  cp.kv_unified = true;
+  llama_context* ctx = llama_init_from_model(model, cp);
+  if (ctx == nullptr) {
+    llama_model_free(model);
+    return nullptr;
+  }
+  std::unique_ptr<ZenzScorer> s(new ZenzScorer());
+  s->identity_ = std::move(identity);
+  s->model_ = model;
+  s->ctx_ = ctx;
+  s->max_seq_ = kMaxCandidates;
+  // zenz は 1 文字ずつの小さな語彙(6000)を持つ。汎用の LLM(語彙が数万以上)なら、
+  // 読みを使わず log P(候補 | 左の文脈) で採点する(docs/adr/0016)。
+  s->zenz_ = llama_vocab_n_tokens(llama_model_get_vocab(model)) <= 16000;
+  return s;
+}
+
+ZenzScorer::~ZenzScorer() {
+  if (ctx_ != nullptr) llama_free(ctx_);
+  if (model_ != nullptr) llama_model_free(model_);
+}
+
+std::optional<std::vector<float>> ZenzScorer::Score(
+    absl::string_view left_context, absl::string_view reading,
+    const std::vector<std::string>& candidates) {
+  WorkTimer timer(zenz_);
+  if (candidates.empty() ||
+      candidates.size() > static_cast<size_t>(max_seq_)) {
+    return std::nullopt;
+  }
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const int n_vocab = llama_vocab_n_tokens(vocab);
+  const llama_token eos = llama_vocab_eos(vocab);
+  std::vector<llama_token> prefix;
+  if (zenz_) {
+    prefix = Tokenize(vocab, Prompt(left_context, reading));
+  } else {
+    // 先頭のトークンを足すのは、モデルが付けるよう求めるときだけ(Qwen 系は付けない)。
+    const llama_token bos = llama_vocab_bos(vocab);
+    if (bos >= 0 && llama_vocab_get_add_bos(vocab)) prefix.push_back(bos);
+    std::string ctx(left_context);
+    if (ctx.empty() && prefix.empty()) ctx = "\n";
+    const std::vector<llama_token> t = Tokenize(vocab, ctx);
+    prefix.insert(prefix.end(), t.begin(), t.end());
+  }
+  if (prefix.empty()) return std::nullopt;
+  std::vector<std::vector<llama_token>> cands;
+  for (const std::string& c : candidates) {
+    if (zenz_) {
+      cands.push_back(Tokenize(vocab, Normalize(c)));
+      cands.back().push_back(eos);
+    } else {
+      cands.push_back(Tokenize(vocab, c));
+    }
+    if (cands.back().empty()) return std::nullopt;
+  }
+  // 前置きの最後の 1 トークンより前は、前回の計算(シーケンス 0)を使い回す(UsePrefix)。
+  // 候補は木(トライ)にまとめ、共通の先頭は 1 回だけ計算する(docs/adr/0024)。トークンは、
+  // そこを通る候補のシーケンス(1..n)すべてに属させる。前置きの最後のトークンも各組で計算し、
+  // 最初のトークンの分布を得る。候補が 1 回の計算(kBatch トークン)に収まらなければ組に分ける。
+  if (!UsePrefix(prefix)) return std::nullopt;
+  const int last_pos = static_cast<int>(prefix.size()) - 1;
+  std::vector<float> scores(cands.size(), 0.f);
+  llama_memory_t mem = llama_get_memory(ctx_);
+  struct Node {
+    llama_token token;
+    int parent;  // -1 なら前置きの最後
+    int depth;   // 候補の中の位置(0 から)
+    std::vector<int> seqs;
+    bool has_child = false;
+  };
+  size_t start = 0;
+  while (start < cands.size()) {
+    // この組の木を作る。
+    std::vector<Node> nodes;
+    std::vector<std::vector<int>> path;  // 候補ごとの節の番号
+    size_t end_c = start;
+    while (end_c < cands.size() && end_c - start < static_cast<size_t>(max_seq_)) {
+      std::vector<Node> trial = nodes;
+      std::vector<int> p;
+      int parent = -1;
+      const int seq = static_cast<int>(end_c - start) + 1;
+      for (size_t j = 0; j < cands[end_c].size(); ++j) {
+        int found = -1;
+        for (size_t n = 0; n < trial.size(); ++n) {
+          if (trial[n].parent == parent && trial[n].token == cands[end_c][j]) {
+            found = static_cast<int>(n);
+            break;
+          }
+        }
+        if (found < 0) {
+          trial.push_back({cands[end_c][j], parent, static_cast<int>(j), {}, false});
+          found = static_cast<int>(trial.size()) - 1;
+          if (parent >= 0) trial[parent].has_child = true;
+        }
+        trial[found].seqs.push_back(seq);
+        p.push_back(found);
+        parent = found;
+      }
+      if (trial.size() + 1 > static_cast<size_t>(kBatch)) break;
+      nodes = std::move(trial);
+      path.push_back(std::move(p));
+      ++end_c;
+    }
+    if (end_c == start) {  // 1 つの候補も収まらない
+      ResetMemory();
+      return std::nullopt;
+    }
+    const int n_seq = static_cast<int>(end_c - start);
+    for (int q = 1; q <= n_seq; ++q) {
+      llama_memory_seq_rm(mem, q, -1, -1);
+      llama_memory_seq_cp(mem, 0, q, -1, -1);
+    }
+    llama_batch b = llama_batch_init(nodes.size() + 1, 0, n_seq);
+    b.token[0] = prefix.back();
+    b.pos[0] = last_pos;
+    b.n_seq_id[0] = n_seq;
+    for (int q = 0; q < n_seq; ++q) b.seq_id[0][q] = q + 1;
+    b.logits[0] = 1;
+    for (size_t n = 0; n < nodes.size(); ++n) {
+      const Node& node = nodes[n];
+      b.token[n + 1] = node.token;
+      b.pos[n + 1] = last_pos + 1 + node.depth;
+      b.n_seq_id[n + 1] = static_cast<int>(node.seqs.size());
+      for (size_t q = 0; q < node.seqs.size(); ++q) {
+        b.seq_id[n + 1][q] = node.seqs[q];
+      }
+      b.logits[n + 1] = node.has_child;
+    }
+    b.n_tokens = static_cast<int>(nodes.size()) + 1;
+    const int rc = Decode(ctx_, b, zenz_);
+    llama_batch_free(b);
+    if (rc != 0) {
+      ResetMemory();
+      return std::nullopt;
+    }
+    // 節ごとの log Σ exp は 1 回だけ計算する。
+    std::vector<float> lse(nodes.size() + 1, std::nanf(""));
+    auto logp_at = [&](int batch_index, llama_token t) {
+      const float* l = llama_get_logits_ith(ctx_, batch_index);
+      if (std::isnan(lse[batch_index])) lse[batch_index] = LogSumExp(l, n_vocab);
+      return l[t] - lse[batch_index];
+    };
+    for (int q = 0; q < n_seq; ++q) {
+      float logp = 0;
+      for (int n : path[q]) {
+        const int parent = nodes[n].parent;
+        logp += logp_at(parent < 0 ? 0 : parent + 1, nodes[n].token);
+      }
+      scores[start + q] = logp;
+    }
+    start = end_c;
+  }
+  KeepPrefix(prefix);
+  return scores;
+}
+
+bool ZenzScorer::UsePrefix(const std::vector<llama_token>& prefix) {
+  // シーケンス 0 に prefix の最後の 1 トークンより前を置く。前回と同じ所は計算し直さない。
+  llama_memory_t mem = llama_get_memory(ctx_);
+  const size_t want = prefix.size() - 1;
+  size_t keep = 0;
+  while (keep < cached_.size() && keep < want && cached_[keep] == prefix[keep]) {
+    ++keep;
+  }
+  for (int q = 1; q <= max_seq_; ++q) llama_memory_seq_rm(mem, q, -1, -1);
+  llama_memory_seq_rm(mem, 0, static_cast<llama_pos>(keep), -1);
+  cached_.resize(keep);
+  // やめる関数があるときは 32 トークンずつ計算し、その間にやめられるようにする(CPU では前置きの
+  // 計算が長い)。ないときは 1 回で計算する(GPU では呼ぶ回数が効くため)。
+  const size_t kPrefixChunk = tl_cancel ? 32 : static_cast<size_t>(kBatch);
+  for (size_t at = keep; at < want;) {
+    if (at > keep && tl_cancel && tl_cancel()) {
+      ResetMemory();
+      return false;
+    }
+    const size_t n = std::min(want - at, kPrefixChunk);
+    llama_batch b = llama_batch_init(n, 0, 1);
+    for (size_t i = 0; i < n; ++i) {
+      b.token[i] = prefix[at + i];
+      b.pos[i] = static_cast<llama_pos>(at + i);
+      b.n_seq_id[i] = 1;
+      b.seq_id[i][0] = 0;
+      b.logits[i] = 0;
+    }
+    b.n_tokens = n;
+    const int rc = Decode(ctx_, b, zenz_);
+    llama_batch_free(b);
+    if (rc != 0) {
+      ResetMemory();
+      return false;
+    }
+    at += n;
+  }
+  cached_.assign(prefix.begin(), prefix.begin() + want);
+  return true;
+}
+
+void ZenzScorer::KeepPrefix(const std::vector<llama_token>& prefix) {
+  // 次の呼び出しのために、シーケンス 0 の prefix の最後の 1 トークンより前だけを残す。
+  llama_memory_t mem = llama_get_memory(ctx_);
+  for (int q = 1; q <= max_seq_; ++q) llama_memory_seq_rm(mem, q, -1, -1);
+  const size_t want = prefix.empty() ? 0 : prefix.size() - 1;
+  llama_memory_seq_rm(mem, 0, static_cast<llama_pos>(want), -1);
+  cached_.assign(prefix.begin(), prefix.begin() + want);
+}
+
+void ZenzScorer::ResetMemory() {
+  llama_memory_clear(llama_get_memory(ctx_), true);
+  cached_.clear();
+}
+
+void ZenzScorer::SetThreadCancel(std::function<bool()> cancel) {
+  tl_cancel = std::move(cancel);
+}
+
+std::vector<std::vector<std::vector<llama_token>>> ZenzScorer::BeamSearch(
+    const std::vector<Root>& roots,
+    const std::function<bool(llama_token)>& is_end, bool finish_at_max,
+    bool include_end_token) {
+  WorkTimer timer(zenz_);
+  const int n_roots = static_cast<int>(roots.size());
+  std::vector<std::vector<std::vector<llama_token>>> result(n_roots);
+  // シーケンス: 前置きは 0..n_roots-1。ビームは 2 組(交互に使う)で、根ごとに beams 個ずつ。
+  int total_beams = 0;
+  for (const Root& r : roots) {
+    if (r.beams < 1 || r.prefix.empty() ||
+        r.prefix.size() + r.max_len + 1 > kNumContext) {
+      return result;
+    }
+    total_beams += r.beams;
+  }
+  if (n_roots == 0 || n_roots + 2 * total_beams > max_seq_ + 1 ||
+      n_roots > kBatch) {
+    return result;
+  }
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const int n_vocab = llama_vocab_n_tokens(vocab);
+  llama_memory_t mem = llama_get_memory(ctx_);
+  // Kotori: 前置きの計算(docs/adr/0033)。根 0 の前置きの最後の 1 トークンより前はシーケンス 0 に置き、
+  // 前回と同じ所は計算し直さない(打鍵ごとの予測では、前の文と変換の大半が同じ)。ほかの根は、根 0 と
+  // 同じ先頭をシーケンス 0 から写し、残りだけを計算する。前置きの残りと、すべての根の最後のトークン
+  // (最初の分布を得る)は、なるべく 1 回の計算にまとめる(GPU では呼ぶ回数が効く)。
+  std::vector<int> first_logit(n_roots, 0);
+  {
+    const auto& p0 = roots[0].prefix;
+    const size_t want0 = p0.size() - 1;
+    size_t keep = 0;
+    while (keep < cached_.size() && keep < want0 && cached_[keep] == p0[keep]) {
+      ++keep;
+    }
+    for (int q = 1; q <= max_seq_; ++q) llama_memory_seq_rm(mem, q, -1, -1);
+    llama_memory_seq_rm(mem, 0, static_cast<llama_pos>(keep), -1);
+    cached_.resize(keep);
+    std::vector<size_t> from(n_roots, keep);
+    for (int r = 1; r < n_roots; ++r) {
+      const auto& pr = roots[r].prefix;
+      size_t c = 0;
+      while (c < keep && c + 1 < pr.size() && pr[c] == p0[c]) ++c;
+      if (c > 0) llama_memory_seq_cp(mem, 0, r, 0, static_cast<llama_pos>(c));
+      from[r] = c;
+    }
+    // やめる関数があるときは 32 トークンずつ計算し、その間にやめられるようにする(CPU では前置きの
+    // 計算が長い)。
+    const int chunk = tl_cancel ? 32 : kBatch;
+    llama_batch b = llama_batch_init(kBatch, 0, 1);
+    b.n_tokens = 0;
+    bool ok = true;
+    auto flush = [&]() {
+      if (b.n_tokens == 0) return true;
+      const int rc = Decode(ctx_, b, zenz_);
+      b.n_tokens = 0;
+      return rc == 0;
+    };
+    auto add = [&](llama_token t, size_t pos, int seq, bool logits) {
+      const int at = b.n_tokens++;
+      b.token[at] = t;
+      b.pos[at] = static_cast<llama_pos>(pos);
+      b.n_seq_id[at] = 1;
+      b.seq_id[at][0] = seq;
+      b.logits[at] = logits ? 1 : 0;
+      return at;
+    };
+    for (int r = 0; r < n_roots && ok; ++r) {
+      const auto& pr = roots[r].prefix;
+      for (size_t i = from[r]; i + 1 < pr.size() && ok; ++i) {
+        if (b.n_tokens >= chunk) {
+          ok = flush();
+          if (ok && tl_cancel && tl_cancel()) ok = false;
+        }
+        if (ok) add(pr[i], i, r, false);
+      }
+    }
+    // 最後のトークンは 1 回にまとめる(入りきらなければ先に流す)。
+    if (ok && b.n_tokens + n_roots > kBatch) ok = flush();
+    for (int r = 0; r < n_roots && ok; ++r) {
+      const auto& pr = roots[r].prefix;
+      first_logit[r] = add(pr.back(), pr.size() - 1, r, true);
+    }
+    ok = ok && flush();
+    llama_batch_free(b);
+    if (!ok) {
+      ResetMemory();
+      return result;
+    }
+    cached_.assign(p0.begin(), p0.begin() + want0);
+  }
+
+  struct Beam {
+    std::vector<llama_token> tokens;
+    float logp = 0;
+    int seq = 0;
+    int logit_index = 0;  // 直前の decode での位置(最初は前置きの最後)
+  };
+  struct State {
+    std::vector<Beam> live;
+    std::vector<std::pair<float, std::vector<llama_token>>> done;
+    int bank_start[2] = {0, 0};  // 2 組のビームのシーケンスの先頭
+    int bank = 0;
+    bool finished = false;
+  };
+  std::vector<State> st(n_roots);
+  {
+    int seq_next = n_roots;
+    for (int r = 0; r < n_roots; ++r) {
+      st[r].live.push_back({{}, 0.f, r, first_logit[r]});
+      st[r].bank_start[0] = seq_next;
+      st[r].bank_start[1] = seq_next + roots[r].beams;
+      seq_next += 2 * roots[r].beams;
+    }
+  }
+
+  // 1 ステップごとに、すべての根の伸びたビームを 1 つのバッチで評価する。親の KV を新しい
+  // シーケンスに写してから次のトークンを評価する。logits は各ビームの直前のトークンの位置のもの。
+  std::vector<int> idx;
+  for (int step = 0;; ++step) {
+    if (tl_cancel && tl_cancel()) {
+      ResetMemory();
+      return std::vector<std::vector<std::vector<llama_token>>>(n_roots);
+    }
+    struct Grown {
+      int root;
+      int parent_seq;
+      Beam beam;
+    };
+    std::vector<Grown> batch;
+    for (int r = 0; r < n_roots; ++r) {
+      State& s = st[r];
+      if (s.finished) continue;
+      const int beams = roots[r].beams;
+      if (step >= roots[r].max_len || s.live.empty()) {
+        s.finished = true;
+        continue;
+      }
+      struct Next {
+        float logp;
+        size_t parent;
+        llama_token token;
+      };
+      std::vector<Next> next;
+      for (size_t p = 0; p < s.live.size(); ++p) {
+        const float* l = llama_get_logits_ith(ctx_, s.live[p].logit_index);
+        const float lse = LogSumExp(l, n_vocab);
+        TopK(l, n_vocab, beams, &idx);
+        for (int j = 0; j < static_cast<int>(idx.size()); ++j) {
+          next.push_back({s.live[p].logp + l[idx[j]] - lse, p, idx[j]});
+        }
+      }
+      std::sort(next.begin(), next.end(),
+                [](const Next& a, const Next& b) { return a.logp > b.logp; });
+      std::vector<Beam> grown;
+      std::vector<int> parents;
+      for (const Next& n : next) {
+        if (static_cast<int>(grown.size()) + static_cast<int>(s.done.size()) >=
+            beams) {
+          break;
+        }
+        std::vector<llama_token> t = s.live[n.parent].tokens;
+        if (is_end(n.token)) {
+          const size_t token_count = t.size() + 1;
+          // Kotori: 改行と本文が同じトークンの場合、本文も一緒に落とさない。
+          if (include_end_token && n.token != llama_vocab_eos(vocab) &&
+              !llama_vocab_is_eog(vocab, n.token)) {
+            t.push_back(n.token);
+          }
+          if (!t.empty()) s.done.push_back({n.logp / token_count, std::move(t)});
+          continue;
+        }
+        t.push_back(n.token);
+        grown.push_back({std::move(t), n.logp, 0, 0});
+        parents.push_back(s.live[n.parent].seq);
+      }
+      if (grown.empty()) {
+        s.finished = true;
+        s.live.clear();
+        continue;
+      }
+      if (step + 1 == roots[r].max_len) {
+        // 長さの上限に達したビームは、そこで終わりにする(続きの生成で使う)。
+        if (finish_at_max) {
+          for (const Beam& g : grown) {
+            s.done.push_back({g.logp / g.tokens.size(), g.tokens});
+          }
+        }
+        s.finished = true;
+        s.live.clear();
+        continue;
+      }
+      for (size_t i = 0; i < grown.size(); ++i) {
+        batch.push_back({r, parents[i], std::move(grown[i])});
+      }
+    }
+    if (batch.empty()) break;
+    llama_batch b = llama_batch_init(batch.size(), 0, 1);
+    std::vector<int> used(n_roots, 0);
+    for (size_t i = 0; i < batch.size(); ++i) {
+      Grown& g = batch[i];
+      State& s = st[g.root];
+      const int seq = s.bank_start[s.bank] + used[g.root]++;
+      llama_memory_seq_rm(mem, seq, -1, -1);
+      llama_memory_seq_cp(mem, g.parent_seq, seq, -1, -1);
+      g.beam.seq = seq;
+      g.beam.logit_index = static_cast<int>(i);
+      b.token[i] = g.beam.tokens.back();
+      b.pos[i] = roots[g.root].prefix.size() + g.beam.tokens.size() - 1;
+      b.n_seq_id[i] = 1;
+      b.seq_id[i][0] = seq;
+      b.logits[i] = 1;
+    }
+    b.n_tokens = batch.size();
+    const int rc = Decode(ctx_, b, zenz_);
+    llama_batch_free(b);
+    if (rc != 0) break;
+    // 使い終わった親のシーケンスを消し(前置きのシーケンスは残す)、ビームを入れ替える。
+    for (int r = 0; r < n_roots; ++r) {
+      if (used[r] == 0) continue;
+      for (const Beam& lb : st[r].live) {
+        if (lb.seq >= n_roots) llama_memory_seq_rm(mem, lb.seq, -1, -1);
+      }
+      st[r].live.clear();
+      st[r].bank ^= 1;
+    }
+    for (Grown& g : batch) st[g.root].live.push_back(std::move(g.beam));
+  }
+  KeepPrefix(roots[0].prefix);
+  for (int r = 0; r < n_roots; ++r) {
+    auto& done = st[r].done;
+    std::stable_sort(done.begin(), done.end(), [](const auto& a, const auto& b) {
+      return a.first > b.first;
+    });
+    for (auto& d : done) result[r].push_back(std::move(d.second));
+  }
+  return result;
+}
+
+size_t ZenzScorer::CountTokens(absl::string_view text) {
+  return Tokenize(llama_model_get_vocab(model_), std::string(text)).size();
+}
+
+std::string ZenzScorer::Detokenize(const std::vector<llama_token>& tokens) {
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  std::string text;
+  for (llama_token t : tokens) {
+    char buf[256];
+    const int n = llama_token_to_piece(vocab, t, buf, sizeof(buf), 0, false);
+    if (n > 0) text.append(buf, n);
+  }
+  return text;
+}
+
+std::vector<std::string> ZenzScorer::Generate(absl::string_view left_context,
+                                              absl::string_view reading,
+                                              int beams) {
+  return GenerateMany(left_context, {std::string(reading)}, beams)[0];
+}
+
+std::vector<std::vector<std::string>> ZenzScorer::GenerateMany(
+    absl::string_view left_context, const std::vector<std::string>& readings,
+    int beams) {
+  std::vector<std::vector<std::string>> out(readings.size());
+  if (!zenz_ || readings.empty()) return out;
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const llama_token eos = llama_vocab_eos(vocab);
+  std::vector<Root> roots;
+  for (const std::string& reading : readings) {
+    roots.push_back({Tokenize(vocab, Prompt(left_context, reading)),
+                     static_cast<int>(SplitChars(reading).size()) + 8, beams});
+  }
+  const auto found = BeamSearch(
+      roots, [eos](llama_token t) { return t == eos; }, false);
+  for (size_t r = 0; r < found.size(); ++r) {
+    for (const auto& tokens : found[r]) {
+      std::string text = Detokenize(tokens);
+      // zenz は空白を全角空白で学習している。候補の表記は元の空白に戻す。
+      for (size_t pos; (pos = text.find("\xE3\x80\x80")) != std::string::npos;) {
+        text.replace(pos, 3, " ");
+      }
+      if (!text.empty() &&
+          std::find(out[r].begin(), out[r].end(), text) == out[r].end()) {
+        out[r].push_back(text);
+      }
+    }
+  }
+  return out;
+}
+
+std::vector<std::string> ZenzScorer::Continue(absl::string_view text,
+                                              int max_tokens, int beams) {
+  return ContinueMany({{std::string(text), beams}}, max_tokens)[0];
+}
+
+std::vector<std::string> ZenzScorer::Correct(absl::string_view reading,
+                                            absl::string_view text,
+                                            CorrectionPrompt mode, int beams) {
+  // Kotori: テンプレート制御トークンの混入と複数行の指示を受け付けない。
+  if (beams < 1 || beams > 4 || zenz_ || text.empty() || reading.empty() ||
+      text.size() > 240 ||
+      reading.size() > 240 ||
+      text.find_first_of("<\r\n") != absl::string_view::npos ||
+      reading.find_first_of("<\r\n") != absl::string_view::npos) return {};
+  const auto* vocab = llama_model_get_vocab(model_);
+  const bool typing = mode == CorrectionPrompt::kTypingExamples;
+  const bool examples = mode == CorrectionPrompt::kExamples || typing;
+  std::vector<llama_token> prefix;
+  if (examples) {
+    // Kotori: correction-reading-fewshot.txt と同じ読み付きの3例。チャット化しない。
+    const std::string typing_examples =
+        "日本語IMEの誤変換と1文字の打ち間違いを最小限直す。名前、数字、否定、時制は変えない。正しい文は変えない。\n\n"
+        "読み: あめがふっている\n変換候補: 雨が振っている\n修正: 雨が降っている\n\n"
+        "読み: まどをしめました\n変換候補: 窓を閉めました\n修正: 窓を閉めました\n\n"
+        "読み: これはちょとむずかしい\n変換候補: これはちょと難しい\n修正: これはちょっと難しい\n\n";
+    const std::string prompt = (typing ? typing_examples : std::string(
+        "日本語IMEの変換候補を、読みを変えず、誤変換だけ最小限直す。正しい文は変えない。\n\n"
+        "読み: あめがふっている\n"
+        "変換候補: 雨が振っている\n"
+        "修正: 雨が降っている\n\n"
+        "読み: かいぎのしりょうをさくせいする\n"
+        "変換候補: 会議の資料を作成する\n"
+        "修正: 会議の資料を作成する\n\n"
+        "読み: きのうはがっこうにいきました\n"
+        "変換候補: 昨日は学校に行きまいた\n"
+        "修正: 昨日は学校に行きました\n\n")) +
+        "読み: " + std::string(reading) + "\n変換候補: " + std::string(text) +
+        "\n修正:";
+    const llama_token bos = llama_vocab_bos(vocab);
+    if (bos >= 0 && llama_vocab_get_add_bos(vocab)) prefix.push_back(bos);
+    const auto tokens = Tokenize(vocab, prompt);
+    prefix.insert(prefix.end(), tokens.begin(), tokens.end());
+  } else if (mode == CorrectionPrompt::kChat) {
+    const char* tmpl = llama_model_chat_template(model_, nullptr);
+    // Kotori: 任意のチャット API がないランタイムでは、チャット補正だけを使わない。
+    if (tmpl == nullptr) return {};
+    const std::string prompt =
+        "日本語IMEの誤変換を修正してください。読みを守り、誤字だけを最小限直してください。"
+        "説明や引用符を付けず、修正した文だけを出力してください。読み：" +
+        std::string(reading) + "\n変換候補：" + std::string(text);
+    const llama_chat_message message{"user", prompt.c_str()};
+    std::string formatted(4096, '\0');
+    const int length = llama_chat_apply_template(
+        tmpl, &message, 1, true, formatted.data(), formatted.size());
+    if (length <= 0 || length > formatted.size()) return {};
+    formatted.resize(length);
+    prefix = Tokenize(vocab, formatted, true);
+  } else {
+    return {};
+  }
+  const auto found = BeamSearch(
+      {{std::move(prefix), 80, beams}},
+      [&](llama_token tok) {
+        return tok == llama_vocab_eos(vocab) || llama_vocab_is_eog(vocab, tok) ||
+               (examples && Detokenize({tok}).find_first_of("\r\n") !=
+                                std::string::npos);
+      },
+      false, examples);
+  std::vector<std::string> out;
+  if (found.empty()) return out;
+  for (const auto& tokens : found[0]) {
+    std::string value = Detokenize(tokens);
+    if (examples) {
+      const size_t newline = value.find_first_of("\r\n");
+      if (newline != std::string::npos) value.resize(newline);
+      const size_t first = value.find_first_not_of(' ');
+      if (first == std::string::npos) continue;
+      if (first > 0) {
+        const auto script = Util::GetScriptType(
+            Util::Utf8SubString(absl::string_view(value).substr(first), 0, 1));
+        if (script == Util::HIRAGANA || script == Util::KATAKANA ||
+            script == Util::KANJI) {
+          // 「修正: 」のASCII空白だけを除く。本文や他の空白は変更しない。
+          value.erase(0, first);
+        }
+      }
+    }
+    if (!value.empty()) out.push_back(std::move(value));
+  }
+  return out;
+}
+
+std::vector<std::vector<std::string>> ZenzScorer::ContinueMany(
+    const std::vector<std::pair<std::string, int>>& texts, int max_tokens) {
+  std::vector<std::vector<std::string>> out(texts.size());
+  if (zenz_ || texts.empty()) return out;
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const llama_token bos = llama_vocab_bos(vocab);
+  std::vector<Root> roots;
+  for (const auto& [text, beams] : texts) {
+    std::vector<llama_token> prefix;
+    if (bos >= 0 && llama_vocab_get_add_bos(vocab)) prefix.push_back(bos);
+    const std::vector<llama_token> t = Tokenize(vocab, text);
+    prefix.insert(prefix.end(), t.begin(), t.end());
+    roots.push_back({std::move(prefix), max_tokens, beams});
+  }
+  const llama_token eos = llama_vocab_eos(vocab);
+  // 句読点・閉じ括弧・改行・文の終わりで止める(予測は文の切れ目まで)。
+  auto is_end = [&](llama_token tok) {
+    if (tok == eos || llama_vocab_is_eog(vocab, tok)) return true;
+    const std::string piece = Detokenize({tok});
+    for (const char* stop : {"\xE3\x80\x82", "\xE3\x80\x81", "\xEF\xBC\x81",
+                             "\xEF\xBC\x9F", "\xE3\x80\x8D", "\xEF\xBC\x89",
+                             "\n", ".", ",", "!", "?"}) {
+      if (piece.find(stop) != std::string::npos) return true;
+    }
+    return false;
+  };
+  const auto found = BeamSearch(roots, is_end, true);
+  for (size_t r = 0; r < found.size(); ++r) {
+    for (const auto& tokens : found[r]) {
+      std::string s = Detokenize(tokens);
+      if (!s.empty() &&
+          std::find(out[r].begin(), out[r].end(), s) == out[r].end()) {
+        out[r].push_back(s);
+      }
+    }
+  }
+  return out;
+}
+
+}  // namespace mozc
