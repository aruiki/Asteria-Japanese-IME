+TEST_F(LmRewriterGenerationTest, RejectsPastInputAtPublicationAndApplication) {
+  auto owner = std::make_shared<std::atomic<uint64_t>>(1);
+  const auto old_request = Request({owner, 1});
+  const auto old = Corrected({owner, 1});
+  ASSERT_TRUE(Save(old));
+  EXPECT_TRUE(Recall(old_request));
+  EXPECT_TRUE(Apply(old, old_request));
+  owner->fetch_add(2);  // Edit away and back to the same reading.
+  const auto current_request = Request({owner, 3});
+  EXPECT_FALSE(Recall(old_request));
+  EXPECT_FALSE(Recall(current_request));
+  EXPECT_FALSE(Apply(old, current_request));
+  EXPECT_FALSE(Save(old));
+  ASSERT_TRUE(Save(Corrected({owner, 3})));
+  EXPECT_FALSE(Save(old));  // A late worker cannot overwrite the new result.
+  EXPECT_TRUE(Recall(current_request));
+}
