--- a/src/engine/engine_converter.cc
+++ b/src/engine/engine_converter.cc
@@ -130,6 +130,39 @@ EngineConverter::EngineConverter(
   conversion_preferences_.request_suggestion = true;
   candidate_list_.set_page_size(request_->candidate_page_size());
   SetConfig(std::move(config));
+  kotori_request_signature_ = request_->SerializeAsString();
+}
+
+EngineConverter::~EngineConverter() { KotoriInvalidateInput(); }
+
+void EngineConverter::KotoriInvalidateInput() {
+  kotori_input_generation_->fetch_add(1);
+  kotori_last_input_.clear();
+  kotori_last_cursor_ = std::numeric_limits<size_t>::max();
+  kotori_last_field_ = -1;
+}
+
+ConversionRequest::KotoriInputGeneration EngineConverter::KotoriObserveInput(
+    const composer::Composer& composer) {
+  // 保護欄・AI無効では読みや本文を取得せず、処理中の世代だけを無効化する。
+  if (!config_ || !config_->kotori_lm_enabled() || config_->incognito_mode() ||
+      request_->is_incognito_mode() ||
+      composer.GetInputFieldType() == commands::Context::PASSWORD) {
+    KotoriInvalidateInput();
+    return {};
+  }
+  const std::string input = composer.GetQueryForConversion() + "\x1f" +
+                            composer.GetStringForPreedit();
+  const size_t cursor = composer.GetCursor();
+  const int field = static_cast<int>(composer.GetInputFieldType());
+  if (input != kotori_last_input_ || cursor != kotori_last_cursor_ ||
+      field != kotori_last_field_) {
+    kotori_input_generation_->fetch_add(1);
+    kotori_last_input_ = input;
+    kotori_last_cursor_ = cursor;
+    kotori_last_field_ = field;
+  }
+  return {kotori_input_generation_, kotori_input_generation_->load()};
 }
 
