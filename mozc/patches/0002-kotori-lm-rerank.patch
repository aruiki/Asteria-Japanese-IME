+
+namespace mozc {
+namespace {
+
+// これより長い読みは、zenz に文を書かせない(ラティスの文を採点するだけにする)。
+constexpr size_t kMaxGenerateChars = 120;
+// これより長い読みは、AI の予測をしない(予測は短い打ちかけに使うもので、長いと遅い)。
+constexpr size_t kMaxPredictChars = 40;
+// これより文節が多いときは、文節ごとの見直しをしない(1 文節ごとに採点するので遅い)。
+constexpr size_t kMaxSegmentsToRescore = 16;
+// GPU のないとき、AI を使う読みの長さの上限(文字)。CPU の zenz-medium では、これより長い文の生成・採点が
+// 時間の上限に収まらず、採点の 1 回の計算は途中で止められないため(docs/adr/0029)。
+constexpr size_t kMaxCpuChars = 60;
+// Kotori: 打ち間違いの補正を試す読みの長さの上限(docs/adr/0036)。
+constexpr size_t kMaxTypoChars = 40;
+
+// UTF-8 の文字を 1 つずつ(コードポイントで)返す。
+std::vector<uint32_t> CodePoints(absl::string_view text) {
+  std::vector<uint32_t> out;
+  for (size_t i = 0; i < text.size();) {
+    const unsigned char c = text[i];
+    const size_t len = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+    uint32_t cp = c;
+    if (len == 2 && i + 1 < text.size()) {
+      cp = ((c & 0x1F) << 6) | (text[i + 1] & 0x3F);
+    } else if (len == 3 && i + 2 < text.size()) {
+      cp = ((c & 0x0F) << 12) | ((text[i + 1] & 0x3F) << 6) |
+           (text[i + 2] & 0x3F);
+    } else if (len == 4 && i + 3 < text.size()) {
+      cp = ((c & 0x07) << 18) | ((text[i + 1] & 0x3F) << 12) |
+           ((text[i + 2] & 0x3F) << 6) | (text[i + 3] & 0x3F);
+    }
+    out.push_back(cp);
+    i += len;
+  }
+  return out;
+}
+
+// Kotori: 生成補正に渡す文と生成結果は、正しい UTF-8 の単一行に限る。
+// 通常の採点・予測には適用しない。
+bool IsValidCorrectionText(absl::string_view text) {
+  if (text.empty() || text.size() > 240 ||
+      text.find('<') != absl::string_view::npos) {
+    return false;
+  }
+  while (!text.empty()) {
+    char32_t cp = 0;
+    absl::string_view rest;
+    // Util は歴史的な5・6バイト列も扱うので、Unicodeのスカラー値に追加制限する。
+    if (!Util::SplitFirstChar32(text, &cp, &rest) || cp > 0x10FFFF ||
+        (cp >= 0xD800 && cp <= 0xDFFF) ||
+        cp < 0x20 || (cp >= 0x7F && cp <= 0x9F) || cp == 0xAD ||
+        (cp >= 0x600 && cp <= 0x605) || cp == 0x61C || cp == 0x6DD ||
+        cp == 0x70F || (cp >= 0x890 && cp <= 0x891) || cp == 0x8E2 ||
+        cp == 0x180E || (cp >= 0xFFF9 && cp <= 0xFFFB) ||
+        cp == 0x110BD || cp == 0x110CD ||
+        (cp >= 0x13430 && cp <= 0x1343F) ||
+        (cp >= 0x1BCA0 && cp <= 0x1BCA3) ||
+        (cp >= 0x1D173 && cp <= 0x1D17A) || cp == 0xE0001 ||
+        (cp >= 0xE0020 && cp <= 0xE007F) ||
+        (cp >= 0x200B && cp <= 0x200F) ||
+        (cp >= 0x2028 && cp <= 0x202E) ||
+        (cp >= 0x2060 && cp <= 0x206F) || cp == 0xFEFF) {
+      return false;
+    }
+    text = rest;
+  }
+  return true;
+}
+
+bool IsKana(uint32_t cp) {
+  return (cp >= 0x3041 && cp <= 0x3096) || (cp >= 0x30A1 && cp <= 0x30FA);
+}
+
+// かな(ひらがな・カタカナ)の文字数(読みを漢字に変えずに写しただけの生成を見分けるのに使う)。
+size_t CountKana(absl::string_view text) {
+  size_t n = 0;
+  for (uint32_t cp : CodePoints(text)) n += IsKana(cp) ? 1 : 0;
+  return n;
+}
+
+// 小書きのかな(ゃ・ョ など)が、かなでない文字のすぐ後に来るか(「機ョ」)。日本語として
+// ありえないので、そういう生成は除く。
+bool HasStraySmallKana(absl::string_view text) {
+  static constexpr uint32_t kSmall[] = {
+      0x3041, 0x3043, 0x3045, 0x3047, 0x3049, 0x3083, 0x3085, 0x3087, 0x308E,
+      0x30A1, 0x30A3, 0x30A5, 0x30A7, 0x30A9, 0x30E3, 0x30E5, 0x30E7, 0x30EE};
+  const std::vector<uint32_t> cps = CodePoints(text);
+  for (size_t i = 0; i < cps.size(); ++i) {
+    if (std::find(std::begin(kSmall), std::end(kSmall), cps[i]) ==
+        std::end(kSmall)) {
+      continue;
+    }
+    if (i == 0 || !IsKana(cps[i - 1])) return true;
+  }
+  return false;
+}
