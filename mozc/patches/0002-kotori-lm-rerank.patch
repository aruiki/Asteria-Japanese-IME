+  ASSERT_FALSE(pos_matcher_.IsSuffixWord(pos_matcher_.GetCounterSuffixWordId()));
+  ASSERT_TRUE(pos_matcher_.IsSuffixWord(pos_matcher_.GetFunctionalId()));
+  CorrectionDictionary dictionary = CommonDictionary();
+  // 実辞書の名詞接尾語「痛」の別解と同じ境界。読みが別でも逆引きに現れる。
+  auto token = CommonToken("つう", "痛");
+  token.lid = pos_matcher_.GetCounterSuffixWordId();
+  dictionary.Add(std::move(token));
+  EXPECT_TRUE(IsSafe(dictionary, "あしをいためたので", "足を炒めたので",
+                     "足を痛めたので"));
