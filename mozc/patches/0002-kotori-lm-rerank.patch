diff --git a/src/session/kotori_installed_probe_main.cc b/src/session/kotori_installed_probe_main.cc
new file mode 100644
index 000000000..12f0332ed
--- /dev/null
+++ b/src/session/kotori_installed_probe_main.cc
@@ -0,0 +1,191 @@
+// Kotori:
+// インストール済みサーバーの経路を調べる。OSへキーを送らず、専用セッションだけを使用。
+#include <windows.h>
+
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <thread>
+
+#include "absl/time/time.h"
+#include "base/init_mozc.h"
+#include "base/system_util.h"
+#include "composer/key_parser.h"
+#include "ipc/ipc.h"
+#include "protocol/commands.pb.h"
+#include "protocol/config.pb.h"
+
+namespace {
+class Probe {
+ public:
+  ~Probe() {
+    if (id_ != 0) {
+      mozc::commands::Input input;
+      input.set_type(mozc::commands::Input::DELETE_SESSION);
+      input.set_id(id_);
+      mozc::commands::Output ignored;
+      Call(input, &ignored);
+    }
+  }
+  bool Call(const mozc::commands::Input& input,
+            mozc::commands::Output* output) {
+    const std::string path = mozc::SystemUtil::GetServerPath();
+    mozc::IPCClient ipc("session", path);
+    if (!ipc.Connected()) {
+      std::cerr << "IPC connection failed\n";
+      return false;
+    }
+    const uint32_t pid = ipc.GetServerProcessId();
+    if (pid_ != 0 && pid_ != pid) {
+      std::cerr << "Server changed\n";
+      return false;
+    }
+    if (pid_ == 0) {
+      pid_ = pid;
+      std::cout << "server_path\t" << path << "\nserver_pid\t" << pid
+                << "\nipc_advertised_version\t" << ipc.GetServerProductVersion()
+                << '\n';
+    }
+    std::string bytes, response;
+    if (!input.SerializeToString(&bytes) ||
+        !ipc.Call(bytes, &response, absl::Seconds(5)) ||
+        !output->ParseFromString(response))
+      return false;
+    if (output->error_code() != mozc::commands::Output::SESSION_SUCCESS) {
+      std::cerr << "Server command failed " << output->error_code() << '\n';
+      return false;
+    }
+    return true;
+  }
+  bool Create() {
+    mozc::commands::Input input;
+    input.set_type(mozc::commands::Input::CREATE_SESSION);
+    input.mutable_capability()->set_text_deletion(
+        mozc::commands::Capability::DELETE_PRECEDING_TEXT);
+    input.mutable_application_info()->set_process_id(GetCurrentProcessId());
+    input.mutable_application_info()->set_thread_id(GetCurrentThreadId());
+    mozc::commands::Output output;
+    if (!Call(input, &output) || !output.has_id()) return false;
+    id_ = output.id();
+    input.Clear();
+    input.set_type(mozc::commands::Input::SET_REQUEST);
+    input.set_id(id_);
+    input.mutable_request()
+        ->mutable_decoder_experiment_params()
+        ->set_variation_character_types(
+            mozc::commands::DecoderExperimentParams::SVS_JAPANESE);
+    return Call(input, &output);
+  }
+  bool Config() {
+    mozc::commands::Input input;
+    input.set_type(mozc::commands::Input::GET_CONFIG);
+    input.set_id(id_);
+    mozc::commands::Output output;
+    if (!Call(input, &output) || !output.has_config()) return false;
+    const auto& config = output.config();
+    // Kotori: Tabが確定を行う利用者独自のキー設定では診断入力を送らない。
+    can_tab_ = (config.session_keymap() == mozc::config::Config::MSIME ||
+                config.session_keymap() == mozc::config::Config::NONE) &&
+               config.overlay_keymaps_size() == 0;
+    std::cout << "config\tenabled=" << config.kotori_lm_enabled()
+              << " quality=" << config.kotori_lm_quality()
+              << " model=" << config.kotori_lm_model()
+              << " predict=" << config.kotori_lm_predict()
+              << " correction=" << config.kotori_lm_correction()
+              << " incognito=" << config.incognito_mode()
+              << " keymap=" << config.session_keymap() << '\n';
+    return true;
+  }
+  bool Key(const std::string& text, mozc::commands::Output* output) {
+    if (text == "Tab" && !can_tab_) {
+      std::cerr
+          << "Tab probe requires standard MSIME keymap without overlays\n";
+      return false;
+    }
+    mozc::commands::Input input;
+    input.set_type(mozc::commands::Input::SEND_KEY);
+    input.set_id(id_);
+    if (!mozc::KeyParser::ParseKey(text, input.mutable_key())) return false;
+    return Call(input, output);
+  }
+  bool Refresh(mozc::commands::Output* output) {
+    mozc::commands::Input input;
+    input.set_type(mozc::commands::Input::SEND_COMMAND);
+    input.set_id(id_);
+    input.mutable_command()->set_type(
+        mozc::commands::SessionCommand::KOTORI_REFRESH_SUGGESTION);
+    return Call(input, output);
+  }
+
+ private:
+  bool can_tab_ = false;
+  uint64_t id_ = 0;
+  uint32_t pid_ = 0;
+};
+void Show(const char* label, const mozc::commands::Output& output) {
+  std::string key, text;
+  for (const auto& segment : output.preedit().segment()) {
+    key += segment.key();
+    text += segment.value();
+  }
+  std::cout << label << "\treading=" << key << "\tpreedit=" << text
+            << "\tfirst=";
+  if (output.candidate_window().candidate_size() > 0) {
+    std::cout << output.candidate_window().candidate(0).value();
+  }
+  std::cout << "\tcallback=" << output.has_callback()
+            << "\tcommitted=" << output.has_result() << "\twords=";
+  int count = 0;
+  for (const auto& word : output.all_candidate_words().candidates()) {
+    if (count++ >= 12) break;
+    std::cout << '[' << word.value() << ']';
+  }
+  std::cout << '\n';
+}
+}  // namespace
+int main(int argc, char** argv) {
+  mozc::InitMozc(argv[0], &argc, &argv);
+  if (argc < 2) return 2;
+  Probe probe;
+  if (!probe.Create() || !probe.Config()) return 3;
+  mozc::commands::Output output;
+  if (!probe.Key("ON", &output)) return 4;
+  for (const char ch : std::string(argv[1])) {
+    if (!probe.Key(std::string(1, ch), &output)) return 5;
+    std::this_thread::sleep_for(std::chrono::milliseconds(30));
+  }
+  Show("typed", output);
+  if (argc > 3) {
+    std::string reading;
+    for (const auto& segment : output.preedit().segment())
+      reading += segment.key();
+    std::ifstream expected_file(argv[3]);
+    std::string expected;
+    if (!std::getline(expected_file, expected) || reading != expected) {
+      std::cerr << "Reading mismatch: " << reading << '\n';
+      return 10;
+    }
+  }
+  if (argc < 3 || std::string(argv[2]) != "immediate") {
+    for (int i = 0; i < 5 && output.has_callback(); ++i) {
+      std::this_thread::sleep_for(
+          std::chrono::milliseconds(output.callback().delay_millisec()));
+      if (!probe.Refresh(&output)) return 6;
+      Show("refresh", output);
+    }
+  }
+  if (argc > 4 && std::string(argv[4]) == "tab") {
+    if (!probe.Key("Tab", &output)) return 11;
+    Show("tab", output);
+    if (output.has_result()) return 12;
+    if (!probe.Key("ESC", &output)) return 13;
+  }
+  if (!probe.Key("Space", &output)) return 7;
+  Show("space1", output);
+  if (!probe.Key("Space", &output)) return 8;
+  Show("space2", output);
+  if (!probe.Key("ESC", &output)) return 9;
+  return 0;
+}
