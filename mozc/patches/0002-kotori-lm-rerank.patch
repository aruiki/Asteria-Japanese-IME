@@ -298,6 +298,65 @@ class AsyncSessionCommandEditSessionImpl final
   SessionCommand session_command_;
 };
 
+// Kotori: output が入力中の候補の取り直しを頼んでいれば、タイマーを仕掛ける。
+// 頼んでいなければ、前に仕掛けたものを取り消す(docs/adr/0039)。
+void KotoriHandleRefreshCallback(TipTextService* text_service,
+                                 ITfContext* context, const Output& output) {
+  if (output.has_callback() && output.callback().has_session_command() &&
+      output.callback().session_command().type() ==
+          SessionCommand::KOTORI_REFRESH_SUGGESTION) {
+    text_service->KotoriScheduleRefresh(context,
+                                        output.callback().delay_millisec());
+  } else {
+    text_service->KotoriCancelRefresh();
+  }
+}
+
+// Kotori: 入力中の候補を取り直す編集セッション(docs/adr/0039)。サーバーが取り直さなかった
+// (打鍵の後に変換・確定した)ときは、画面を変えない。
+class AsyncKotoriRefreshEditSessionImpl final
+    : public TipComImplements<ITfEditSession> {
+ public:
+  AsyncKotoriRefreshEditSessionImpl(
+      wil::com_ptr_nothrow<TipTextService> text_service,
+      wil::com_ptr_nothrow<ITfContext> context)
+      : text_service_(std::move(text_service)), context_(std::move(context)) {}
+
+  STDMETHODIMP DoEditSession(TfEditCookie write_cookie) override {
+    // Kotori: 非同期ロックを待つ間にもフォーカスが変わる。タイマー時の
+    // 検査だけでなく、実行時も現在の入力欄を照合して古い欄を更新しない。
+    wil::com_ptr_nothrow<ITfDocumentMgr> document;
+    wil::com_ptr_nothrow<ITfContext> focused;
+    ITfThreadMgr* manager = text_service_->GetThreadManager();
+    if (manager == nullptr || FAILED(manager->GetFocus(&document)) ||
+        !document || FAILED(document->GetTop(&focused)) ||
+        focused.get() != context_.get()) {
+      return S_OK;
+    }
+    TipPrivateContext* private_context =
+        text_service_->GetPrivateContext(context_.get());
+    if (private_context == nullptr) {
+      return E_FAIL;
+    }
+    SessionCommand command;
+    command.set_type(SessionCommand::KOTORI_REFRESH_SUGGESTION);
+    Output output;
+    if (!private_context->GetClient()->SendCommand(command, &output)) {
+      return E_FAIL;
+    }
+    if (!output.consumed()) {
+      return S_OK;
+    }
+    KotoriHandleRefreshCallback(text_service_.get(), context_.get(), output);
+    return TipEditSessionImpl::UpdateContext(
+        text_service_.get(), context_.get(), write_cookie, output);
+  }
+
+ private:
+  wil::com_ptr_nothrow<TipTextService> text_service_;
+  wil::com_ptr_nothrow<ITfContext> context_;
+};
