+  const auto first = std::lower_bound(
+      std::begin(kKatakanaEnglishEntries), std::end(kKatakanaEnglishEntries),
+      value, [](const KatakanaEnglishEntry& entry, absl::string_view key) {
+        return entry.katakana < key;
