+// Kotori: 打ち間違いの補正(docs/adr/0036)。ローマ字入力でよくある 1 か所の打ち間違い(濁点の有無、
+// 子音の抜け「す→う」、母音の誤り、文字の抜け・重複・入れ替え、を/お)を、読みの 1 か所の書き換えで表す。
+constexpr const char* kKanaRows[] = {
+    "あいうえお", "かきくけこ", "さしすせそ", "たちつてと", "なにぬねの",
+    "はひふへほ", "まみむめも", "や_ゆ_よ", "らりるれろ", "わ___を",
+    "がぎぐげご", "ざじずぜぞ", "だぢづでど", "ばびぶべぼ", "ぱぴぷぺぽ"};
+constexpr int kKanaRowCount = sizeof(kKanaRows) / sizeof(kKanaRows[0]);
+
+// 濁点・半濁点の付け外しで行き来する行の組。
+constexpr int kDakutenPairs[][2] = {{1, 10}, {2, 11}, {3, 12}, {5, 13}, {5, 14}, {13, 14}};
+
+const std::vector<std::vector<std::string>>& KanaTable() {
+  static const auto* table = [] {
+    auto* t = new std::vector<std::vector<std::string>>();
+    for (const char* row : kKanaRows) {
+      std::vector<std::string> cols;
+      for (const std::string& ch : Chars(row)) cols.push_back(ch == "_" ? "" : ch);
+      t->push_back(std::move(cols));
+    }
+    return t;
+  }();
+  return *table;
+}
+
+bool KanaPos(const std::string& ch, int* row, int* col) {
+  const auto& t = KanaTable();
+  for (int r = 0; r < static_cast<int>(t.size()); ++r) {
+    for (int c = 0; c < static_cast<int>(t[r].size()); ++c) {
+      if (!t[r][c].empty() && t[r][c] == ch) {
+        *row = r;
+        *col = c;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+// 読みを 1 か所だけ書き換えた候補(元の読みは含まない)。
+std::vector<std::string> TypoVariants(const std::vector<std::string>& r) {
+  const auto& t = KanaTable();
+  std::vector<std::string> out;
+  absl::flat_hash_map<std::string, bool> seen;
+  const std::string orig = absl::StrJoin(r, "");
+  seen[orig] = true;
+  auto add = [&](std::vector<std::string> v) {
+    std::string s = absl::StrJoin(v, "");
+    if (s.empty() || seen.contains(s)) return;
+    seen[s] = true;
+    out.push_back(std::move(s));
+  };
+  auto replaced = [&](size_t j, const std::string& ch) {
+    std::vector<std::string> v = r;
+    v[j] = ch;
+    return v;
+  };
+  for (size_t j = 0; j < r.size(); ++j) {
+    int row = -1, col = -1;
+    if (KanaPos(r[j], &row, &col)) {
+      for (const auto& p : kDakutenPairs) {
+        const int other = p[0] == row ? p[1] : p[1] == row ? p[0] : -1;
+        if (other >= 0 && !t[other][col].empty()) add(replaced(j, t[other][col]));
+      }
+      for (int c = 0; c < 5; ++c) {
+        if (c != col && !t[row][c].empty()) add(replaced(j, t[row][c]));
+      }
+      if (row == 0) {  // 子音の抜け(「す」を「う」と打った)
+        for (int r2 = 1; r2 < kKanaRowCount; ++r2) {
+          if (!t[r2][col].empty()) add(replaced(j, t[r2][col]));
+        }
+      }
+    }
+    if (r[j] == "お") add(replaced(j, "を"));
+    // 文字の重複・余分。削ると文が短くなって点が上がりやすいので、同じ文字の重複と「っ」「ん」に限る。
+    const bool kana = r[j] >= "ぁ" && r[j] <= "ゖ";
+    if (kana && ((j + 1 < r.size() && r[j] == r[j + 1]) || r[j] == "っ" || r[j] == "ん")) {
+      std::vector<std::string> v = r;
+      v.erase(v.begin() + j);
+      add(std::move(v));
+    }
+    if (kana && j + 1 < r.size() && r[j] != r[j + 1] &&  // 入れ替え(かなどうし)
+        r[j + 1] >= "ぁ" && r[j + 1] <= "ゖ") {
+      std::vector<std::string> v = r;
+      std::swap(v[j], v[j + 1]);
+      add(std::move(v));
+    }
+  }
+  for (size_t j = 0; j <= r.size(); ++j) {  // 文字の抜け
+    for (const char* ins : {"う", "い", "ん", "っ"}) {
+      std::vector<std::string> v = r;
+      v.insert(v.begin() + j, ins);
+      add(std::move(v));
+    }
+  }
+  return out;
+}
+
+// 読みの先頭から辞書の語でたどれる長さごとの、いちばん小さいコスト。
+class MinCostCollector : public dictionary::DictionaryInterface::Callback {
+ public:
+  ResultType OnToken(absl::string_view, absl::string_view,
+                     dictionary::Token token) override {
+    auto it = cost.find(token.key.size());
+    if (it == cost.end() || token.cost < it->second) cost[token.key.size()] = token.cost;
+    return TRAVERSE_CONTINUE;
+  }
+  absl::flat_hash_map<size_t, int> cost;  // 読みのバイト数 → コスト
+};
+
+// 読みを辞書の語で区切ったときのコストの合計の最小(語のつながりは見ない粗い目安)。辞書にない
+// 文字は 1 文字ごとに大きなコスト。打ち間違いのある読みは、語に区切れず高くなる。
+int ReadingCost(const dictionary::DictionaryInterface& dic, absl::string_view reading,
+                absl::flat_hash_map<std::string, std::vector<std::pair<size_t, int>>>* cache) {
+  constexpr int kUnknown = 10000;
+  constexpr int kPerWord = 2000;
+  const std::vector<std::string> r = Chars(reading);
+  std::vector<size_t> off(r.size() + 1, 0);
+  for (size_t j = 0; j < r.size(); ++j) off[j + 1] = off[j] + r[j].size();
+  std::vector<int> best(r.size() + 1, std::numeric_limits<int>::max());
+  best[0] = 0;
+  for (size_t i = 0; i < r.size(); ++i) {
+    if (best[i] == std::numeric_limits<int>::max()) continue;
+    best[i + 1] = std::min(best[i + 1], best[i] + kUnknown);
+    const std::string suffix(reading.substr(off[i]));
+    auto it = cache->find(suffix);
+    if (it == cache->end()) {
+      MinCostCollector col;
+      dic.LookupPrefix(suffix, &col);
+      std::vector<std::pair<size_t, int>> v(col.cost.begin(), col.cost.end());
+      it = cache->emplace(suffix, std::move(v)).first;
+    }
+    for (const auto& [bytes, cost] : it->second) {
+      for (size_t k = i + 1; k <= r.size(); ++k) {
+        if (off[k] - off[i] == bytes) {
+          best[k] = std::min(best[k], best[i] + cost + kPerWord);
+          break;
+        }
+      }
+    }
+  }
+  return best[r.size()];
+}
+
+// 前方一致の検索は語が多いので、数を抑える。
+class PredictiveCollector : public dictionary::DictionaryInterface::Callback {
+ public:
+  ResultType OnToken(absl::string_view, absl::string_view,
+                     dictionary::Token token) override {
+    tokens.emplace_back(std::move(token.key), std::move(token.value),
+                        token.cost);
+    return tokens.size() >= 5000 ? TRAVERSE_DONE : TRAVERSE_CONTINUE;
+  }
+  std::vector<std::tuple<std::string, std::string, int>> tokens;  // 読み, 表記, コスト
+};
+
+// 生成した文 text が読み reading に過不足なく合うか、辞書で確かめる。読みの先頭から、
+// 辞書の語(読みが前方一致し、表記が text の続きに合うもの)、同じかな・記号、数字と英字
+// (1 文字で読み 1〜6 文字)をたどり、両方の終わりに着けば合う。
+// prefix_only なら、text の先頭部分で reading を使い切れば合うとする(予測の候補用。
+// 「今日はいい天気」は読み「きょうはいいて」で始まる)。
+// units を渡すと、合ったときの表記と読みの対応(辞書の語・かな・数字などの単位ごと)を入れる。
+bool MatchesReading(
+    const dictionary::DictionaryInterface& dic,
+    const dictionary::SingleKanjiDictionary* single_kanji,
+    absl::string_view text, absl::string_view reading, bool prefix_only = false,
+    std::vector<std::pair<std::string, std::string>>* units = nullptr) {
+  const std::vector<std::string> t = Chars(text);
+  const std::vector<std::string> r = Chars(reading);
+  std::vector<size_t> r_off(r.size() + 1, 0);
+  for (size_t j = 0; j < r.size(); ++j) r_off[j + 1] = r_off[j] + r[j].size();
+  std::vector<std::string> t_prefix(t.size() + 1);  // t_prefix[i] = t[i..] の UTF-8
+  for (size_t i = t.size(); i-- > 0;) t_prefix[i] = t[i] + t_prefix[i + 1];
+  std::vector<std::vector<bool>> seen(t.size() + 1,
+                                      std::vector<bool>(r.size() + 1, false));
+  // 状態 (i, j) に来る前の状態(対応を取り出すため)。
+  std::vector<std::vector<std::pair<int, int>>> from(
+      t.size() + 1, std::vector<std::pair<int, int>>(r.size() + 1, {-1, -1}));
+  std::vector<std::optional<PrefixCollector>> lookups(r.size());
+  std::vector<std::optional<PrefixCollector>> reverse(t.size() + 1);
+  absl::flat_hash_map<std::string, std::vector<std::string>> kanji_cache;
+  std::vector<std::pair<size_t, size_t>> stack = {{0, 0}};
+  seen[0][0] = true;
+  size_t ci = 0, cj = 0;  // 今たどっている状態(push が from に書く)
+  auto push = [&](size_t i, size_t j) {
+    if (i <= t.size() && j <= r.size() && !seen[i][j]) {
+      seen[i][j] = true;
+      from[i][j] = {static_cast<int>(ci), static_cast<int>(cj)};
+      stack.emplace_back(i, j);
+    }
+  };
+  while (!stack.empty()) {
+    const auto [i, j] = stack.back();
+    stack.pop_back();
+    ci = i;
+    cj = j;
+    if (i == t.size() && j == r.size()) {
+      if (units != nullptr) {
+        // 終わりから前の状態をたどり、単位ごとの表記と読みを取り出す。
+        units->clear();
+        size_t a = i, b = j;
+        while (a > 0 || b > 0) {
+          const auto [pa, pb] = from[a][b];
+          if (pa < 0) break;
+          std::string ut, ur;
+          for (size_t x = pa; x < a; ++x) ut += t[x];
+          for (size_t y = pb; y < b; ++y) ur += r[y];
+          units->emplace_back(std::move(ut), std::move(ur));
+          a = pa;
+          b = pb;
+        }
+        std::reverse(units->begin(), units->end());
+      }
+      return true;
+    }
+    if (prefix_only && j == r.size()) return true;
+    // 読みの残り(3 文字まで)が語の途中で終わる場合(「て」→「天気」)。text の続きの語を
+    // 逆引きし(表記 → 読み)、その読みが残りの読みで始まれば合う。
+    if (prefix_only && i < t.size() && j < r.size() && r.size() - j <= 3) {
+      if (!reverse[i]) {
+        reverse[i].emplace();
+        dic.LookupReverse(t_prefix[i], &*reverse[i]);
+      }
+      const absl::string_view rest = reading.substr(r_off[j]);
+      for (const auto& [word, yomi] : reverse[i]->found) {
+        // 逆引きでは Token::key が表記、Token::value が読み。
+        if (!word.empty() &&
+            absl::string_view(t_prefix[i]).substr(0, word.size()) == word &&
+            absl::StartsWith(yomi, rest)) {
+          return true;
+        }
+      }
+    }
+    if (i < t.size() && j < r.size() && ToHiragana(t[i]) == r[j]) {
+      push(i + 1, j + 1);
+    }
+    if (i < t.size() && IsAlnum(t[i])) {
+      for (size_t k = 1; k <= 6; ++k) push(i + 1, j + k);
+    }
+    // 辞書にない語(「夜駆け」など)は、漢字 1 文字ずつの読み(単漢字辞書)で確かめる。
+    if (single_kanji != nullptr && i < t.size() && t[i].size() >= 3) {
+      for (size_t k = 1; k <= 4 && j + k <= r.size(); ++k) {
+        const std::string key = std::string(
+            reading.substr(r_off[j], r_off[j + k] - r_off[j]));
+        // 連濁(「よがけ」の「が」→「駆(か)」)も認める。
+        for (const std::string& variant : {key, Unvoice(key)}) {
+          auto it = kanji_cache.find(variant);
+          if (it == kanji_cache.end()) {
+            it = kanji_cache
+                     .emplace(variant,
+                              single_kanji->LookupKanjiEntries(variant, false))
+                     .first;
+          }
+          if (std::find(it->second.begin(), it->second.end(), t[i]) !=
+              it->second.end()) {
+            push(i + 1, j + k);
+          }
+        }
+      }
+    }
+    if (i < t.size() && j < r.size()) {
+      if (!lookups[j]) {
+        lookups[j].emplace();
+        dic.LookupPrefix(reading.substr(r_off[j]), &*lookups[j]);
+      }
+      for (const auto& [key, value] : lookups[j]->found) {
+        if (value.empty() || key.empty()) continue;
+        if (absl::string_view(t_prefix[i]).substr(0, value.size()) != value) {
+          continue;
+        }
+        push(i + Chars(value).size(), j + Chars(key).size());
+      }
+    }
+  }
+  return false;
+}
+
+// Kotori: 自由生成の自動採用専用。保護語の変更と未知の漢字を拒否し、
+// 未変更の保護語は保持する。既存の変換・誤入力補正は変えない。
+// 補正前後の共通の接頭・接尾を除いた変更範囲（UTF-8バイト位置）。
+// 間に未変更語がある複数編集も、一つの範囲として保守的に扱う。
+using CorrectionSpan = std::pair<size_t, size_t>;
+std::pair<CorrectionSpan, CorrectionSpan> CorrectionSpans(
+    absl::string_view original, absl::string_view corrected) {
+  const auto before = Chars(original), after = Chars(corrected);
+  size_t first = 0;
+  while (first < before.size() && first < after.size() &&
+         before[first] == after[first]) ++first;
+  size_t last_before = before.size(), last_after = after.size();
+  while (last_before > first && last_after > first &&
+         before[last_before - 1] == after[last_after - 1]) {
+    --last_before; --last_after;
+  }
+  auto offset = [](const auto& chars, size_t end) {
+    size_t bytes = 0;
+    for (size_t i = 0; i < end; ++i) bytes += chars[i].size();
+    return bytes;
+  };
+  return {{offset(before, first), offset(before, last_before)},
+          {offset(after, first), offset(after, last_after)}};
+}
+
+bool IntersectsCorrection(CorrectionSpan edit, size_t begin, size_t end) {
+  // 名前の先頭・末尾への挿入も、名前を伸ばす変更として拒否する。
+  if (edit.first == edit.second) return begin <= edit.first && edit.first <= end;
+  return begin < edit.second && edit.first < end;
+}
+
+bool HasSafeCorrectionReading(const dictionary::DictionaryInterface& dic,
+                              dictionary::PosMatcher pos_matcher,
+                              absl::string_view reading,
+                              absl::string_view text,
+                              std::optional<CorrectionSpan> changed = std::nullopt,
+                              bool protect_grammar = true) {
+  if (!IsValidCorrectionText(reading) || !IsValidCorrectionText(text)) {
+    return false;
+  }
+  const auto r = Chars(reading);
+  const auto t = Chars(text);
+  if (r.size() > kMaxTypoChars) return false;
+  std::vector<size_t> r_off(r.size() + 1), t_off(t.size() + 1);
+  for (size_t j = 0; j < r.size(); ++j) r_off[j + 1] = r_off[j] + r[j].size();
+  for (size_t i = 0; i < t.size(); ++i) t_off[i + 1] = t_off[i] + t[i].size();
+  auto protected_token = [pos_matcher, protect_grammar](const dictionary::Token& token) {
+    // Kotori: 文法語はFunctionalとSuffixWordの共通部分。
+    // Functionalだけでは名詞の接尾語「痛」が動詞「痛めた」に重なり、
+    // 必要な同音語補正を止める。文法語と代名詞は左右の品詞で守る。
+    auto grammar = [pos_matcher](uint16_t id) {
+      return pos_matcher.IsFunctional(id) && pos_matcher.IsSuffixWord(id);
+    };
+    return (token.attributes & dictionary::Token::USER_DICTIONARY) != 0 ||
+           pos_matcher.IsUniqueNoun(token.lid) ||
+           pos_matcher.IsUniqueNoun(token.rid) ||
+           (protect_grammar && (grammar(token.lid) || grammar(token.rid))) ||
+           pos_matcher.IsPronoun(token.lid) ||
+           pos_matcher.IsPronoun(token.rid);
+  };
+  std::vector<CorrectionTokenCollector> lookups(r.size());
+  for (size_t j = 0; j < r.size(); ++j) {
+    const auto suffix = reading.substr(r_off[j]);
+    dic.LookupPrefix(suffix, &lookups[j]);
+    for (const auto& token : lookups[j].tokens) {
+      // 利用者辞書の逆引きは未実装なので、読み側の属性を必ず調べる。
+      // 同じ読みの別品詞があっても、保護語を変更する補正は拒否する。
+      if (!token.key.empty() && !token.value.empty() &&
+          absl::StartsWith(suffix, token.key) && protected_token(token) &&
+          changed) {
+        // 同じ保護語が複数回ある場合も、変更した位置を必ず調べる。
+        size_t at = text.find(token.value);
+        while (at != absl::string_view::npos) {
+          if (IntersectsCorrection(*changed, at, at + token.value.size())) {
+            return false;
+          }
+          at = text.find(token.value, at + 1);
+        }
+      }
+    }
+  }
+  if (changed) {
+    // 索引のない実セッションでも辞書全体の走査は文ごとに一度にする。
+    // キャッシュにない語はMozcが通常の逆引きに戻すため、保護の条件は変わらない。
+    struct ReverseCacheScope {
+      const dictionary::DictionaryInterface& dictionary;
+      ~ReverseCacheScope() { dictionary.ClearReverseLookupCache(); }
+    } cache_scope{dic};
+    dic.PopulateReverseLookupCache(text);
+    for (size_t i = 0; i < t.size(); ++i) {
+      CorrectionTokenCollector reverse;
+      const auto suffix = text.substr(t_off[i]);
+      dic.LookupReverse(suffix, &reverse);
+      for (const auto& token : reverse.tokens) {
+        // 逆引きではkeyが表記。別の読みを持つ名前も変更範囲で保護する。
+        if (!token.key.empty() && absl::StartsWith(suffix, token.key) &&
+            protected_token(token) &&
+            IntersectsCorrection(*changed, t_off[i], t_off[i] + token.key.size())) {
+          return false;
+        }
+      }
+    }
+  }
+
+  std::vector<std::vector<bool>> seen(
+      t.size() + 1, std::vector<bool>(r.size() + 1, false));
+  std::vector<std::pair<size_t, size_t>> stack = {{0, 0}};
+  seen[0][0] = true;
+  auto push = [&](size_t i, size_t j) {
+    if (i <= t.size() && j <= r.size() && !seen[i][j]) {
+      seen[i][j] = true;
+      stack.emplace_back(i, j);
+    }
+  };
+  while (!stack.empty()) {
+    const auto [i, j] = stack.back();
+    stack.pop_back();
+    if (i == t.size() && j == r.size()) return true;
+    if (i == t.size() || j == r.size()) continue;
+    // 同じかな・記号はそのまま対応させる。漢字は必ず辞書Tokenで裏付ける。
+    if (Util::GetScriptType(t[i]) != Util::KANJI &&
+        ToHiragana(t[i]) == r[j]) {
+      push(i + 1, j + 1);
+    }
+    const auto surface = text.substr(t_off[i]);
+    const auto suffix = reading.substr(r_off[j]);
+    for (const auto& token : lookups[j].tokens) {
+      if (token.key.empty() || token.value.empty() ||
+          !absl::StartsWith(suffix, token.key) ||
+          !absl::StartsWith(surface, token.value)) {
+        continue;
+      }
+      const size_t end = i + Chars(token.value).size();
+      // 未登録の漢字の並びを、既知の一字ずつに分解して許可しない。
+      // 複合語でも一つのTokenで裏付けられなければ、自由生成補正は見送る。
+      if (end < t.size() && Util::GetScriptType(t[end - 1]) == Util::KANJI &&
+          Util::GetScriptType(t[end]) == Util::KANJI) {
+        continue;
+      }
+      push(end, j + Chars(token.key).size());
+    }
+  }
+  return false;
+}
+
+// 生成した文を、表記と読みの対応(MatchesReading の units)で文節に分ける(docs/adr/0027)。
+// ひらがなで終わる単位の後に、ひらがな以外(漢字・カタカナ・数字など)で始まる単位が来たら区切る
+// (「明日の|会議は|10時からです」)。文節は最大 max 個で、超えた分は最後の文節につなぐ。
+void SplitIntoSegmentsImpl(
+    const std::vector<std::pair<std::string, std::string>>& units, size_t max,
+    std::vector<std::string>* keys, std::vector<std::string>* values) {
+  auto is_hiragana = [](absl::string_view c) {
+    if (c.size() != 3 || static_cast<unsigned char>(c[0]) != 0xE3) return false;
+    const uint32_t cp =
+        ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+    return cp >= 0x3041 && cp <= 0x309F;
+  };
+  keys->clear();
+  values->clear();
+  bool prev_hiragana = false;
+  for (const auto& [text, yomi] : units) {
+    const std::vector<std::string> chars = Chars(text);
+    if (chars.empty()) continue;
+    const bool starts_content = !is_hiragana(chars.front());
+    if (keys->empty() || (prev_hiragana && starts_content && keys->size() < max)) {
+      keys->emplace_back();
+      values->emplace_back();
+    }
+    keys->back() += yomi;
+    values->back() += text;
+    prev_hiragana = is_hiragana(chars.back());
+  }
+}
+
+// 評価用: KOTORI_LM_CONTEXT_MAP に「読み<TAB>前の文」の行を書いたファイル(UTF-8)を渡すと、
+// 変換中の読みに合う前の文を左の文脈にする(1 回の起動で多くの問題を解くため)。
+const absl::flat_hash_map<std::string, std::string>& ContextMap() {
+  static const auto* map = [] {
+    auto* m = new absl::flat_hash_map<std::string, std::string>();
+    if (const char* path = Env("KOTORI_LM_CONTEXT_MAP")) {
+      InputFileStream in(path, std::ios::binary);
+      std::string line;
+      while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        const size_t tab = line.find('\t');
+        if (tab != std::string::npos) {
+          (*m)[line.substr(0, tab)] = line.substr(tab + 1);
+        }
+      }
+    }
+    return m;
+  }();
+  return *map;
+}
+
+// 左の文脈。アプリが渡す直前の文(TSF の preceding_text)があればそれを使い、
+// なければ確定済みの文節(履歴)の値をつなぐ。KOTORI_LM_PRECEDING は評価用。
+std::string HistoryContext(const ConversionRequest& request,
+                           const Segments& segments) {
+  if (const char* v = Env("KOTORI_LM_PRECEDING")) return Tail(v);
+  if (!ContextMap().empty()) {
+    const auto it = ContextMap().find(ConversionReading(segments));
+    return it == ContextMap().end() ? std::string() : Tail(it->second);
+  }
+  std::string preceding = request.GetSurroundingContext().first;
+  if (!preceding.empty()) return Tail(preceding);
+  std::string context;
+  for (const Segment& seg : segments.history_segments()) {
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return Tail(context);
+}
+
+std::string ConversionReading(const Segments& segments) {
+  std::string reading;
+  for (const Segment& seg : segments.conversion_segments()) {
+    reading += seg.key();
+  }
+  return reading;
+}
+
+// text の読みを 1 つ求める(辞書の逆引き・単漢字・同じかな)。求まらなければ空。
+// 予測の続きの読みを裏で求めておき、打鍵ごとの確認を文字列の比較だけにするために使う。
+std::string ReadingOf(const dictionary::DictionaryInterface& dic,
+                      const dictionary::SingleKanjiDictionary* single_kanji,
+                      absl::string_view text) {
+  const std::vector<std::string> t = Chars(text);
+  std::vector<std::string> t_prefix(t.size() + 1);
+  for (size_t i = t.size(); i-- > 0;) t_prefix[i] = t[i] + t_prefix[i + 1];
+  // best[i] = t[0..i) の読み(最初に見つかったもの)
+  std::vector<std::optional<std::string>> best(t.size() + 1);
+  best[0] = std::string();
+  for (size_t i = 0; i < t.size(); ++i) {
+    if (!best[i]) continue;
+    auto set = [&](size_t j, const std::string& y) {
+      if (j <= t.size() && !best[j]) best[j] = *best[i] + y;
+    };
+    const std::string h = ToHiragana(t[i]);
+    if (h.size() == 3 && static_cast<unsigned char>(h[0]) == 0xE3) {
+      // ひらがな・カタカナ・記号(「、」など)はそのまま
+      set(i + 1, h);
+      // ひらがなで始まる所は辞書を引かない(逆引きは遅いので、漢字などの所だけ引く)。
+      if (h == t[i]) continue;
+    }
+    PrefixCollector rev;
+    dic.LookupReverse(t_prefix[i], &rev);
+    for (const auto& [word, yomi] : rev.found) {
+      if (!word.empty() && !yomi.empty() &&
+          absl::string_view(t_prefix[i]).substr(0, word.size()) == word) {
+        set(i + Chars(word).size(), yomi);
+      }
+    }
+  }
+  return best[t.size()].value_or(std::string());
+}
