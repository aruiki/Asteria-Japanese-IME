+bool Session::KotoriRefreshSuggestion(commands::Command* command) {
+  // 打鍵の後に入力中の候補が出ている状態でだけ取り直す(変換中・確定後は何もしない)。
+  // 「使わなかった」と返し、クライアントは画面を変えない(DoNothing は今の画面を出し直すので使わない)。
+  if (context_->state() != ImeContext::COMPOSITION ||
+      !context_->GetConfig().kotori_lm_enabled() ||
+      context_->GetConfig().incognito_mode() ||
+      context_->GetRequest().is_incognito_mode() ||
+      context_->composer().GetInputFieldType() == commands::Context::PASSWORD) {
+    command->mutable_output()->set_consumed(false);
+    return true;
+  }
+  command->mutable_output()->set_consumed(true);
+  // Kotori: TSFのタイマーには周囲の文が含まれない。Spaceと同じ入力開始時の
+  // 文脈を使い、別のキャッシュキーや採点で初回表示と変換が食い違うのを防ぐ。
+  commands::Input input = command->input();
+  *input.mutable_context() = context_->client_context();
+  if (!Suggest(input)) {
+    OutputComposition(command);
+    return true;
+  }
+  const bool ready = context_->mutable_converter()->KotoriPreviewConversion(
+      context_->composer(), input.context());
+  Output(command);
+  ++kotori_refresh_count_;
+  KotoriScheduleRefresh(command, kotori_refresh_count_, !ready);
+  if (!ready && command->output().has_callback()) {
+    command->mutable_output()->clear_candidate_window();
+    command->mutable_output()->clear_all_candidate_words();
+  }
+  return true;
+}
