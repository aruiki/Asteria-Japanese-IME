+TEST(ConversionRequestTest, KotoriGenerationDistinguishesSessionsAndPastInput) {
+  auto first = std::make_shared<std::atomic<uint64_t>>(1);
+  auto second = std::make_shared<std::atomic<uint64_t>>(1);
+  ConversionRequest::KotoriInputGeneration old{first, 1};
