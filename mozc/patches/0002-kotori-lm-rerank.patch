+bool EngineConverter::KotoriFocusNuanceAlternative() {
+  if (!CheckState(CONVERSION) || segment_index_ != 0 ||
+      segments_.conversion_segments_size() < 2) return false;
+  const auto& selected = GetSelectedCandidate(0);
+  if (!selected.kotori_nuance_alternative ||
+      selected.effective_converted_segment_count() !=
+          segments_.conversion_segments_size()) return false;
+  const std::string desired = selected.value;
+  std::vector<std::string> values;
+  for (const Segment& segment : segments_.conversion_segments()) {
+    if (segment.candidates_size() == 0) return false;
+    values.push_back(segment.candidate(0).value);
+  }
+  const auto& top = segments_.conversion_segment(0).candidate(0);
+  const bool whole_top = top.effective_converted_segment_count() == values.size();
+  int head_local_id = 0;
+  if (whole_top) {
+    std::string tail;
+    for (size_t i = 1; i < values.size(); ++i) tail += values[i];
+    if (!values[0].ends_with(tail)) return false;
+    values[0].resize(values[0].size() - tail.size());
+    head_local_id = -1;
+    const Segment& head = segments_.conversion_segment(0);
+    for (size_t i = 0; i < head.candidates_size(); ++i) {
+      const auto& candidate = head.candidate(i);
+      if (candidate.effective_converted_segment_count() == 1 &&
+          candidate.key == head.key() && candidate.value == values[0]) {
+        head_local_id = i;
+        break;
+      }
+    }
+    if (head_local_id < 0) return false;
+  }
+  std::string original;
+  for (size_t i = 0; i < values.size(); ++i) {
+    if (!(i == 0 && whole_top) && segments_.conversion_segment(i)
+        .candidate(0).effective_converted_segment_count() != 1) return false;
+    original += values[i];
+  }
+  size_t offset = 0;
+  for (size_t i = 0; i < segments_.conversion_segments_size(); ++i) {
+    Segment* segment = segments_.mutable_conversion_segment(i);
+    const std::string& value = values[i];
+    const std::string prefix = original.substr(0, offset);
+    // 最小の連続文節を選び、Mozcに同じ読み/範囲の実候補がある場合は
+    // その候補の文節数を保ってフォーカスする。
+    int candidate_id = -1;
+    std::string replacement;
+    std::string covered_value, covered_key;
+    for (size_t span = 1; span <= values.size() - i; ++span) {
+      covered_value += values[i + span - 1];
+      covered_key += segments_.conversion_segment(i + span - 1).key();
+      const std::string suffix = original.substr(offset + covered_value.size());
+      if (desired.size() < prefix.size() + suffix.size() ||
+          !desired.starts_with(prefix) || !desired.ends_with(suffix)) continue;
+      const std::string text = desired.substr(prefix.size(), desired.size() - prefix.size() - suffix.size());
+      if (text.empty() || text == covered_value) continue;
+      for (size_t j = 0; j < segment->candidates_size(); ++j) {
+        const auto& candidate = segment->candidate(j);
+        if (!candidate.kotori_nuance_alternative && candidate.key == covered_key && candidate.value == text &&
+            candidate.effective_converted_segment_count() == span) {
+          candidate_id = j; replacement = text; break;
+        }
+      }
+      if (candidate_id >= 0) break;
+      if (span == 1) replacement = text;
+    }
+    offset += value.size();
+    if (candidate_id < 0) {
+      if (replacement.empty()) continue;
+      converter::Candidate local = segment->candidate(0);
+      local.key = local.content_key = std::string(segment->key());
+      local.value = local.content_value = replacement;
+      local.inner_segment_boundary.clear();
+      local.converted_segment_count = 1;
+      local.description = selected.description;
+      local.a11y_description = selected.a11y_description;
+      local.attributes = converter::Attribute::NO_LEARNING;
+      local.kotori_nuance_alternative = false;
+      local.kotori_ai_evaluated = false;
+      local.kotori_confident_prediction = false;
+      candidate_id = segment->candidates_size();
+      *segment->add_candidate() = std::move(local);
+    }
+    // 非フォーカス文節は候補0を使うMozcの規約に合わせる。全文候補は残す。
+    if (whole_top) {
+      segments_.mutable_conversion_segment(0)->move_candidate(head_local_id, 0);
+      if (i == 0 && candidate_id < head_local_id) ++candidate_id;
+    }
+    selected_candidate_indices_[0] = 0;
+    segment_index_ = i;
+    UpdateCandidateList();
+    if (!candidate_list_.MoveToId(candidate_id)) return false;
+    UpdateSelectedCandidateIndex();
+    candidate_list_visible_ = true;
+    SegmentFocus();
+    return true;
+  }
+  return false;
+}
