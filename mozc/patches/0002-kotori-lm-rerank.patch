+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+// Kotori: 診断情報と異常終了の記録(作業カード 42、SPEC 13.3、REQ-15-2)。
+// 入力した文字・読み・候補・前の文は扱わない。異常終了の記録はメモリの中身(入力した文字が
+// 残っている)を書かず、例外の種類と場所(モジュール名 + オフセット)だけを書く。
+// 診断情報は、決まった項目だけを許可した形で組み立てる(許可していない項目は通さない)。
+
+#ifndef MOZC_BASE_KOTORI_DIAGNOSTICS_H_
+#define MOZC_BASE_KOTORI_DIAGNOSTICS_H_
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mozc {
+namespace kotori {
+
+// 残す異常終了の記録の数。
+inline constexpr int kMaxCrashLogs = 5;
+
+// 異常終了の記録を置くフォルダ(ユーザーのプロファイルの crash)。
+std::string CrashLogDir();
+
+// mozc_server が落ちたときに、異常終了の記録を CrashLogDir() に書くようにする(Windows のみ)。
+// 呼んだときに、古い記録を消して最新の kMaxCrashLogs 個だけを残す。
+void InstallCrashLogger();
+// 置き場を指定する版(テスト用)。
+void InstallCrashLoggerTo(const std::string &dir);
+
+// dir の crash-*.txt を新しい順に並べ、max_files 個より古いものを消す。残したもののパスを
+// 新しい順に返す(ファイル名に日時が入っているので、名前の順が日時の順)。
+std::vector<std::string> PruneCrashLogs(const std::string &dir, int max_files);
+
+struct DiagnosticsInput {
+  std::string version;         // Mozc の版(Version::GetMozcVersion)
+  std::string os_version;      // SystemUtil::GetOSVersionString
+  std::string gpu_summary;     // 設定画面の GPU の説明
+  std::string ai_status_text;  // 設定画面の「AI の状態」の文
+  std::string ai_status_file;  // kotori_ai_status.txt の中身(key=value)
+  bool lm_enabled = false;
+  bool predict_enabled = false;
+  std::string quality;         // Low / Standard / High / Unreal
+  std::string model;           // 自動 / zenz のみ / zenz + LLM
+  bool custom_model_path = false;  // パスそのものは出さない(ユーザー名が入る)
+  // 異常終了の記録(ファイル名と中身)。
+  std::vector<std::pair<std::string, std::string>> crash_logs;
+};
+
+// 診断情報の文(UTF-8)。ai_status_file と crash_logs は、許可したキーの行だけを通す。
+std::string FormatDiagnostics(const DiagnosticsInput &input);
+
+}  // namespace kotori
+}  // namespace mozc
+
+#endif  // MOZC_BASE_KOTORI_DIAGNOSTICS_H_
diff --git a/src/base/kotori_diagnostics_test.cc b/src/base/kotori_diagnostics_test.cc
new file mode 100644
index 000000000..3bcfec328
--- /dev/null
+++ b/src/base/kotori_diagnostics_test.cc
@@ -0,0 +1,116 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "base/kotori_diagnostics.h"
+
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "absl/status/statusor.h"
+#include "absl/strings/str_cat.h"
+#include "base/file/temp_dir.h"
+#include "base/file_util.h"
+#include "testing/gmock.h"
+#include "testing/gunit.h"
+
+namespace mozc {
+namespace kotori {
+namespace {
+
+DiagnosticsInput Sample() {
+  DiagnosticsInput in;
+  in.version = "2.31.6300.0";
+  in.os_version = "Windows 10.0.26200";
+  in.gpu_summary = "GPU: NVIDIA GeForce RTX 3060";
+  in.ai_status_text = "AI の状態: 動いています。";
+  in.ai_status_file = "state=llm\r\ndevice=NVIDIA GeForce RTX 3060\r\n";
+  in.lm_enabled = true;
+  in.predict_enabled = true;
+  in.quality = "Standard";
+  in.model = "自動";
+  return in;
+}
+
+TEST(KotoriDiagnosticsTest, KeepsAllowedStatusKeys) {
+  const std::string out = FormatDiagnostics(Sample());
+  EXPECT_NE(out.find("state=llm\n"), std::string::npos);
+  EXPECT_NE(out.find("device=NVIDIA GeForce RTX 3060\n"), std::string::npos);
+  EXPECT_NE(out.find("quality=Standard"), std::string::npos);
+  EXPECT_NE(out.find("[異常終了の記録] 0 件"), std::string::npos);
+}
+
+// 状態のファイルや記録に、許可していない行(入力した文字など)が入っていても出さない(REQ-15-2)。
+TEST(KotoriDiagnosticsTest, DropsUnknownKeysAndInput) {
+  DiagnosticsInput in = Sample();
+  in.ai_status_file +=
+      "reading=かれはこうえんで\n直前に確定した文章\nleft_context=秘密\n";
+  in.crash_logs.push_back(
+      {"crash-20261001-120000-42.txt",
+       "time=2026-10-01 12:00:00\ncode=0xC0000005\nmodule=mozc_server.exe\n"
+       "offset=0x1234\nframe=mozc_server.exe+0x10\ncandidate=公演\n"});
+  const std::string out = FormatDiagnostics(in);
+  for (const char *secret : {"かれは", "秘密", "公演", "直前に確定した文章",
+                             "reading=", "left_context=", "candidate="}) {
+    EXPECT_EQ(out.find(secret), std::string::npos) << secret;
+  }
+  EXPECT_NE(out.find("code=0xC0000005\n"), std::string::npos);
+  EXPECT_NE(out.find("frame=mozc_server.exe+0x10\n"), std::string::npos);
+  EXPECT_NE(out.find("[異常終了の記録] 1 件"), std::string::npos);
+}
+
+// モデルのパスはユーザー名を含むので、指定の有無だけを出す。
+TEST(KotoriDiagnosticsTest, HidesModelPath) {
+  DiagnosticsInput in = Sample();
+  in.custom_model_path = true;
+  const std::string out = FormatDiagnostics(in);
+  EXPECT_NE(out.find("model_path=指定あり"), std::string::npos);
+}
+
+TEST(KotoriDiagnosticsTest, PruneKeepsNewest) {
+  absl::StatusOr<TempDirectory> made = TempDirectory::Default().CreateTempDirectory();
+  ASSERT_OK(made);
+  const TempDirectory &temp = *made;
+  for (int i = 1; i <= 7; ++i) {
+    ASSERT_OK(FileUtil::SetContents(
+        FileUtil::JoinPath(temp.path(),
+                           absl::StrCat("crash-2026100", i, "-000000-1.txt")),
+        "time=x\n"));
+  }
+  ASSERT_OK(FileUtil::SetContents(FileUtil::JoinPath(temp.path(), "other.txt"),
+                                  "x"));
+  const std::vector<std::string> kept = PruneCrashLogs(temp.path(), 5);
+  ASSERT_EQ(kept.size(), 5);
+  EXPECT_EQ(FileUtil::Basename(kept[0]), "crash-20261007-000000-1.txt");
+  EXPECT_EQ(FileUtil::Basename(kept[4]), "crash-20261003-000000-1.txt");
+  EXPECT_FALSE(FileUtil::FileExists(FileUtil::JoinPath(
+                                        temp.path(), "crash-20261001-000000-1.txt"))
+                   .ok());
+  EXPECT_OK(FileUtil::FileExists(FileUtil::JoinPath(temp.path(), "other.txt")));
+}
+
+#ifdef _WIN32
+// 異常終了(abort)で記録が書かれ、メモリの中身ではなく種類と場所だけが入る。
+TEST(KotoriDiagnosticsDeathTest, WritesCrashLogOnAbort) {
+  // 死ぬ側は別のプロセスでこのテストをやり直すので、置き場は毎回同じ名前にする。
+  const std::string dir =
+      FileUtil::JoinPath(TempDirectory::Default().path(), "kotori_crash_test");
+  PruneCrashLogs(dir, 0);  // 前の実行の記録を消す
+  EXPECT_EXIT(
+      {
+        InstallCrashLoggerTo(dir);
+        std::abort();
+      },
+      ::testing::ExitedWithCode(3), "");
+  const std::vector<std::string> logs = PruneCrashLogs(dir, kMaxCrashLogs);
+  ASSERT_EQ(logs.size(), 1);
+  absl::StatusOr<std::string> text = FileUtil::GetContents(logs[0]);
+  ASSERT_OK(text);
+  EXPECT_NE(text->find("kind=abort\n"), std::string::npos) << *text;
+  EXPECT_NE(text->find("version="), std::string::npos) << *text;
+  EXPECT_NE(text->find("frame="), std::string::npos) << *text;
+}
+#endif  // _WIN32
+
+}  // namespace
+}  // namespace kotori
+}  // namespace mozc
