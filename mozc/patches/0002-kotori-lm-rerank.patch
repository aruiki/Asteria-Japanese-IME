+// Kotori: GUIが開いている間だけ、実際の変換サーバーを2秒間隔で測る。
+// 状態ファイルのPID・起動時刻・実行ファイルを照合し、古い記録は動作中と表示しない。
+class KotoriDashboardSample {
+ public:
+  QString ai, models, inference, server_memory, server_cpu, pc_memory, pc_cpu;
+  QString ai_state;
+  std::optional<double> pc_cpu_load, pc_memory_load, server_cpu_load,
+      server_ram_mib, ai_seconds;
+
+  void Update() {
+    pc_cpu_load.reset();
+    pc_memory_load.reset();
+    server_cpu_load.reset();
+    server_ram_mib.reset();
+    ai_seconds.reset();
+    ai_state = "unknown";
+    const KotoriStatus status = ReadKotoriStatus();
+    const auto value = [&](const char *key) {
+      const auto found = status.find(key);
+      return found == status.end() ? QString()
+                                   : QString::fromUtf8(found->second.c_str());
+    };
+    ai = QString::fromUtf8(
+        "AIの状態はまだ取得できません。日本語を入力すると更新されます。");
+    models = QString::fromUtf8("実行中のモデル: 未確認");
+    inference = QString::fromUtf8("AI計算時間: まだ計測データがありません");
+    server_memory = QString::fromUtf8("Asteriaのメモリ: 取得できません");
+    server_cpu = QString::fromUtf8("AsteriaのCPU: 取得できません");
+    pc_memory = QString::fromUtf8("PCのメモリ: 取得できません");
+    pc_cpu = QString::fromUtf8("PCのCPU: 計測中");
+#ifdef _WIN32
+    MEMORYSTATUSEX memory = {sizeof(memory)};
+    if (::GlobalMemoryStatusEx(&memory)) {
+      pc_memory_load = memory.dwMemoryLoad;
+      pc_memory =
+          QString::fromUtf8("PCのメモリ: %1 / %2 GiB（%3%）")
+              .arg((memory.ullTotalPhys - memory.ullAvailPhys) /
+                       (1024.0 * 1024 * 1024),
+                   0, 'f', 1)
+              .arg(memory.ullTotalPhys / (1024.0 * 1024 * 1024), 0, 'f', 1)
+              .arg(memory.dwMemoryLoad);
+    }
+    FILETIME idle, kernel, user;
+    if (::GetSystemTimes(&idle, &kernel, &user)) {
+      const quint64 total = Ticks(kernel) + Ticks(user), idle_now = Ticks(idle);
+      if (system_total_ != 0 && total > system_total_ &&
+          idle_now >= system_idle_) {
+        const double busy = 1.0 - static_cast<double>(idle_now - system_idle_) /
+                                      (total - system_total_);
+        pc_cpu_load = std::clamp(busy * 100.0, 0.0, 100.0);
+        pc_cpu = QString::fromUtf8("PCのCPU: %1%")
+                     .arg(std::clamp(busy * 100.0, 0.0, 100.0), 0, 'f', 1);
+      }
+      system_total_ = total;
+      system_idle_ = idle_now;
+    }
+    bool pid_ok = false, creation_ok = false;
+    const DWORD pid = value("pid").toUInt(&pid_ok);
+    const quint64 start = value("process_started").toULongLong(&creation_ok);
+    HANDLE process =
+        pid_ok && creation_ok && pid != 0
+            ? ::OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)
+            : nullptr;
+    FILETIME created, exited, process_kernel, process_user;
+    wchar_t image[32768];
+    DWORD image_size = std::size(image);
+    DWORD exit_code = 0;
+    const QString expected =
+        QDir::cleanPath(QString::fromUtf8(SystemUtil::GetServerPath().c_str()));
+    const bool active =
+        process && ::GetExitCodeProcess(process, &exit_code) &&
+        exit_code == STILL_ACTIVE &&
+        ::GetProcessTimes(process, &created, &exited, &process_kernel,
+                          &process_user) &&
+        Ticks(created) == start &&
+        ::QueryFullProcessImageNameW(process, 0, image, &image_size) &&
+        QDir::cleanPath(QString::fromWCharArray(image, image_size))
+                .compare(expected, Qt::CaseInsensitive) == 0;
+    if (active) {
+      ai = QString::fromUtf8(FormatKotoriAiStatus(status).c_str());
+      ai_state = value("state");
+      QStringList names;
+      if (!value("zenz").isEmpty()) names << value("zenz");
+      if (!value("llm").isEmpty()) names << value("llm");
+      models = QString::fromUtf8("実行中のモデル: %1")
+                   .arg(names.isEmpty() ? QString::fromUtf8("なし")
+                                        : names.join(" / "));
+      const QRegularExpression counters(
+          "zenz work=([0-9]+)ms decode=([0-9]+)ms calls=([0-9]+) "
+          "tokens=([0-9]+) \\| llm work=([0-9]+)ms decode=([0-9]+)ms "
+          "calls=([0-9]+) tokens=([0-9]+)");
+      const auto match = counters.match(value("stats"));
+      if (match.hasMatch()) {
+        ai_seconds =
+            (match.captured(1).toDouble() + match.captured(5).toDouble()) /
+            1000.0;
+        inference = QString::fromUtf8("AI計算の累計: %1秒　モデル計算: %2回")
+                        .arg((match.captured(1).toDouble() +
+                              match.captured(5).toDouble()) /
+                                 1000.0,
+                             0, 'f', 2)
+                        .arg(match.captured(3).toULongLong() +
+                             match.captured(7).toULongLong());
+      }
+      using MemoryInfo =
+          BOOL(WINAPI *)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+      const auto get_memory = reinterpret_cast<MemoryInfo>(::GetProcAddress(
+          ::GetModuleHandleW(L"kernel32.dll"), "K32GetProcessMemoryInfo"));
+      PROCESS_MEMORY_COUNTERS_EX counters_memory = {};
+      counters_memory.cb = sizeof(counters_memory);
+      if (get_memory && get_memory(process,
+                                   reinterpret_cast<PPROCESS_MEMORY_COUNTERS>(
+                                       &counters_memory),
+                                   sizeof(counters_memory))) {
+        server_ram_mib = counters_memory.WorkingSetSize / (1024.0 * 1024.0);
+        server_memory =
+            QString::fromUtf8(
+                "Asteriaのメモリ（常駐RAM）: %1\nプライベート確保量: %2")
+                .arg(MemoryText(counters_memory.WorkingSetSize),
+                     MemoryText(counters_memory.PrivateUsage));
+      }
+      const quint64 now = ::GetTickCount64(),
+                    cpu = Ticks(process_kernel) + Ticks(process_user);
+      if (last_pid_ == pid && last_start_ == start && now > last_wall_ &&
+          cpu >= last_cpu_) {
+        SYSTEM_INFO info;
+        ::GetNativeSystemInfo(&info);
+        const double usage =
+            (cpu - last_cpu_) / (10000.0 * (now - last_wall_) *
+                                 std::max<DWORD>(1, info.dwNumberOfProcessors));
+        server_cpu_load = std::clamp(usage * 100.0, 0.0, 100.0);
+        server_cpu = QString::fromUtf8("AsteriaのCPU: %1%")
+                         .arg(std::clamp(usage * 100.0, 0.0, 100.0), 0, 'f', 1);
+      } else {
+        server_cpu = QString::fromUtf8("AsteriaのCPU: 計測中");
+      }
+      last_pid_ = pid;
+      last_start_ = start;
+      last_wall_ = now;
+      last_cpu_ = cpu;
+    } else {
+      last_pid_ = 0;
+      if (!value("state").isEmpty())
+        ai = QString::fromUtf8(
+            "AIの現在の状態は未確認です。変換サーバーの起動後に更新されます。");
+    }
+    if (process) ::CloseHandle(process);
+#else
+    ai = QString::fromUtf8(FormatKotoriAiStatus(status).c_str());
+#endif
+  }
+
+ private:
+#ifdef _WIN32
+  static quint64 Ticks(FILETIME time) {
+    return (static_cast<quint64>(time.dwHighDateTime) << 32) |
+           time.dwLowDateTime;
+  }
+  quint64 system_total_ = 0, system_idle_ = 0, last_start_ = 0, last_wall_ = 0,
+          last_cpu_ = 0;
+  DWORD last_pid_ = 0;
+#endif
+};
