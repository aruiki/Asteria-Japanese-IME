+#ifndef _WIN32
   QApplication::setStyle(QStyleFactory::create(QLatin1String("fusion")));
+#endif
 
   // QApplication takes argc as a reference.
   auto app = std::make_unique<QApplication>(argc, argv);
+#ifdef _WIN32
+  // Kotori: Windowsの標準スタイルの矢印・チェック・フォーカス表示を使う。
+  if (auto* style = QStyleFactory::create(QLatin1String("windowsvista"))) {
+    app->setStyle(style);
+  } else if (auto* style = QStyleFactory::create(QLatin1String("windows"))) {
+    app->setStyle(style);
+  }
+#endif
 #ifdef __APPLE__
   app->setFont(QFont("Hiragino Sans"));
 #endif  // __APPLE__
 
+  // Kotori: 画面は明るい配色で作っているので、Windows がダークモードでも明るい配色にする
+  // (ダークモードでは Qt がボタンなどの文字を白にし、白い背景の上で文字が消えた。docs/adr/0024)。
