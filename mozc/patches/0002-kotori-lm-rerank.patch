+// Exercise the actual publication and application boundary without inference.
+// A temporary profile and disabled preload config keep this independent of the
+// installed IME and installed models.
+class LmRewriterGenerationTest : public testing::TestWithTempUserProfile {
+ protected:
+  using Snapshot = ConversionRequest::KotoriInputGeneration;
+  using Best = LmRewriter::Best;
+
+  void SetUp() override {
+    original_config_ = config::ConfigHandler::GetCopiedConfig();
+    config::Config disabled = original_config_;
+    disabled.set_kotori_lm_enabled(false);
+    config::ConfigHandler::SetConfig(disabled);
+    config_.set_kotori_lm_enabled(true);
+    rewriter_ = std::make_unique<LmRewriter>(
+        nullptr, nullptr, dictionary::PosMatcher(data_.GetPosMatcherData()));
+    ReplaceModelHashes();
+  }
+  void TearDown() override {
+    rewriter_.reset();
+    config::ConfigHandler::SetConfig(original_config_);
+  }
+  Best Corrected(Snapshot input) const {
+    Best best{"あしをいためた", "", {"あしをいためた"}, {"足を痛めた"}};
+    best.correction = LmRewriter::CorrectionOrigin{
+        std::move(input), rewriter_->correction_models_,
+        rewriter_->MemoKey(config_, best.reading, best.context)};
+    return best;
+  }
+  ConversionRequest Request(Snapshot input, bool changed_config = false) const {
+    config::Config config = config_;
+    if (changed_config) config.set_kotori_lm_model_path("different-model.gguf");
+    return ConversionRequestBuilder().SetConfig(config)
+        .SetKotoriInputGeneration(std::move(input)).Build();
+  }
+  bool Save(const Best& best, bool cancelled = false) const {
+    return rewriter_->StoreMemo("test-key", best, true,
+                                [cancelled] { return cancelled; });
+  }
+  bool Recall(const ConversionRequest& request) const {
+    const auto memo = rewriter_->FindMemo("test-key", request);
+    return memo.has_value() && memo->has_value();
+  }
+  bool Apply(const Best& best, const ConversionRequest& request) const {
+    Segments segments;
+    Segment* segment = segments.add_segment();
+    segment->set_key("あしをいためた");
+    auto* candidate = segment->add_candidate();
+    candidate->key = candidate->content_key = "あしをいためた";
+    candidate->value = candidate->content_value = "足を炒めた";
+    bool changed = false;
+    const bool accepted = rewriter_->ApplyBestFrom(
+        best, request, &segments, "", &changed);
+    EXPECT_EQ(segment->candidate(0).value,
+              accepted ? "足を痛めた" : "足を炒めた");
+    EXPECT_EQ(changed, accepted);
+    return accepted;
+  }
+  void CheckCorrectedReadingMetadata(bool protected_user_word) const {
+    auto owner = std::make_shared<std::atomic<uint64_t>>(1);
+    auto best = Corrected({owner, 1});
+    best.reading = "ちょとまってください";
+    best.keys = {best.reading};
+    best.values = {"ちょっと待ってください"};
+    best.corrected_reading = "ちょっとまってください";
+    best.correction->config_key = rewriter_->MemoKey(config_, best.reading, "");
+    Segments segments;
+    auto* segment = segments.add_segment();
+    segment->set_key(best.reading);
+    auto* original = segment->add_candidate();
+    original->key = original->content_key = best.reading;
+    original->value = original->content_value = "ちょと待ってください";
+    if (protected_user_word) original->attributes |= converter::Attribute::USER_DICTIONARY;
+    bool changed = false;
+    ASSERT_TRUE(rewriter_->ApplyBestFrom(best, Request({owner, 1}), &segments, "", &changed));
+    EXPECT_EQ(changed, !protected_user_word);
+    if (protected_user_word) {
+      ASSERT_EQ(segment->candidates_size(), 1);
+      EXPECT_EQ(segment->candidate(0).value, "ちょと待ってください");
+      EXPECT_TRUE(segment->candidate(0).kotori_corrected_reading.empty());
+      EXPECT_EQ(segment->candidate(0).attributes & converter::Attribute::SPELLING_CORRECTION, 0);
+    } else {
+      ASSERT_EQ(segment->candidates_size(), 2);
+      EXPECT_EQ(segment->candidate(0).value, best.values[0]);
+      EXPECT_EQ(segment->candidate(0).kotori_corrected_reading, best.corrected_reading);
+      EXPECT_EQ(segment->candidate(0).attributes & converter::Attribute::NO_LEARNING,
+                converter::Attribute::NO_LEARNING);
+      EXPECT_EQ(segment->candidate(1).value, "ちょと待ってください");
+      EXPECT_TRUE(segment->candidate(1).kotori_corrected_reading.empty());
+      EXPECT_EQ(segment->candidate(1).attributes & converter::Attribute::SPELLING_CORRECTION, 0);
+    }
+  }
+  bool SavePredictionBase(const Best& best) const {
+    return rewriter_->StoreMemo(
+        rewriter_->MemoKey(config_, best.reading, best.context), best, true,
+        [] { return false; });
+  }
+  std::optional<std::string> PredictionBase(const ConversionRequest& request,
+                                          const std::string& reading = "あしをいためた",
+                                          const std::string& context = "") const {
+    return rewriter_->EvaluatedPredictionBase(request, reading, context);
+  }
+  size_t CachedPredictionCountWithMalformedText() const {
+    const std::string reading = "あしをいためた";
+    const std::string key = rewriter_->CacheKey(config_, "");
+    rewriter_->StorePredictions(reading, key, {
+        {"足を痛めたので\xe3\x83", "足を痛めた", reading, "", false},
+        {"足を痛めたので", "足を痛めた", reading, "\xe3\x83", false},
+        {"足を痛めたので", "足を痛めた", reading, reading + "ので", false}});
+    return rewriter_->CachedPredictions(reading, key, 6).size();
+  }
+  void ReloadModel() { ++rewriter_->model_epoch_; }
+  void ReplaceModelHashes() {
+    std::lock_guard<std::mutex> lock(rewriter_->job_mu_);
+    rewriter_->correction_models_ =
+        std::make_shared<const LmRewriter::CorrectionModels>(
+            LmRewriter::CorrectionModels{rewriter_->model_epoch_.load(),
+                std::string(64, 'a'), std::string(64, 'b')});
+  }
+  void RemoveModelIdentity() {
+    std::lock_guard<std::mutex> lock(rewriter_->job_mu_);
+    rewriter_->correction_models_.reset();
+  }
+
+ private:
+  testing::MockDataManager data_;
+  config::Config original_config_;
+  config::Config config_;
+  std::unique_ptr<LmRewriter> rewriter_;
+};
