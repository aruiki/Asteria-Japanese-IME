+++ b/src/rewriter/kotori_model_identity_test.cc
@@ -0,0 +1,87 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#include "rewriter/kotori_model_identity.h"
+
+#include <fstream>
+#include <string>
+
+#include "base/file_util.h"
+#include "testing/mozctest.h"
+#include "testing/gunit.h"
+
+namespace mozc {
+#ifdef _WIN32
+TEST(KotoriModelIdentityTest, KnownDigestsAndMultipleReadHandles) {
+  auto file = testing::MakeTempFileOrDie();
+  ASSERT_TRUE(FileUtil::SetContents(file.path(), "abc").ok());
+  auto identity = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(identity, nullptr);
+  EXPECT_EQ(identity->sha256(),
+      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+  auto same = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(same, nullptr);
+  EXPECT_EQ(identity->sha256(), same->sha256());
+  identity.reset();
+  same.reset();
+  ASSERT_TRUE(FileUtil::SetContents(file.path(), "").ok());
+  identity = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(identity, nullptr);
+  EXPECT_EQ(identity->sha256(),
+      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+}
+
+TEST(KotoriModelIdentityTest, HashesAllChunks) {
+  auto file = testing::MakeTempFileOrDie();
+  ASSERT_TRUE(FileUtil::SetContents(file.path(), std::string(2 * 1024 * 1024 + 7, 'a')).ok());
+  auto identity = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(identity, nullptr);
+  EXPECT_EQ(identity->sha256(), "9894227c2ddb433377d6e71695ea85c203eaabb67f7dadedf4ae462d41e715e6");
+}
+
+TEST(KotoriModelIdentityTest, UnicodePath) {
+  auto directory = testing::MakeTempDirectoryOrDie();
+  const std::string path = FileUtil::JoinPath(directory.path(), "小鳥モデル.gguf");
+  ASSERT_TRUE(FileUtil::SetContents(path, "abc").ok());
+  auto identity = KotoriModelIdentity::Open(path);
+  ASSERT_NE(identity, nullptr);
+  EXPECT_EQ(identity->sha256(),
+      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+}
+
+TEST(KotoriModelIdentityTest, KeepsHashedFileUnchangedUntilOwnerReleasesIt) {
+  auto file = testing::MakeTempFileOrDie();
+  ASSERT_TRUE(FileUtil::SetContents(file.path(), "abc").ok());
+  auto identity = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(identity, nullptr);
+  EXPECT_FALSE(FileUtil::SetContents(file.path(), "changed").ok());
+  EXPECT_FALSE(FileUtil::Unlink(file.path()).ok());
+  auto destination = testing::MakeTempFileOrDie();
+  EXPECT_FALSE(FileUtil::AtomicRename(file.path(), destination.path()).ok());
+  ASSERT_TRUE(FileUtil::GetContents(file.path()).ok());
+  EXPECT_EQ(*FileUtil::GetContents(file.path()), "abc");
+  identity.reset();
+  ASSERT_TRUE(FileUtil::SetContents(file.path(), "changed").ok());
+  auto changed = KotoriModelIdentity::Open(file.path());
+  ASSERT_NE(changed, nullptr);
+  EXPECT_NE(changed->sha256(),
+      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+}
+
+TEST(KotoriModelIdentityTest, RejectsAlreadyWritableFile) {
+  auto file = testing::MakeTempFileOrDie();
+  std::ofstream writer(file.path(), std::ios::binary);
+  ASSERT_TRUE(writer.good());
+  EXPECT_EQ(KotoriModelIdentity::Open(file.path()), nullptr);
+  writer.close();
+  EXPECT_NE(KotoriModelIdentity::Open(file.path()), nullptr);
+}
+#endif  // _WIN32
+
+TEST(KotoriModelIdentityTest, RejectsUnavailableFileAndInvalidPath) {
+  EXPECT_EQ(KotoriModelIdentity::Open(""), nullptr);
+  auto directory = testing::MakeTempDirectoryOrDie();
+  EXPECT_EQ(KotoriModelIdentity::Open(
+      FileUtil::JoinPath(directory.path(), "missing.gguf")), nullptr);
+  EXPECT_EQ(KotoriModelIdentity::Open(std::string("bad\0path", 8)), nullptr);
+  EXPECT_EQ(KotoriModelIdentity::Open(std::string("\xff", 1)), nullptr);
+}
+}  // namespace mozc
diff --git a/src/rewriter/kotori_nuance_rewriter.cc b/src/rewriter/kotori_nuance_rewriter.cc
new file mode 100644
index 000000000..315af4f83
--- /dev/null
+++ b/src/rewriter/kotori_nuance_rewriter.cc
@@ -0,0 +1,112 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#include "rewriter/kotori_nuance_rewriter.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/util.h"
+#include "converter/attribute.h"
+#include "converter/candidate.h"
+#include "converter/segments.h"
+#include "request/conversion_request.h"
+
+namespace mozc {
+namespace {
+struct Choice { const char* word; const char* meaning; };
+// Kotori: 各組は同じ読み。判断を自動で置き換えず、意味を添えた選択肢にする。
+const std::vector<std::vector<Choice>>& Groups() {
+  static const std::vector<std::vector<Choice>> groups = {
+      {{"特徴", "目立つ性質"}, {"特長", "良いところ・長所"}},
+      {{"意志", "こうしたいという思い"}, {"意思", "考え・意向"}},
+      {{"制作", "作品を作る"}, {"製作", "物を作る"}},
+      {{"保証", "確かだと請け合う"}, {"保障", "権利や安全を守る"}, {"補償", "損失を補う"}},
+      {{"回答", "質問への返事"}, {"解答", "問題の答え"}},
+      {{"対象", "相手・目的となるもの"}, {"対照", "比べ合わせる"}, {"対称", "釣り合った配置"}},
+      {{"関心", "興味を持つこと"}, {"感心", "優れたものと認めること"}},
+  };
+  return groups;
+}
+}  // namespace
+
+bool KotoriNuanceRewriter::Rewrite(const ConversionRequest& request,
+                                    Segments* segments) const {
+  if (request.request_type() != ConversionRequest::CONVERSION ||
+      request.incognito_mode() ||
+      request.context().input_field_type() == commands::Context::PASSWORD ||
+      segments->conversion_segments_size() == 0) return false;
+  const size_t count = segments->conversion_segments_size();
+  // Kotori: FIXED_BOUNDARYは文節の境界を守る。AIの文節伸縮もこの種別を使うため、
+  // 境界と読みを変えない表記の選択肢は提示する。FIXED_VALUEや保護属性のある
+  // 候補は引き続き変更しない。
+  std::string reading, original;
+  for (const Segment& segment : segments->conversion_segments()) {
+    if (segment.candidates_size() == 0 || segment.segment_type() == Segment::FIXED_VALUE ||
+        (segment.candidate(0).attributes &
+         (converter::Attribute::USER_DICTIONARY | converter::Attribute::NO_MODIFICATION |
+          converter::Attribute::COMMAND_CANDIDATE))) return false;
+    reading += segment.key();
+  }
+  for (size_t i = 0; i < count;) {
+    const auto& top = segments->conversion_segment(i).candidate(0);
+    const size_t span = top.effective_converted_segment_count();
+    if (span > count - i) return false;
+    original += top.value;
+    i += span;
+  }
+  if (original.empty() || original.size() > 1024 || Util::CharsLen(reading) > 160) return false;
+  Segment* head = segments->mutable_conversion_segment(0);
+  std::vector<converter::Candidate> alternatives;
+  constexpr size_t kMaxAlternatives = 6;
+  for (const auto& group : Groups()) {
+    for (const Choice& from : group) {
+      size_t position = 0;
+      while ((position = original.find(from.word, position)) != std::string::npos) {
+        for (const Choice& to : group) {
+          if (from.word == to.word || std::string(from.word) == to.word) continue;
+          std::string text = original;
+          text.replace(position, std::char_traits<char>::length(from.word), to.word);
+          bool duplicate = false;
+          for (const auto* candidate : head->candidates()) {
+            if (candidate->key == reading && candidate->value == text) { duplicate = true; break; }
+          }
+          if (duplicate || std::any_of(alternatives.begin(), alternatives.end(),
+              [&](const auto& candidate) { return candidate.value == text; })) continue;
+          converter::Candidate candidate = head->candidate(0);
+          candidate.key = candidate.content_key = reading;
+          candidate.value = candidate.content_value = text;
+          candidate.converted_segment_count = count;
+          candidate.inner_segment_boundary.clear();
+          candidate.prefix.clear();
+          candidate.suffix.clear();
+          candidate.display_value.clear();
+          candidate.usage_id = 0;
+          candidate.usage_title.clear();
+          candidate.usage_description.clear();
+          candidate.description = std::string(from.word) + " → " + to.word + "（" + to.meaning + "）";
+          candidate.a11y_description = candidate.description;
+          candidate.attributes = converter::Attribute::NO_LEARNING |
+                                  converter::Attribute::NO_VARIANTS_EXPANSION;
+          candidate.kotori_ai_evaluated = false;
+          candidate.kotori_confident_prediction = false;
+          candidate.kotori_nuance_alternative = true;
+          alternatives.push_back(std::move(candidate));
+          if (alternatives.size() >= kMaxAlternatives) break;
+        }
+        if (alternatives.size() >= kMaxAlternatives) break;
+        position += std::char_traits<char>::length(from.word);
+      }
+      if (alternatives.size() >= kMaxAlternatives) break;
+    }
+    if (alternatives.size() >= kMaxAlternatives) break;
+  }
+  // Kotori: 読みが同じ、漢字が複数というだけでは意味の近い選択肢ではない。
+  // 「医者に」を「慰謝に」へ優先すると、正しい変換を次のSpaceで壊してしまう。
+  // 説明できる語組だけを優先し、その他の辞書候補は元の文節内に保持する。
+  // 最初の候補と既存の順序を保ち、その間に文全体の意味の選択肢を挿入する。
+  for (size_t i = 0; i < alternatives.size(); ++i) {
+    *head->insert_candidate(i + 1) = std::move(alternatives[i]);
+  }
+  return !alternatives.empty();
+}
+}  // namespace mozc
