+  void OnKotoriRefreshTimer() {
+    wil::com_ptr_nothrow<ITfContext> target = std::move(kotori_refresh_context_);
+    KotoriCancelRefresh();
+    if (!target) {
+      return;
+    }
+    // 頼んだ後にフォーカスが別の欄に移っていたら何もしない。
+    wil::com_ptr_nothrow<ITfDocumentMgr> document_manager;
+    if (FAILED(thread_mgr_->GetFocus(&document_manager)) || !document_manager) {
+      return;
