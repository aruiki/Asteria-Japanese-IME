diff --git a/src/rewriter/llama_runtime.h b/src/rewriter/llama_runtime.h
new file mode 100644
index 000000000..cf2c801ea
--- /dev/null
+++ b/src/rewriter/llama_runtime.h
@@ -0,0 +1,37 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+//
+// Kotori: llama.cpp の実行時の準備(docs/adr/0016)。
+//
+// Windows では、インストール先に同梱した llama.cpp の公式ビルド(llama.dll、ggml*.dll)を
+// 実行時に読み込む。ggml は GPU(Vulkan)と CPU の種類ごとの DLL から使えるものを自動で選ぶので、
+// ユーザーは CUDA Toolkit などを入れなくてよい。Windows 以外は静的にリンクした CPU 版を使う。
+
+#ifndef MOZC_REWRITER_LLAMA_RUNTIME_H_
+#define MOZC_REWRITER_LLAMA_RUNTIME_H_
+
+#include <string>
+
+#include "ggml-backend.h"
+
+namespace mozc {
+
+// llama.cpp を使える状態にする。dir は DLL のあるフォルダ(Windows のみ使う)。
+// 2 回目以降は前の結果を返す。
+bool EnsureLlamaRuntime(const std::string& dir);
+
+// AI を載せる GPU。専用の GPU(内蔵 GPU は除く)のうち VRAM が最も大きいもので、VRAM が
+// 3 GiB 以上のものだけを使う(docs/adr/0024)。内蔵 GPU はメインメモリを共有し、LLM を載せると
+// 変換で固まることがあるため使わない。なければ nullptr(CPU で動かす)。
+// 環境変数 KOTORI_LM_DEVICE=cpu で GPU を使わない(評価用。ノート PC の再現)。
+// EnsureLlamaRuntime の後に呼ぶ。
+ggml_backend_dev_t LlamaGpuDevice();
+
+// LlamaGpuDevice() があるか。
+bool LlamaHasGpu();
+
+// LlamaGpuDevice() の名前(設定画面の AI の状態に出す)。なければ空。
+std::string LlamaGpuName();
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_LLAMA_RUNTIME_H_
diff --git a/src/rewriter/llm_correction_eval_main.cc b/src/rewriter/llm_correction_eval_main.cc
new file mode 100644
index 000000000..d5640c186
--- /dev/null
+++ b/src/rewriter/llm_correction_eval_main.cc
@@ -0,0 +1,153 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+// 開発用。非同期ワーカーと同じ補正ガードを実辞書・実モデルで評価する。
+// TSFや初回表示への反映は、別の実セッション試験で確認する。
+#include <algorithm>
+#include <charconv>
+#include <chrono>
+#include <cstdio>
+#include <iomanip>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <utility>
+#include <vector>
+#include "base/util.h"
+#include "dictionary/dictionary_token.h"
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#endif
+#include "base/system_util.h"
+#include "data_manager/data_manager.h"
+#include "engine/modules.h"
+#include "rewriter/lm_rewriter.h"
+#include "rewriter/zenz_scorer.h"
+
+// 第3列の対照候補が指定された開発試験だけで、拒否の原因を調べる。
+void Diagnose(const mozc::dictionary::DictionaryInterface& dictionary,
+              mozc::dictionary::PosMatcher matcher,
+              const std::string& reading, const std::string& original) {
+  class Collector : public mozc::dictionary::DictionaryInterface::Callback {
+   public:
+    std::vector<mozc::dictionary::Token> tokens;
+    ResultType OnToken(absl::string_view, absl::string_view,
+                       mozc::dictionary::Token token) override {
+      tokens.push_back(token); return TRAVERSE_CONTINUE;
+    }
+  };
+  for (const bool reverse : {false, true}) {
+    const auto& text = reverse ? original : reading;
+    for (size_t i = 0; i < mozc::Util::CharsLen(text); ++i) {
+      Collector collector;
+      const auto suffix = mozc::Util::Utf8SubString(text, i);
+      if (reverse) dictionary.LookupReverse(suffix, &collector);
+      else dictionary.LookupPrefix(suffix, &collector);
+      for (const auto& token : collector.tokens) {
+        if (matcher.IsUniqueNoun(token.lid) || matcher.IsUniqueNoun(token.rid) ||
+            (matcher.IsFunctional(token.lid) && matcher.IsSuffixWord(token.lid)) ||
+            (matcher.IsFunctional(token.rid) && matcher.IsSuffixWord(token.rid)) ||
+            matcher.IsPronoun(token.lid) || matcher.IsPronoun(token.rid) ||
+            (token.attributes & mozc::dictionary::Token::USER_DICTIONARY)) {
+          if ((reverse && suffix.starts_with(token.key)) ||
+              (!reverse && original.find(token.value) != std::string::npos)) {
+            std::cerr << "protected\t" << reverse << '\t' << token.key << '\t'
+                      << token.value << '\t' << token.lid << '\t' << token.rid << '\n';
+          }
+        }
+      }
+    }
+  }
+}
+
+int main(int argc, char* argv[]) {
+  if (argc != 8) {
+    std::cerr << "usage: llm_correction_eval_main data zenz llm runtime profile budget_ms beams\n";
+    return 2;
+  }
+  auto integer = [](const char* arg, int* value) {
+    const std::string s(arg);
+    const auto [end, ec] = std::from_chars(s.data(), s.data() + s.size(), *value);
+    return ec == std::errc() && end == s.data() + s.size();
+  };
+  int budget = 0, beams = 0;
+  if (!integer(argv[6], &budget) || budget < 1 || budget > 60000 ||
+      !integer(argv[7], &beams) || beams < 1 || beams > 4) return 2;
+#ifdef _WIN32
+  if (_setmode(_fileno(stdin), _O_BINARY) < 0 ||
+      _setmode(_fileno(stdout), _O_BINARY) < 0) return 3;
+#endif
+  mozc::SystemUtil::SetUserProfileDirectory(argv[5]);
+  auto data = mozc::DataManager::CreateFromFile(argv[1]);
+  if (!data.ok()) { std::cerr << data.status(); return 3; }
+  auto modules = mozc::engine::Modules::Create(*std::move(data));
+  if (!modules.ok()) { std::cerr << modules.status(); return 3; }
+  const int threads = std::max(1u, std::thread::hardware_concurrency() / 2);
+  auto zenz = mozc::ZenzScorer::Open(argv[2], threads, argv[4]);
+  auto llm = mozc::ZenzScorer::Open(argv[3], threads, argv[4]);
+  if (!zenz || !llm || !zenz->is_zenz() || llm->is_zenz()) return 3;
+  mozc::kotori_internal::CorrectionOptions options;
+  options.beams = beams;
+  std::cout << std::fixed << std::setprecision(3);
+  size_t lines = 0, changed = 0;
+  std::string line;
+  while (std::getline(std::cin, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    const auto tab = line.find('\t');
+    if (tab == std::string::npos) return 2;
+    const auto second = line.find('\t', tab + 1);
+    if (second != std::string::npos && line.find('\t', second + 1) != std::string::npos) return 2;
+    const auto reading = line.substr(0, tab);
+    const auto original = line.substr(tab + 1, second == std::string::npos ? second : second - tab - 1);
+    std::vector<std::string> score_values = {original};
+    if (second != std::string::npos) {
+      score_values.push_back(line.substr(second + 1));
+      const bool guard = mozc::kotori_internal::IsSafeDictionaryCorrection(
+          (*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading,
+          original, score_values.back());
+      std::string corrected_reading;
+      const bool typo_guard = mozc::kotori_internal::IsSafeDictionaryTypoCorrection(
+          (*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading,
+          original, score_values.back(), &corrected_reading);
+      std::cerr << "control_guard\t" << guard << "\ttypo_guard\t" << typo_guard
+                << "\tcorrected_reading\t" << corrected_reading << '\n';
+      // 開発用の第3列を渡した時だけ、生成候補の拒否理由を調べる。
+      for (const auto& value : llm->Correct(reading, original, options.prompt, beams)) {
+        std::string yomi;
+        const bool same = mozc::kotori_internal::IsSafeDictionaryCorrection(
+            (*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading, original, value);
+        const bool typo = mozc::kotori_internal::IsSafeDictionaryTypoCorrection(
+            (*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading, original, value, &yomi);
+        std::cerr << "generated\t" << value << "\tsame\t" << same
+                  << "\ttypo\t" << typo << "\tyomi\t" << yomi << '\n';
+      }
+      Diagnose((*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading, original);
+      Diagnose((*modules)->GetDictionary(), (*modules)->GetPosMatcher(), reading, score_values.back());
+    }
+    const auto start = std::chrono::steady_clock::now();
+    const auto deadline = start + std::chrono::milliseconds(budget);
+    const auto cancelled = [&] { return std::chrono::steady_clock::now() >= deadline; };
+    std::optional<std::string> corrected;
+    mozc::ZenzScorer::SetThreadCancel(cancelled);
+    const auto z = zenz->Score("", reading, score_values);
+    const auto l = llm->Score("", reading, score_values);
+    mozc::ZenzScorer::SetThreadCancel({});
+    if (z && l && z->size() == score_values.size() && l->size() == score_values.size() && !cancelled()) {
+      const double score = options.zenz_weight * (*z)[0] + options.llm_weight * (*l)[0];
+      corrected = mozc::kotori_internal::GenerateSafeCorrection(
+          (*modules)->GetDictionary(), (*modules)->GetPosMatcher(), zenz.get(),
+          llm.get(), "", reading, original, score, options, cancelled);
+    }
+    const auto end = std::chrono::steady_clock::now();
+    if (cancelled()) corrected.reset();
+    const auto& result = corrected ? *corrected : original;
+    ++lines; changed += corrected.has_value();
+    std::cout << result << '\t'
+              << std::chrono::duration<double, std::milli>(end - start).count()
+              << '\t' << (corrected ? 1 : 0) << '\n' << std::flush;
+  }
+  std::cerr << "lines=" << lines << " changed=" << changed << '\n'
+            << mozc::ZenzScorer::Stats() << '\n';
+  return std::cin.eof() && std::cout.good() ? 0 : 4;
+}
diff --git a/src/rewriter/llm_correction_main.cc b/src/rewriter/llm_correction_main.cc
new file mode 100644
index 000000000..c31037864
--- /dev/null
+++ b/src/rewriter/llm_correction_main.cc
@@ -0,0 +1,150 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+//
+// Kotori: 補正生成の開発用CLI。stdinはUTF-8の読み<TAB>元候補、stdoutは生成文<TAB>ms。
+// 生成の成功と、IMEが安全に候補を採用できることは別に評価する。
+
+#include <algorithm>
+#include <charconv>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <iomanip>
+#include <iostream>
+#include <string>
+#include <system_error>
+#include <thread>
+
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#endif  // _WIN32
+
+#include "absl/strings/string_view.h"
+#include "base/util.h"
+#include "rewriter/zenz_scorer.h"
+
+namespace {
+
+// TSVを壊す文字と不正なUnicodeを拒否する。補正内容の妥当性は判定しない。
+bool IsSingleLineUtf8(absl::string_view text) {
+  if (text.empty()) return false;
+  while (!text.empty()) {
+    char32_t cp = 0;
+    absl::string_view rest;
+    if (!mozc::Util::SplitFirstChar32(text, &cp, &rest) || cp > 0x10FFFF ||
+        (cp >= 0xD800 && cp <= 0xDFFF) || cp < 0x20 ||
+        (cp >= 0x7F && cp <= 0x9F) || cp == 0x2028 || cp == 0x2029) {
+      return false;
+    }
+    text = rest;
+  }
+  return true;
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  if (argc != 5 && argc != 6) {
+    std::cerr << "usage: llm_correction_main model_path runtime_dir "
+                 "chat|examples budget_ms [beams=1, max=4]\n";
+    return 2;
+  }
+  mozc::ZenzScorer::CorrectionPrompt mode;
+  const std::string mode_arg(argv[3]);
+  if (mode_arg == "chat") {
+    mode = mozc::ZenzScorer::CorrectionPrompt::kChat;
+  } else if (mode_arg == "examples") {
+    mode = mozc::ZenzScorer::CorrectionPrompt::kExamples;
+  } else {
+    std::cerr << "mode must be chat or examples\n";
+    return 2;
+  }
+  int budget_ms = 0;
+  const std::string budget_arg(argv[4]);
+  const auto [budget_end, budget_error] = std::from_chars(
+      budget_arg.data(), budget_arg.data() + budget_arg.size(), budget_ms);
+  if (budget_error != std::errc() ||
+      budget_end != budget_arg.data() + budget_arg.size() || budget_ms <= 0) {
+    std::cerr << "budget_ms must be a positive integer\n";
+    return 2;
+  }
+#ifdef _WIN32
+  // PythonのpipeからUTF-8をそのまま読み書きする。コンソールのコードページに依存しない。
+  if (_setmode(_fileno(stdin), _O_BINARY) == -1 ||
+      _setmode(_fileno(stdout), _O_BINARY) == -1) {
+    std::cerr << "failed to set binary stdio\n";
+    return 3;
+  }
+#endif  // _WIN32
+  int beams = 1;
+  if (argc == 6) {
+    const std::string beam_arg(argv[5]);
+    const auto [end, error] = std::from_chars(
+        beam_arg.data(), beam_arg.data() + beam_arg.size(), beams);
+    if (error != std::errc() || end != beam_arg.data() + beam_arg.size() ||
+        beams < 1 || beams > 4) {
+      std::cerr << "beams must be an integer from 1 to 4\n";
+      return 2;
+    }
+  }
+  const int threads =
+      static_cast<int>(std::max(1u, std::thread::hardware_concurrency() / 2));
+  auto scorer = mozc::ZenzScorer::Open(argv[1], threads, argv[2]);
+  if (scorer == nullptr || scorer->is_zenz()) {
+    std::cerr << "failed to open a general LLM\n";
+    return 3;
+  }
+  std::cerr << "mode=" << mode_arg << " budget_ms=" << budget_ms
+            << " threads=" << threads << '\n';
+  std::cout << std::fixed << std::setprecision(3);
+  std::string line;
+  size_t line_number = 0;
+  size_t generated_count = 0;
+  while (std::getline(std::cin, line)) {
+    ++line_number;
+    // 行末のCRはTSVのCRLF区切りとして扱う。文中のCRは拒否する。
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    const size_t tab = line.find('\t');
+    if (tab == std::string::npos || line.find('\t', tab + 1) != std::string::npos ||
+        !IsSingleLineUtf8(absl::string_view(line).substr(0, tab)) ||
+        !IsSingleLineUtf8(absl::string_view(line).substr(tab + 1))) {
+      std::cerr << "invalid TSV at line " << line_number << '\n';
+      std::cout << '\t' << 0.0 << '\n' << std::flush;
+      continue;
+    }
+    const absl::string_view reading = absl::string_view(line).substr(0, tab);
+    const absl::string_view original = absl::string_view(line).substr(tab + 1);
+    const auto start = std::chrono::steady_clock::now();
+    const auto deadline = start + std::chrono::milliseconds(budget_ms);
+    mozc::ZenzScorer::SetThreadCancel(
+        [deadline] { return std::chrono::steady_clock::now() >= deadline; });
+    const auto candidates = scorer->Correct(reading, original, mode, beams);
+    mozc::ZenzScorer::SetThreadCancel({});
+    const auto end = std::chrono::steady_clock::now();
+    if (beams > 1) {
+      // 開発用CLIだけで、採用試験のために上限付きの生成候補を列挙する。
+      for (size_t i = 0; i < candidates.size(); ++i) {
+        if (IsSingleLineUtf8(candidates[i])) {
+          std::cerr << "candidate\t" << line_number << '\t' << i << '\t'
+                    << candidates[i] << '\n';
+        }
+      }
+    }
+    std::string generated;
+    if (end < deadline && !candidates.empty() &&
+        IsSingleLineUtf8(candidates.front())) {
+      generated = candidates.front();
+      ++generated_count;
+    }
+    const double elapsed_ms =
+        std::chrono::duration<double, std::milli>(end - start).count();
+    std::cout << generated << '\t' << elapsed_ms << '\n' << std::flush;
+  }
+  std::cerr << "lines=" << line_number << " generated=" << generated_count
+            << '\n' << mozc::ZenzScorer::Stats() << '\n';
+  if (!std::cin.eof() || !std::cout.good()) {
+    std::cerr << "stdio failure\n";
+    return 4;
+  }
+  return 0;
+}
