+  for (const auto& candidate : corrected.kotori_sentences()) {
+    if (candidate.key == corrected_key) add(candidate.value);
+  }
+  // 全文候補が少ないときも、補正した読みの文節候補を文全体として選べる。
+  size_t offset = 0;
+  for (const Segment& segment : corrected.conversion_segments()) {
+    const std::string& value = segment.candidate(0).value;
+    for (size_t i = 1; i < std::min<size_t>(segment.candidates_size(), 5); ++i) {
+      const auto& candidate = segment.candidate(i);
+      if (candidate.key != segment.key() ||
+          candidate.effective_converted_segment_count() != 1) continue;
+      add(base_value.substr(0, offset) + candidate.value +
+          base_value.substr(offset + value.size()));
+    }
+    offset += value.size();
+  }
+  add(corrected_key);
+  Segment* destination = segments_.mutable_conversion_segment(0);
+  for (size_t i = 1; i < destination->candidates_size(); ++i) {
+    auto* candidate = destination->mutable_candidate(i);
+    if (candidate->description.empty()) candidate->description = "補正前の読み";
+  }
+  size_t insert_at = 1;
+  for (const std::string& value : values) {
+    converter::Candidate candidate;
+    candidate.key = candidate.content_key = typed_reading;
+    candidate.value = candidate.content_value = value;
+    candidate.consumed_key_size = Util::CharsLen(typed_reading);
+    candidate.attributes = converter::Attribute::SPELLING_CORRECTION |
+                           converter::Attribute::NO_LEARNING;
+    candidate.description = candidate.a11y_description = "補正した読み";
+    *destination->insert_candidate(insert_at++) = std::move(candidate);
+  }
+}
