+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#include <windows.h>
+#include "renderer/win32/win32_dpi_util.h"
+#include "renderer/renderer_style_handler.h"
+#include "testing/gunit.h"
+namespace mozc::renderer::win32 {
+TEST(KotoriPaletteTest, DarkHasReadableTextAndFlatBackground) {
+  RendererStyle style;
+  RendererStyleHandler::GetRendererStyle(&style);
+  ApplyKotoriPalette(&style, false, true);
+  EXPECT_LT(style.candidate_style().background_color().r(), 50);
+  EXPECT_GT(style.candidate_style().foreground_color().r(), 200);
+  EXPECT_EQ(style.footer_top_color().r(), style.candidate_style().background_color().r());
+}
+TEST(KotoriPaletteTest, HighContrastUsesSystemColorsAndVisibleFocus) {
+  RendererStyle style;
+  RendererStyleHandler::GetRendererStyle(&style);
+  ApplyKotoriPalette(&style, true, true);
+  EXPECT_EQ(style.candidate_style().background_color().r(), GetRValue(GetSysColor(COLOR_WINDOW)));
+  EXPECT_EQ(style.candidate_style().foreground_color().r(), GetRValue(GetSysColor(COLOR_WINDOWTEXT)));
+  EXPECT_EQ(style.focused_background_color().r(), style.candidate_style().background_color().r());
+  EXPECT_EQ(style.focused_border_color().r(), GetRValue(GetSysColor(COLOR_HIGHLIGHT)));
+}
+TEST(KotoriPaletteTest, ScalesSpacingAt100150200Percent) {
+  for (const auto dpi : {96, 144, 192}) {
+    RendererStyle style;
+    GetScaledRendererStyle(&style, dpi);
+    EXPECT_EQ(style.row_rect_padding(), 4*dpi/96);
+    EXPECT_GT(style.candidate_style().font_size(), 0);
+  }
+}
+}
