diff --git a/src/rewriter/gen_kotori_english_dictionary.py b/src/rewriter/gen_kotori_english_dictionary.py
new file mode 100644
index 000000000..8888f46d8
--- /dev/null
+++ b/src/rewriter/gen_kotori_english_dictionary.py
@@ -0,0 +1,130 @@
+# Kotori: 固定版の公開辞書を検査し、検索用の静的配列と再配布データを作る。
+# 生成物はCC BY-SA 3.0。プログラム自体はMozcと同じBSDライセンス。
+import argparse
+import collections
+import hashlib
+import json
+from pathlib import Path
+import re
+import unicodedata
+
+COMMIT = "7d241dafcf6ee1f9eafefc0ae7a929c095860246"
+SOURCE_URL = "https://github.com/KEINOS/google-ime-user-dictionary-ja-en"
+# 以前の24表記は優先順と製品の正式表記を維持する。
+PREFERRED = {
+    "インデックス": "index", "エフェクト": "effect", "インターネット": "internet",
+    "アイフォン": "iPhone", "アイフォーン": "iPhone", "コンピューター": "computer",
+    "コンピュータ": "computer", "ソフトウェア": "software", "ハードウェア": "hardware",
+    "アプリ": "app", "アプリケーション": "application", "ブラウザー": "browser",
+    "ブラウザ": "browser", "サーバー": "server", "サーバ": "server", "ユーザー": "user",
+    "ユーザ": "user", "データ": "data", "ファイル": "file", "フォルダ": "folder",
+    "キーボード": "keyboard", "マウス": "mouse", "ディスプレイ": "display", "スクリーン": "screen",
+    "プログラミング": "programming", "アクセシビリティ": "accessibility",
+    "キャッシュ": "cache", "ヒップ": "hip",
+}
+
+
+def katakana(reading):
+    return "".join(chr(ord(c) + 0x60) if "ぁ" <= c <= "ゖ" else c for c in reading)
+
+
+def build(paths):
+    entries = collections.defaultdict(list)
+    rejected = collections.Counter()
+    sources = []
+    raw_rows = 0
+    for path in paths:
+        data = Path(path).read_bytes()
+        sources.append({"sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)})
+        for line in data.decode("utf-8-sig").splitlines():
+            raw_rows += 1
+            columns = line.split("\t")
+            if len(columns) not in (3, 4):
+                rejected["columns"] += 1
+                continue
+            reading, word = [unicodedata.normalize("NFKC", c).strip() for c in columns[:2]]
+            if reading.startswith("@"):
+                reading = reading[1:]
+            key = katakana(reading)
+            if not re.fullmatch("[ァ-ヺー・]+", key) or len(key) < 3:
+                rejected["reading"] += 1
+                continue
+            if len(columns) == 4 and key != unicodedata.normalize("NFKC", columns[3]).strip():
+                rejected["reading_annotation_mismatch"] += 1
+                continue
+            # 英語の説明文は候補に出さず、単語・短い複合語だけを採用する。
+            word = word.split("(", 1)[0].strip()
+            if (not re.fullmatch(r"[A-Za-z](?:[A-Za-z0-9 .'-]*[A-Za-z0-9.])?", word)
+                    or len(word) > 80 or len(word.split()) > 5):
+                rejected["english_text"] += 1
+                continue
+            if word not in entries[key]:
+                entries[key].append(word)
+    for key, preferred in PREFERRED.items():
+        entries[key] = [preferred] + [v for v in entries[key] if v != preferred]
+    # 同音異綴りは保持。1つの候補の展開は4件までとし一覧の増大を抑える。
+    all_pairs = sum(len(values) for values in entries.values())
+    rows = [(key, word) for key in sorted(entries) for word in entries[key][:4]]
+    metadata = {"source": SOURCE_URL, "source_commit": COMMIT,
+                "license": "CC-BY-SA-3.0", "input_files": sources,
+                "raw_rows": raw_rows, "readings": len(entries), "pairs": len(rows),
+                "pairs_before_per_reading_limit": all_pairs, "rejected": dict(rejected),
+                "max_variants_per_reading": 4,
+                "adaptations": ["NFKC and hiragana to katakana normalization", "reading/annotation validation",
+                                "English explanatory suffix removal", "invalid row filtering and deduplication",
+                                "preferred spelling overrides", "at most 4 variants per reading"]}
+    return rows, metadata
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--input", action="append", required=True)
+    ap.add_argument("--header", required=True)
+    ap.add_argument("--tsv", required=True)
+    ap.add_argument("--metadata", required=True)
+    ap.add_argument("--notice", required=True)
+    args = ap.parse_args()
+    rows, metadata = build(args.input)
+    if len(args.input) != 6 or metadata["raw_rows"] != 46001 or metadata["readings"] < 30000:
+        raise ValueError("Pinned upstream dictionary is incomplete: " + json.dumps(metadata))
+    header = ["// Generated from KEINOS/google-ime-user-dictionary-ja-en; CC BY-SA 3.0.",
+              "// Attribution, adaptations and license: NOTICE-katakana-english.txt.",
+              "constexpr KatakanaEnglishEntry kKatakanaEnglishEntries[] = {"]
+    header += ["  {" + json.dumps(key, ensure_ascii=False) + ", " + json.dumps(word) + "}," for key, word in rows]
+    header += ["};", ""]
+    tsv = "# Kotori adaptation; CC BY-SA 3.0; see NOTICE-katakana-english.txt\n"
+    tsv += "".join(key + "\t" + word + "\n" for key, word in rows)
+    metadata["data_sha256"] = hashlib.sha256(tsv.encode("utf-8")).hexdigest()
+    notice = f"""Kotoriカタカナ英語辞書 / Kotori Katakana English Dictionary
+
+出典: Google IME カタカナ語英字辞典コミュニティ、KEINOSと各寄稿者
+{SOURCE_URL}
+固定版: {COMMIT}
+原典としてEDICTを使用することが上流READMEに記載されています。
+EDICT: Jim Breen / Electronic Dictionary Research and Development Group
+https://www.edrdg.org/edrdg/licence.html
+
+辞書データのライセンス: Creative Commons Attribution-ShareAlike 3.0 Unported
+https://creativecommons.org/licenses/by-sa/3.0/
+https://creativecommons.org/licenses/by-sa/3.0/legalcode
+
+Kotoriでは文字種正規化、読みの検査、英語の説明部分の除去、不正行の除外、
+重複除去、優先表記の補完、同じ読みに最大4表記という変更を加えました。
+変更済みデータKotoriEnglish.tsvとそのC++配列もCC BY-SA 3.0で提供します。
+読み数: {metadata['readings']} / 読みと表記の組数: {metadata['pairs']}
+元データ取得先とSHA-256はMozcパッチのMODULE.bazel、加工手順は
+rewriter/gen_kotori_english_dictionary.pyにあります。
+https://github.com/aruiki/Asteria-Japanese-IME/tree/codex/complete-user-improvements/mozc
+
+上流の免責を含め、辞書の正確性や特定目的での利用は保証されません。
+読みが同じでも文脈により英語表記が異なる場合があります。
+"""
+    for name, text in [(args.header, "\n".join(header)), (args.tsv, tsv),
+                       (args.metadata, json.dumps(metadata, ensure_ascii=False, indent=2) + "\n"),
+                       (args.notice, notice)]:
+        Path(name).write_text(text, encoding="utf-8", newline="\n")
+    print(json.dumps({k: metadata[k] for k in ["raw_rows", "readings", "pairs", "data_sha256"]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/rewriter/kotori_model_identity.cc b/src/rewriter/kotori_model_identity.cc
new file mode 100644
index 000000000..4ca262269
--- /dev/null
+++ b/src/rewriter/kotori_model_identity.cc
@@ -0,0 +1,81 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#include "rewriter/kotori_model_identity.h"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <bcrypt.h>
+#endif  // _WIN32
+
+namespace mozc {
+#ifdef _WIN32
+namespace {
+struct HashHandles {
+  BCRYPT_ALG_HANDLE algorithm = nullptr;
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  ~HashHandles() {
+    if (hash != nullptr) BCryptDestroyHash(hash);
+    if (algorithm != nullptr) BCryptCloseAlgorithmProvider(algorithm, 0);
+  }
+};
+}  // namespace
+#endif  // _WIN32
+
+std::unique_ptr<KotoriModelIdentity> KotoriModelIdentity::Open(
+    const std::string& path) {
+#ifdef _WIN32
+  if (path.empty() || path.find('\0') != std::string::npos) return nullptr;
+  const int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                                         path.data(), path.size(), nullptr, 0);
+  if (length <= 0) return nullptr;
+  std::wstring wide(length, L'\0');
+  if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path.data(),
+                         path.size(), wide.data(), length) != length) {
+    return nullptr;
+  }
+  const HANDLE file = CreateFileW(wide.c_str(), GENERIC_READ, FILE_SHARE_READ,
+      nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN,
+      nullptr);
+  if (file == INVALID_HANDLE_VALUE) return nullptr;
+  auto identity = std::unique_ptr<KotoriModelIdentity>(new KotoriModelIdentity());
+  identity->file_ = file;
+  HashHandles handles;
+  if (BCryptOpenAlgorithmProvider(&handles.algorithm, BCRYPT_SHA256_ALGORITHM,
+                                   nullptr, 0) < 0 ||
+      BCryptCreateHash(handles.algorithm, &handles.hash, nullptr, 0,
+                         nullptr, 0, 0) < 0) return nullptr;
+  std::vector<unsigned char> buffer(1024 * 1024);
+  DWORD count = 0;
+  for (;;) {
+    if (!ReadFile(file, buffer.data(), buffer.size(), &count, nullptr)) {
+      return nullptr;
+    }
+    if (count == 0) break;
+    if (BCryptHashData(handles.hash, buffer.data(), count, 0) < 0) return nullptr;
+  }
+  std::array<unsigned char, 32> digest;
+  if (BCryptFinishHash(handles.hash, digest.data(), digest.size(), 0) < 0) {
+    return nullptr;
+  }
+  constexpr char hex[] = "0123456789abcdef";
+  identity->sha256_.reserve(64);
+  for (unsigned char byte : digest) {
+    identity->sha256_ += hex[byte >> 4];
+    identity->sha256_ += hex[byte & 15];
+  }
+  return identity;
+#else
+  return nullptr;
+#endif  // _WIN32
+}
+
+KotoriModelIdentity::~KotoriModelIdentity() {
+#ifdef _WIN32
+  if (file_ != nullptr) CloseHandle(file_);
+#endif  // _WIN32
+}
+}  // namespace mozc
diff --git a/src/rewriter/kotori_model_identity.h b/src/rewriter/kotori_model_identity.h
new file mode 100644
