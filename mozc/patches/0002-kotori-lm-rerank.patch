+// Only the correction guard's prefix/reverse lookups are needed. User dictionary
+// tokens deliberately have no reverse lookup, matching the production boundary.
+class CorrectionDictionary : public dictionary::DictionaryInterface {
+ public:
+  void Add(dictionary::Token token) { tokens_.push_back(std::move(token)); }
+
+  void LookupPrefix(absl::string_view key, Callback* callback) const override {
+    for (const dictionary::Token& token : tokens_) {
+      if (key.substr(0, token.key.size()) == token.key &&
+          callback->OnToken(token.key, token.key, token) ==
+              Callback::TRAVERSE_DONE) {
+        return;
+      }
+    }
+  }
+
+  void LookupReverse(absl::string_view text, Callback* callback) const override {
+    for (const dictionary::Token& token : tokens_) {
+      if ((token.attributes & dictionary::Token::USER_DICTIONARY) != 0 ||
+          text.substr(0, token.value.size()) != token.value) {
+        continue;
+      }
+      dictionary::Token reverse = token;
+      std::swap(reverse.key, reverse.value);
+      if (callback->OnToken(reverse.key, reverse.key, reverse) ==
+          Callback::TRAVERSE_DONE) {
+        return;
+      }
+    }
+  }
+
+ private:
+  std::vector<dictionary::Token> tokens_;
+};
