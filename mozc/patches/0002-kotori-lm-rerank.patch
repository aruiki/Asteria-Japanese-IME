+// Kotori: 入力中の候補の先頭に、Space と同じ変換の結果を置く(docs/adr/0039)。
+// 変換は別の Segments で行い、今の状態(入力中の候補)は変えない。AI は覚えておいた結果を
+// 使うので、続けて Space を押したときも同じ文が出る。
+bool EngineConverter::KotoriPreviewConversion(
+    const composer::Composer& composer, const commands::Context& context) {
+  const auto input_generation = KotoriObserveInput(composer);
+  if (state_ != SUGGESTION || segments_.conversion_segments_size() != 1) {
+    return false;
+  }
+  // Kotori: 強い続き予測を、短い通常変換で押し下げない。
+  const Segment& first = segments_.conversion_segment(0);
+  if (first.candidates_size() > 0 &&
+      first.candidate(0).kotori_confident_prediction) {
+    return true;
+  }
+  DCHECK(request_);
+  DCHECK(config_);
+  ConversionRequest::Options options;
+  options.enable_user_history_for_conversion =
+      conversion_preferences().use_history;
+  // SetRequestType は今の状態(request_type_)を変えるので使わない。
+  options.request_type = ConversionRequest::CONVERSION;
+  options.kotori_preview = true;
+  const ConversionRequest conversion_request =
+      ConversionRequestBuilder()
+          .SetKotoriInputGeneration(input_generation)
+          .SetComposer(composer)
+          .SetRequestView(*request_)
+          .SetContextView(context)
+          .SetConfigView(*config_)
+          .SetOptions(std::move(options))
+          .Build();
+  Segments converted = segments_;  // 前の文(履歴の文節)は残す
+  converted.clear_conversion_segments();
+  if (!converter_->StartConversion(conversion_request, &converted)) {
+    return false;
+  }
+  std::string key, value;
+  for (const Segment& seg : converted.conversion_segments()) {
+    if (seg.candidates_size() == 0) return false;
+    if (!seg.candidate(0).kotori_ai_evaluated) return false;
+    key += seg.key();
+    value += seg.candidate(0).value;
+  }
+  Segment* suggestion = segments_.mutable_conversion_segment(0);
+  if (value.empty() || key != suggestion->key()) return false;
+  for (size_t i = 0; i < suggestion->candidates_size(); ++i) {
+    if (suggestion->candidate(i).value != value) continue;
+    if (i == 0) return true;  // 評価済みで、もう先頭にある
+    suggestion->erase_candidate(i);
+    break;
+  }
+  converter::Candidate candidate;
+  if (suggestion->candidates_size() > 0) candidate = suggestion->candidate(0);
+  candidate.key = key;
+  candidate.content_key = key;
+  candidate.value = value;
+  candidate.content_value = value;
+  candidate.consumed_key_size = Util::CharsLen(key);
+  candidate.inner_segment_boundary.clear();
+  candidate.prefix.clear();
+  candidate.suffix.clear();
+  candidate.description.clear();
+  candidate.attributes = 0;
+  candidate.kotori_confident_prediction = false;
+  candidate.kotori_ai_evaluated = true;
+  *suggestion->insert_candidate(0) = std::move(candidate);
+  previous_suggestions_ = *suggestion;
+  UpdateCandidateList();
+  InitializeSelectedCandidateIndices();
+  return true;
+}
