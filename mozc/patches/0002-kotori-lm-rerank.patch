+  EXPECT_FALSE(KotoriConfigTestPeer::Serialize(dialog).kotori_lm_correction());
+  correction->click();
+  EXPECT_TRUE(KotoriConfigTestPeer::Serialize(dialog).kotori_lm_correction());
