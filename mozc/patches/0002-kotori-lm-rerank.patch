+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#ifndef MOZC_REWRITER_KOTORI_NUANCE_REWRITER_H_
+#define MOZC_REWRITER_KOTORI_NUANCE_REWRITER_H_
+#include "rewriter/rewriter_interface.h"
+namespace mozc {
+// Kotori: 明示的な変換で、同音語の意味の違いを文全体の別候補にする。
+// 最初の変換は変えず、先頭語の表記違いより前に選べるようにする。
+class KotoriNuanceRewriter : public RewriterInterface {
+ public:
+  bool Rewrite(const ConversionRequest& request, Segments* segments) const override;
+};
+}  // namespace mozc
+#endif  // MOZC_REWRITER_KOTORI_NUANCE_REWRITER_H_
diff --git a/src/rewriter/kotori_nuance_rewriter_test.cc b/src/rewriter/kotori_nuance_rewriter_test.cc
new file mode 100644
index 000000000..dc7e7466c
--- /dev/null
+++ b/src/rewriter/kotori_nuance_rewriter_test.cc
@@ -0,0 +1,187 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#include "rewriter/kotori_nuance_rewriter.h"
+#include "converter/attribute.h"
+#include "converter/segments.h"
+#include "protocol/commands.pb.h"
+#include "request/conversion_request.h"
+#include "testing/gunit.h"
+namespace mozc {
+namespace {
+void Add(Segments& segments, const char* key, const char* value) {
+  Segment* segment = segments.add_segment();
+  segment->set_key(key);
+  auto* candidate = segment->add_candidate();
+  candidate->key = candidate->content_key = key;
+  candidate->value = candidate->content_value = value;
+}
+ConversionRequest Conversion() {
+  return ConversionRequestBuilder().SetRequestType(ConversionRequest::CONVERSION).Build();
+}
+TEST(KotoriNuanceRewriterTest, PreservesSentenceAndPutsMeaningBeforeSpelling) {
+  Segments segments;
+  Add(segments, "わたしは", "私は");
+  Add(segments, "そのとくちょうは", "その特徴は");
+  Add(segments, "ちゃいろいってことだ", "茶色いってことだ");
+  auto* spelling = segments.mutable_conversion_segment(0)->add_candidate();
+  spelling->key = "わたしは";
+  spelling->value = "わたしは";
+  KotoriNuanceRewriter rewriter;
+  EXPECT_TRUE(rewriter.Rewrite(Conversion(), &segments));
+  const auto& head = segments.conversion_segment(0);
+  EXPECT_EQ(head.candidate(0).value, "私は");
+  ASSERT_EQ(head.candidates_size(), 3);
+  EXPECT_EQ(head.candidate(1).value, "私はその特長は茶色いってことだ");
+  EXPECT_EQ(head.candidate(1).key, "わたしはそのとくちょうはちゃいろいってことだ");
+  EXPECT_EQ(head.candidate(1).converted_segment_count, 3);
+  EXPECT_TRUE(head.candidate(1).kotori_nuance_alternative);
+  EXPECT_FALSE(head.candidate(1).kotori_ai_evaluated);
+  EXPECT_NE(head.candidate(1).description.find("良いところ"), std::string::npos);
+  EXPECT_TRUE(head.candidate(1).attributes & converter::Attribute::NO_LEARNING);
+  EXPECT_EQ(head.candidate(2).value, "わたしは");
+  EXPECT_EQ(segments.conversion_segment(1).candidate(0).value, "その特徴は");
+  EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+  EXPECT_EQ(head.candidates_size(), 3);
+}
+TEST(KotoriNuanceRewriterTest, ReplacesOneOccurrenceAtATime) {
+  Segments segments;
+  Add(segments, "とくちょうととくちょう", "特徴と特徴");
+  KotoriNuanceRewriter rewriter;
+  ASSERT_TRUE(rewriter.Rewrite(Conversion(), &segments));
+  const auto& head = segments.conversion_segment(0);
+  ASSERT_EQ(head.candidates_size(), 3);
+  EXPECT_EQ(head.candidate(1).value, "特長と特徴");
+  EXPECT_EQ(head.candidate(2).value, "特徴と特長");
+}
+TEST(KotoriNuanceRewriterTest, SkipsPredictionAndProtectedRequests) {
+  KotoriNuanceRewriter rewriter;
+  for (auto type : {ConversionRequest::PREDICTION, ConversionRequest::SUGGESTION}) {
+    Segments segments; Add(segments, "とくちょう", "特徴");
+    EXPECT_FALSE(rewriter.Rewrite(ConversionRequestBuilder().SetRequestType(type).Build(), &segments));
+  }
+  Segments segments; Add(segments, "とくちょう", "特徴");
+  commands::Context context; context.set_input_field_type(commands::Context::PASSWORD);
+  auto request = ConversionRequestBuilder().SetRequestType(ConversionRequest::CONVERSION).SetContext(context).Build();
+  EXPECT_FALSE(rewriter.Rewrite(request, &segments));
+  ConversionRequest::Options options; options.incognito_mode = true;
+  const auto incognito = ConversionRequestBuilder().SetRequestType(ConversionRequest::CONVERSION).SetOptions(options).Build();
+  EXPECT_FALSE(rewriter.Rewrite(incognito, &segments));
+}
+TEST(KotoriNuanceRewriterTest, LeavesFixedAndUserWordsAlone) {
+  KotoriNuanceRewriter rewriter;
+  for (auto attribute : {converter::Attribute::USER_DICTIONARY, converter::Attribute::NO_MODIFICATION, converter::Attribute::COMMAND_CANDIDATE}) {
+    Segments segments; Add(segments, "とくちょう", "特徴");
+    segments.mutable_conversion_segment(0)->mutable_candidate(0)->attributes |= attribute;
+    EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+  }
+  for (auto type : {Segment::FIXED_VALUE}) {
+    Segments segments; Add(segments, "とくちょう", "特徴");
+    segments.mutable_conversion_segment(0)->set_segment_type(type);
+    EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+  }
+}
+TEST(KotoriNuanceRewriterTest, PreservesAiResizedBoundariesWhileOfferingNuance) {
+  Segments segments;
+  const char* keys[] = {"わたしは", "はやしの", "なかで", "かぶとむしを",
+      "みつけたがなんといってもその", "とくちょうは", "ちゃいろいってことだ"};
+  const char* values[] = {"私は", "林の", "中で", "カブトムシを",
+      "見つけたがなんといってもその", "特徴は", "茶色いってことだ"};
+  for (int i = 0; i < 7; ++i) {
+    Add(segments, keys[i], values[i]);
+    segments.mutable_conversion_segment(i)->set_segment_type(Segment::FIXED_BOUNDARY);
+  }
+  KotoriNuanceRewriter rewriter;
+  ASSERT_TRUE(rewriter.Rewrite(Conversion(), &segments));
+  ASSERT_EQ(segments.conversion_segments_size(), 7);
+  const auto& alternative = segments.conversion_segment(0).candidate(1);
+  EXPECT_EQ(alternative.value,
+      "私は林の中でカブトムシを見つけたがなんといってもその特長は茶色いってことだ");
+  EXPECT_EQ(alternative.converted_segment_count, 7);
+  EXPECT_TRUE(alternative.kotori_nuance_alternative);
+  for (int i = 0; i < 7; ++i) {
+    const auto& segment = segments.conversion_segment(i);
+    EXPECT_EQ(segment.key(), keys[i]);
+    EXPECT_EQ(segment.candidate(0).value, values[i]);
+    EXPECT_EQ(segment.segment_type(), Segment::FIXED_BOUNDARY);
+  }
+}
+TEST(KotoriNuanceRewriterTest, DoesNotPromoteUnrelatedHomophones) {
+  // 同音・複数の漢字でも、文脈上の言い換えとは限らない。
+  // 候補は消さず、優先する全文候補へ昇格させない。
+  for (auto replacement : {"慰謝に", "異車に", "慰藉に"}) {
+    for (auto type : {Segment::FREE, Segment::FIXED_BOUNDARY}) {
+      Segments segments;
+      Add(segments, "あしを", "足を");
+      Add(segments, "いためてしまったため", "痛めてしまったため");
+      Add(segments, "きょうは", "今日は");
+      Add(segments, "いしゃに", "医者に");
+      Add(segments, "いこう", "行こう");
+      auto* doctor = segments.mutable_conversion_segment(3);
+      doctor->set_segment_type(type);
+      auto* candidate = doctor->add_candidate();
+      candidate->key = "いしゃに";
+      candidate->value = replacement;
+      KotoriNuanceRewriter rewriter;
+      EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+      EXPECT_EQ(segments.conversion_segment(0).candidates_size(), 1);
+      EXPECT_EQ(doctor->candidate(0).value, "医者に");
+      EXPECT_EQ(doctor->candidate(1).value, replacement);
+      EXPECT_FALSE(doctor->candidate(1).kotori_nuance_alternative);
+    }
+  }
+  Segments segments;
+  Add(segments, "わたしは", "私は");
+  Add(segments, "こうしょうを", "交渉を");
+  Add(segments, "つづける", "続ける");
+  auto* candidate = segments.mutable_conversion_segment(1)->add_candidate();
+  candidate->key = "こうしょうを";
+  candidate->value = "考証を";
+  KotoriNuanceRewriter rewriter;
+  EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+  EXPECT_EQ(segments.conversion_segment(0).candidates_size(), 1);
+  EXPECT_EQ(segments.conversion_segment(1).candidate(1).value, "考証を");
+}
+TEST(KotoriNuanceRewriterTest, KeepsKnownAlternativeCoveringAdjacentSegments) {
+  Segments segments;
+  Add(segments, "ほしょう", "保証");
+  Add(segments, "を", "を");
+  Add(segments, "おこなう", "行う");
+  auto* candidate = segments.mutable_conversion_segment(0)->add_candidate();
+  candidate->key = "ほしょうを";
+  candidate->value = "保障を";
+  candidate->content_value = "保障";
+  candidate->converted_segment_count = 2;
+  KotoriNuanceRewriter rewriter;
+  ASSERT_TRUE(rewriter.Rewrite(Conversion(), &segments));
+  const auto& head = segments.conversion_segment(0);
+  EXPECT_EQ(head.candidate(1).value, "保障を行う");
+  EXPECT_EQ(head.candidate(1).converted_segment_count, 3);
+  EXPECT_TRUE(head.candidate(1).kotori_nuance_alternative);
+  EXPECT_EQ(head.candidate(3).value, "保障を");
+  EXPECT_EQ(head.candidate(3).converted_segment_count, 2);
+}
+TEST(KotoriNuanceRewriterTest, DoesNotPromoteNumbersOrChangedParticles) {
+  for (auto replacement : {"重視", "十字", "十時に"}) {
+    Segments segments; Add(segments, "じゅうじ", "十時");
+    auto* candidate = segments.mutable_conversion_segment(0)->add_candidate();
+    candidate->key = "じゅうじ"; candidate->value = replacement;
+    KotoriNuanceRewriter rewriter;
+    EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+  }
+  Segments segments; Add(segments, "こうしょうを", "交渉を");
+  segments.mutable_conversion_segment(0)->mutable_candidate(0)->content_value = "交渉";
+  auto* candidate = segments.mutable_conversion_segment(0)->add_candidate();
+  candidate->key = "こうしょうを"; candidate->value = "考証に";
+  KotoriNuanceRewriter rewriter;
+  EXPECT_FALSE(rewriter.Rewrite(Conversion(), &segments));
+}
+
+TEST(KotoriNuanceRewriterTest, UnrelatedSentenceAndBoundedChoices) {
+  KotoriNuanceRewriter rewriter;
+  Segments unrelated; Add(unrelated, "わたしはねこがすきです", "私は猫が好きです");
+  EXPECT_FALSE(rewriter.Rewrite(Conversion(), &unrelated));
+  Segments many; Add(many, "とくちょう", "特徴特徴特徴特徴特徴特徴特徴特徴");
+  ASSERT_TRUE(rewriter.Rewrite(Conversion(), &many));
+  EXPECT_EQ(many.conversion_segment(0).candidates_size(), 7);
+}
+}  // namespace
+}  // namespace mozc
diff --git a/src/rewriter/llama_runtime.cc b/src/rewriter/llama_runtime.cc
new file mode 100644
index 000000000..27b0aafdc
--- /dev/null
+++ b/src/rewriter/llama_runtime.cc
@@ -0,0 +1,311 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/llama_runtime.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include "llama.h"
+
+#ifdef _WIN32
+#include <windows.h>
+
+#include "ggml-backend.h"
+#endif  // _WIN32
+
+namespace mozc {
+namespace {
+
+void QuietLog(ggml_log_level, const char*, void*) {}
+
+constexpr size_t kMinGpuMemory = size_t{3} << 30;  // 3 GiB
+
+// 機器の一覧から AI を載せる GPU を選ぶ(LlamaGpuDevice)。関数は Windows では DLL から引いた
+// もの、それ以外は静的にリンクしたもの。
+template <typename Count, typename Get, typename Type, typename Memory>
+ggml_backend_dev_t SelectGpu(Count count, Get get, Type type, Memory memory) {
+  const char* env = std::getenv("KOTORI_LM_DEVICE");
+  if (env != nullptr && std::strcmp(env, "cpu") == 0) return nullptr;
+  ggml_backend_dev_t best = nullptr;
+  size_t best_total = 0;
+  for (size_t i = 0; i < count(); ++i) {
+    ggml_backend_dev_t dev = get(i);
+    if (type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) continue;
+    size_t free = 0, total = 0;
+    memory(dev, &free, &total);
+    if (total >= kMinGpuMemory && total > best_total) {
+      best = dev;
+      best_total = total;
+    }
+  }
+  return best;
+}
+
+}  // namespace
+
+#ifndef _WIN32
+
+bool EnsureLlamaRuntime(const std::string& dir) {
+  static const bool ok = [] {
+    llama_log_set(QuietLog, nullptr);
+    llama_backend_init();
+    return true;
+  }();
+  return ok;
+}
+
+ggml_backend_dev_t LlamaGpuDevice() {
+  static ggml_backend_dev_t dev =
+      SelectGpu(ggml_backend_dev_count, ggml_backend_dev_get, ggml_backend_dev_type,
+                ggml_backend_dev_memory);
+  return dev;
+}
+
+bool LlamaHasGpu() { return LlamaGpuDevice() != nullptr; }
+
+std::string LlamaGpuName() {
+  ggml_backend_dev_t dev = LlamaGpuDevice();
+  return dev != nullptr ? ggml_backend_dev_description(dev) : std::string();
+}
+
+#else  // _WIN32
+
+// llama.dll と ggml.dll の関数を実行時に引く。インポートライブラリを使わないので、
+// DLL がなくても mozc_server は起動でき、そのときは AI なしで変換する。
+namespace {
+
+#define KOTORI_LLAMA_FUNCTIONS(X)                                              \
+  X(llama_log_set)                                                             \
+  X(llama_backend_init)                                                        \
+  X(llama_model_default_params)                                                \
+  X(llama_model_load_from_file)                                                \
+  X(llama_model_free)                                                          \
+  X(llama_context_default_params)                                              \
+  X(llama_init_from_model)                                                     \
+  X(llama_free)                                                                \
+  X(llama_model_get_vocab)                                                     \
+  X(llama_vocab_n_tokens)                                                      \
+  X(llama_vocab_eos)                                                           \
+  X(llama_vocab_bos)                                                           \
+  X(llama_vocab_get_add_bos)                                                   \
+  X(llama_tokenize)                                                            \
+  X(llama_get_memory)                                                          \
+  X(llama_memory_clear)                                                        \
+  X(llama_memory_seq_cp)                                                       \
+  X(llama_memory_seq_rm)                                                       \
+  X(llama_token_to_piece)                                                      \
+  X(llama_vocab_is_eog)                                                        \
+  X(llama_batch_init)                                                          \
+  X(llama_batch_free)                                                          \
+  X(llama_decode)                                                              \
+  X(llama_synchronize)                                                         \
+  X(llama_get_logits_ith)                                                      \
+  X(llama_supports_gpu_offload)
+
+struct Api {
+#define KOTORI_DECLARE(name) decltype(&::name) name = nullptr;
+  KOTORI_LLAMA_FUNCTIONS(KOTORI_DECLARE)
+#undef KOTORI_DECLARE
+  // Kotori: 生成補正だけで使う任意の API。ない DLL でも既存の採点を維持する。
+  decltype(&::llama_model_chat_template) llama_model_chat_template = nullptr;
+  decltype(&::llama_chat_apply_template) llama_chat_apply_template = nullptr;
+  decltype(&::ggml_backend_load_all_from_path) load_all = nullptr;
+  // 機器の一覧(ggml.dll)と、機器の種類・メモリ(ggml-base.dll)。
+  decltype(&::ggml_backend_dev_count) dev_count = nullptr;
+  decltype(&::ggml_backend_dev_get) dev_get = nullptr;
+  decltype(&::ggml_backend_dev_type) dev_type = nullptr;
+  decltype(&::ggml_backend_dev_memory) dev_memory = nullptr;
+  decltype(&::ggml_backend_dev_description) dev_description = nullptr;
+};
+
+Api g_api;
+bool g_loaded = false;
+
+std::wstring Widen(const std::string& s) {
+  if (s.empty()) return std::wstring();
+  const int n = MultiByteToWideChar(CP_UTF8, 0, s.data(),
+                                    static_cast<int>(s.size()), nullptr, 0);
+  std::wstring w(n, L'\0');
+  MultiByteToWideChar(CP_UTF8, 0, s.data(), static_cast<int>(s.size()),
+                      w.data(), n);
+  return w;
+}
+
+bool Load(const std::string& dir) {
+  const std::wstring wdir = Widen(dir);
+  // 同梱の DLL だけを探す(カレントディレクトリや PATH の DLL を読まない)。
+  constexpr DWORD kFlags =
+      LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32;
+  HMODULE ggml = LoadLibraryExW((wdir + L"\\ggml.dll").c_str(), nullptr, kFlags);
+  HMODULE llama =
+      LoadLibraryExW((wdir + L"\\llama.dll").c_str(), nullptr, kFlags);
+  if (ggml == nullptr || llama == nullptr) return false;
+#define KOTORI_RESOLVE(name)                                              \
+  g_api.name = reinterpret_cast<decltype(g_api.name)>(                    \
+      GetProcAddress(llama, #name));                                      \
+  if (g_api.name == nullptr) return false;
+  KOTORI_LLAMA_FUNCTIONS(KOTORI_RESOLVE)
+#undef KOTORI_RESOLVE
+  g_api.llama_model_chat_template =
+      reinterpret_cast<decltype(g_api.llama_model_chat_template)>(
+          GetProcAddress(llama, "llama_model_chat_template"));
+  g_api.llama_chat_apply_template =
+      reinterpret_cast<decltype(g_api.llama_chat_apply_template)>(
+          GetProcAddress(llama, "llama_chat_apply_template"));
+  g_api.load_all = reinterpret_cast<decltype(g_api.load_all)>(
+      GetProcAddress(ggml, "ggml_backend_load_all_from_path"));
+  if (g_api.load_all == nullptr) return false;
+  HMODULE base =
+      LoadLibraryExW((wdir + L"\\ggml-base.dll").c_str(), nullptr, kFlags);
+  if (base == nullptr) return false;
+  g_api.dev_count = reinterpret_cast<decltype(g_api.dev_count)>(
+      GetProcAddress(ggml, "ggml_backend_dev_count"));
+  g_api.dev_get = reinterpret_cast<decltype(g_api.dev_get)>(
+      GetProcAddress(ggml, "ggml_backend_dev_get"));
+  g_api.dev_type = reinterpret_cast<decltype(g_api.dev_type)>(
+      GetProcAddress(base, "ggml_backend_dev_type"));
+  g_api.dev_memory = reinterpret_cast<decltype(g_api.dev_memory)>(
+      GetProcAddress(base, "ggml_backend_dev_memory"));
+  g_api.dev_description = reinterpret_cast<decltype(g_api.dev_description)>(
+      GetProcAddress(base, "ggml_backend_dev_description"));
+  if (g_api.dev_count == nullptr || g_api.dev_get == nullptr ||
+      g_api.dev_type == nullptr || g_api.dev_memory == nullptr ||
+      g_api.dev_description == nullptr) {
+    return false;
+  }
+  g_api.llama_log_set(QuietLog, nullptr);
+  // GPU(Vulkan)と CPU の DLL のうち、この PC で使えるものを読み込む。
+  g_api.load_all(dir.c_str());
+  g_api.llama_backend_init();
+  return true;
+}
+
+}  // namespace
+
+bool EnsureLlamaRuntime(const std::string& dir) {
+  static const bool ok = [&dir] {
+    g_loaded = Load(dir);
+    return g_loaded;
+  }();
+  return ok;
+}
+
+ggml_backend_dev_t LlamaGpuDevice() {
+  if (!g_loaded) return nullptr;
+  static ggml_backend_dev_t dev = SelectGpu(g_api.dev_count, g_api.dev_get,
+                                            g_api.dev_type, g_api.dev_memory);
+  return dev;
+}
+
+bool LlamaHasGpu() { return LlamaGpuDevice() != nullptr; }
+
+std::string LlamaGpuName() {
+  ggml_backend_dev_t dev = LlamaGpuDevice();
+  return dev != nullptr ? g_api.dev_description(dev) : std::string();
+}
+
+#endif  // _WIN32
+
+}  // namespace mozc
+
+#ifdef _WIN32
+// zenz_scorer.cc などが呼ぶ llama.cpp の関数。読み込んだ DLL の関数へ渡す。
+// EnsureLlamaRuntime が true を返した後にだけ呼ばれる。
+using mozc::g_api;
+extern "C" {
+void llama_log_set(ggml_log_callback cb, void* data) {
+  g_api.llama_log_set(cb, data);
+}
+void llama_backend_init(void) { g_api.llama_backend_init(); }
+llama_model_params llama_model_default_params(void) {
+  return g_api.llama_model_default_params();
+}
+llama_model* llama_model_load_from_file(const char* path,
+                                        llama_model_params params) {
+  return g_api.llama_model_load_from_file(path, params);
+}
+void llama_model_free(llama_model* model) { g_api.llama_model_free(model); }
+llama_context_params llama_context_default_params(void) {
+  return g_api.llama_context_default_params();
+}
+llama_context* llama_init_from_model(llama_model* model,
+                                     llama_context_params params) {
+  return g_api.llama_init_from_model(model, params);
+}
+void llama_free(llama_context* ctx) { g_api.llama_free(ctx); }
+const llama_vocab* llama_model_get_vocab(const llama_model* model) {
+  return g_api.llama_model_get_vocab(model);
+}
+const char* llama_model_chat_template(const llama_model* model, const char* name) {
+  return g_api.llama_model_chat_template != nullptr
+             ? g_api.llama_model_chat_template(model, name)
+             : nullptr;
+}
+int32_t llama_chat_apply_template(const char* tmpl,
+                                  const llama_chat_message* chat, size_t n_msg,
+                                  bool add_ass, char* buf, int32_t length) {
+  return g_api.llama_chat_apply_template != nullptr
