+// Kotori: この PC の GPU の名前と VRAM を 1 行で(設定画面に出す)。DXGI で調べ、
+// ソフトウェアの描画(Microsoft Basic Render Driver)は除く。
+std::string KotoriGpuSummary() {
+#ifdef _WIN32
+  using CreateFactory = HRESULT(WINAPI *)(REFIID, void **);
+  HMODULE dxgi = ::LoadLibraryExW(L"dxgi.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (dxgi != nullptr) {
+    auto create = reinterpret_cast<CreateFactory>(
+        ::GetProcAddress(dxgi, "CreateDXGIFactory1"));
+    IDXGIFactory1 *factory = nullptr;
+    std::wstring best_name;
+    SIZE_T best_vram = 0;
+    if (create != nullptr &&
+        SUCCEEDED(create(__uuidof(IDXGIFactory1),
+                         reinterpret_cast<void **>(&factory)))) {
+      IDXGIAdapter1 *adapter = nullptr;
+      for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND;
+           ++i) {
+        DXGI_ADAPTER_DESC1 desc = {};
+        if (SUCCEEDED(adapter->GetDesc1(&desc)) &&
+            !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) &&
+            desc.DedicatedVideoMemory > best_vram) {
+          best_vram = desc.DedicatedVideoMemory;
+          best_name = desc.Description;
+        }
+        adapter->Release();
+      }
+      factory->Release();
+    }
+    ::FreeLibrary(dxgi);
+    if (!best_name.empty()) {
+      const double gb = static_cast<double>(best_vram) / (1024.0 * 1024 * 1024);
+      const QString name = QString::fromWCharArray(best_name.c_str());
+      QString text;
+      // AI を載せるのは専用 GPU で VRAM が 3 GB 以上のときだけ(rewriter/llama_runtime.h)。
+      // 内蔵 GPU(専用の VRAM が少ない)では、どの品質を選んでも Low で動く。
+      if (gb >= 3.0) {
+        text = QString::fromUtf8("この PC の GPU: %1(VRAM %2 GB)。Standard 以上を使えます。")
+                   .arg(name)
+                   .arg(gb, 0, 'f', 0);
+      } else {
+        text = QString::fromUtf8(
+                   "この PC の GPU: %1(VRAM %2 GB)。AI には使わず、どの品質を選んでも "
+                   "Low(CPU)で動きます。")
+                   .arg(name)
+                   .arg(gb, 0, 'f', 1);
+      }
+      return text.toUtf8().toStdString();
+    }
+  }
+#endif  // _WIN32
+  return "AI に使える GPU が見つかりません。どの品質を選んでも Low(CPU)で動きます。";
+}
+
+// Kotori: 実際に動いている AI の状態(変換サーバーがユーザーのプロファイルの
+// kotori_ai_status.txt に書く。rewriter/lm_rewriter.cc の WriteStatus、docs/adr/0026)。
+using KotoriStatus = std::map<std::string, std::string>;
+constexpr char kKotoriSupportUrl[] =
+    "https://buy.stripe.com/cNi14m7jRdq005f0781ZS08";
+
+KotoriStatus ReadKotoriStatus() {
+  QFile file(QString::fromUtf8(
+      FileUtil::JoinPath(SystemUtil::GetUserProfileDirectory(),
+                         "kotori_ai_status.txt")
+          .c_str()));
+  KotoriStatus status;
+  if (!file.open(QIODevice::ReadOnly) || file.size() > 8192) return status;
+  for (const QByteArray &raw : file.readAll().split('\n')) {
+    const QByteArray line = raw.trimmed();
+    const qsizetype equals = line.indexOf('=');
+    if (equals > 0)
+      status[line.left(equals).toStdString()] =
+          line.mid(equals + 1).toStdString();
+  }
+  return status;
+}
+
+std::string FormatKotoriAiStatus(KotoriStatus kv) {
+  const std::string &state = kv["state"];
+  const std::string &device = kv["device"];
+  const std::string where = device == "CPU" ? "CPU で動作" : "GPU: " + device;
+  if (state == "llm") {
+    return "AI の状態: 動いています(変換用の AI と日本語 LLM、" + where + ")。";
+  } else if (state == "zenz") {
+    return "AI の状態: 動いています(変換用の AI " + kv["zenz"] + "、" + where +
+           ")。";
+  } else if (state == "loading") {
+    return "AI の状態: モデルを読み込んでいます。";
+  } else if (state == "sleep") {
+    return "AI の状態: 休んでいます(しばらく入力がないので、GPU "
+           "のメモリを空けています。"
+           "次に入力すると読み込みます)。";
+  } else if (state == "error") {
+    return "AI の状態: 動いていません(" + kv["message"] +
+           " を読み込めません)。入れ直すと直ることがあります。";
+  } else if (state == "off") {
+    return "AI の状態: AI 変換は切れています。";
+  }
+  return "AI の状態: まだ分かりません(日本語を一度入力すると表示されます)。";
+}
