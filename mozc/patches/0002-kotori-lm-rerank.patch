diff --git a/src/gui/tool/kotori_support_reminder.cc b/src/gui/tool/kotori_support_reminder.cc
new file mode 100644
index 000000000..b8866a45c
--- /dev/null
+++ b/src/gui/tool/kotori_support_reminder.cc
@@ -0,0 +1,189 @@
+// Kotori: Windowsの通知センターに届く週次の応援案内。
+#include "gui/tool/kotori_support_reminder.h"
+#include <QApplication>
+#include <QDateTime>
+#include <QDesktopServices>
+#include <QTimer>
+#include "base/process_mutex.h"
+#include "base/system_util.h"
+#ifdef _WIN32
+#include <windows.h>
+#include <roapi.h>
+#include <windows.data.xml.dom.h>
+#include <windows.ui.notifications.h>
+#include <notificationactivationcallback.h>
+#include <wrl.h>
+#include <wrl/wrappers/corewrappers.h>
+#endif
+namespace mozc::gui {
+bool SupportReminderState::Enabled() {
+  settings_.sync();
+  return settings_.status() == QSettings::NoError && !settings_.value("disabled", false).toBool();
+}
+bool SupportReminderState::Due(qint64 now) {
+  settings_.sync();
+  return settings_.status() == QSettings::NoError && !settings_.value("disabled", false).toBool() &&
+      now >= settings_.value("next_prompt_utc", 0).toLongLong();
+}
+bool SupportReminderState::Defer(qint64 now) {
+  settings_.setValue("next_prompt_utc", now + kSupportWeekSeconds);
+  settings_.sync();
+  return settings_.status() == QSettings::NoError;
+}
+bool SupportReminderState::Disable() {
+  settings_.setValue("disabled", true);
+  settings_.sync();
+  return settings_.status() == QSettings::NoError;
+}
+bool HandleSupportAction(SupportReminderState &state, const QString &action,
+    qint64 now, const std::function<bool(const QUrl &)> &open) {
+  if (!state.Enabled()) return false;
+  if (action == QStringLiteral("later")) return state.Defer(now);
+  if (action != QStringLiteral("github")) return false;
+  const QUrl url(QStringLiteral("https://github.com/aruiki/Asteria-Japanese-IME"));
+  return open(url) && state.Disable();
+}
+QString SupportToastXml() {
+  return QStringLiteral(
+      "<toast launch='github'><visual><binding template='ToastGeneric'>"
+      "<text>Asteriaの使い心地はいかがですか？</text>"
+      "<text>気に入っていただけたら、GitHubのStarで応援をお願いします。リンクを開くと、以後このお願いは表示されません。</text>"
+      "</binding></visual><actions>"
+      "<action content='GitHubで応援する' arguments='github' activationType='foreground'/>"
+      "<action content='いいえ（1週間後に再表示）' arguments='later' activationType='foreground'/>"
+      "</actions><audio silent='true'/></toast>");
+}
+}  // namespace mozc::gui
+namespace {
+QString StatePath() {
+  return QString::fromStdString(mozc::SystemUtil::GetUserProfileDirectory()) +
+      QStringLiteral("/support-reminder.ini");
+}
+#ifdef _WIN32
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::RuntimeClass;
+using Microsoft::WRL::RuntimeClassFlags;
+using Microsoft::WRL::ClassicCom;
+using Microsoft::WRL::Wrappers::HStringReference;
+constexpr wchar_t kAumid[] = L"Aruiki.Asteria.Support";
+// Kotori: MSIのShortcutProperty/LocalServer32と一致させる。
+const CLSID kActivator = {0x378f9411, 0x77e0, 0x46bd, {0x9e, 0x01, 0xa0, 0xa1, 0x4e, 0xf9, 0x53, 0x91}};
+class Activator final : public RuntimeClass<RuntimeClassFlags<ClassicCom>, INotificationActivationCallback> {
+ public:
+  HRESULT STDMETHODCALLTYPE Activate(LPCWSTR app_id, LPCWSTR args,
+      const NOTIFICATION_USER_INPUT_DATA *, ULONG) override {
+    if (app_id == nullptr || wcscmp(app_id, kAumid) != 0 || args == nullptr) return E_INVALIDARG;
+    const QString action = QString::fromWCharArray(args);
+    if (action != QStringLiteral("github") && action != QStringLiteral("later")) return E_INVALIDARG;
+    // COMのスレッドではQtや設定ファイルを触らない。
+    QMetaObject::invokeMethod(QCoreApplication::instance(), [action] {
+      mozc::gui::SupportReminderState state(StatePath());
+      mozc::gui::HandleSupportAction(state, action, QDateTime::currentSecsSinceEpoch(), QDesktopServices::openUrl);
+      QCoreApplication::quit();
+    }, Qt::QueuedConnection);
+    return S_OK;
+  }
+};
+class Factory final : public RuntimeClass<RuntimeClassFlags<ClassicCom>, IClassFactory> {
+ public:
+  HRESULT STDMETHODCALLTYPE CreateInstance(IUnknown *outer, REFIID iid, void **result) override {
+    if (outer != nullptr) return CLASS_E_NOAGGREGATION;
+    auto object = Microsoft::WRL::Make<Activator>();
+    return object ? object->QueryInterface(iid, result) : E_OUTOFMEMORY;
+  }
+  HRESULT STDMETHODCALLTYPE LockServer(BOOL) override { return S_OK; }
+};
+HRESULT ShowSupportToast() {
+  using namespace ABI::Windows::Data::Xml::Dom;
+  using namespace ABI::Windows::UI::Notifications;
+  ComPtr<IInspectable> instance;
+  HRESULT hr = RoActivateInstance(HStringReference(RuntimeClass_Windows_Data_Xml_Dom_XmlDocument).Get(), &instance);
+  if (FAILED(hr)) return hr;
+  ComPtr<IXmlDocument> document;
+  ComPtr<IXmlDocumentIO> io;
+  if (FAILED(hr = instance.As(&document)) || FAILED(hr = instance.As(&io))) return hr;
+  const std::wstring xml = mozc::gui::SupportToastXml().toStdWString();
+  if (FAILED(hr = io->LoadXml(HStringReference(xml.c_str()).Get()))) return hr;
+  ComPtr<IToastNotificationManagerStatics> manager;
+  if (FAILED(hr = RoGetActivationFactory(HStringReference(RuntimeClass_Windows_UI_Notifications_ToastNotificationManager).Get(), IID_PPV_ARGS(&manager)))) return hr;
+  ComPtr<IToastNotifier> notifier;
+  if (FAILED(hr = manager->CreateToastNotifierWithId(HStringReference(kAumid).Get(), &notifier))) return hr;
+  NotificationSetting setting;
+  if (FAILED(hr = notifier->get_Setting(&setting))) return hr;
+  if (setting != NotificationSetting_Enabled) return S_FALSE;
+  ComPtr<IToastNotificationFactory> factory;
+  if (FAILED(hr = RoGetActivationFactory(HStringReference(RuntimeClass_Windows_UI_Notifications_ToastNotification).Get(), IID_PPV_ARGS(&factory)))) return hr;
+  ComPtr<IToastNotification> toast;
+  if (FAILED(hr = factory->CreateToastNotification(document.Get(), &toast))) return hr;
+  // 古い案内を通知センターに積み重ねない。
+  ComPtr<IToastNotification2> toast2;
+  if (FAILED(hr = toast.As(&toast2))) return hr;
+  if (FAILED(hr = toast2->put_Tag(HStringReference(L"support").Get()))) return hr;
+  if (FAILED(hr = toast2->put_Group(HStringReference(L"asteria").Get()))) return hr;
+  return notifier->Show(toast.Get());
+}
+#endif
+}  // namespace
+int RunKotoriSupportActivation(int argc, char *argv[]) {
+#ifdef _WIN32
+  QApplication app(argc, argv);
+  app.setQuitOnLastWindowClosed(false);
+  const HRESULT initialized = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
+  if (FAILED(initialized) && initialized != RPC_E_CHANGED_MODE) return 1;
+  auto factory = Microsoft::WRL::Make<Factory>();
+  DWORD cookie = 0;
+  HRESULT hr = CoRegisterClassObject(kActivator, factory.Get(), CLSCTX_LOCAL_SERVER, REGCLS_MULTIPLEUSE, &cookie);
+  int result = 1;
+  if (SUCCEEDED(hr)) {
+    // 壊れたCOM呼出しでもプロセスを残さない。
+    QTimer::singleShot(60000, &app, &QCoreApplication::quit);
+    result = app.exec();
+    CoRevokeClassObject(cookie);
+  }
+  if (SUCCEEDED(initialized)) CoUninitialize();
+  return result;
+#else
+  return 0;
+#endif
+}
+int RunKotoriSupportReminder(int argc, char *argv[]) {
+  mozc::ProcessMutex mutex("support_reminder");
+  if (!mutex.Lock()) return 0;
+  mozc::gui::SupportReminderState state(StatePath());
+  if (!state.Enabled()) return 0;
+  QApplication app(argc, argv);
+  app.setQuitOnLastWindowClosed(false);
+#ifdef _WIN32
+  const HRESULT initialized = RoInitialize(RO_INIT_SINGLETHREADED);
+  if (FAILED(initialized) && initialized != RPC_E_CHANGED_MODE) return 1;
+#endif
+  QTimer idle;
+  QObject::connect(&idle, &QTimer::timeout, &app, [&] {
+    const qint64 now = QDateTime::currentSecsSinceEpoch();
+    if (!state.Enabled()) { app.quit(); return; }
+    if (!state.Due(now)) { idle.setInterval(60 * 60 * 1000); return; }
+    idle.setInterval(5000);
+#ifdef _WIN32
+    LASTINPUTINFO input = {sizeof(LASTINPUTINFO)};
+    if (!GetLastInputInfo(&input) || GetTickCount() - input.dwTime < 15000) return;
+    HDESK desktop = OpenInputDesktop(0, FALSE, DESKTOP_READOBJECTS);
+    if (desktop == nullptr) return;
+    wchar_t name[64] = {};
+    DWORD needed = 0;
+    const bool usable = GetUserObjectInformationW(desktop, UOI_NAME, name, sizeof(name), &needed) && wcscmp(name, L"Default") == 0;
+    CloseDesktop(desktop);
+    if (!usable) return;
+    // 無応答・閉じる・クラッシュも7日以内には再通知しない。
+    if (!state.Due(now) || !state.Defer(now)) { app.quit(); return; }
+    const HRESULT hr = ShowSupportToast();
+    qInfo("Asteria support toast HRESULT=0x%08lx", static_cast<unsigned long>(hr));
+#endif
+    idle.setInterval(60 * 60 * 1000);
+  });
+  idle.start(60000);
+  const int result = app.exec();
+#ifdef _WIN32
+  if (SUCCEEDED(initialized)) RoUninitialize();
+#endif
+  return result;
+}
