+// Kotori: 補正前の読みの別候補へ戻らないよう、補正済みの読みで辞書候補を作る。
+// 入力の読みは変更せず、AI/モデル読込みを省く。元の候補も明示して残す。
+void EngineConverter::KotoriPopulateCorrectedAlternatives(
+    const ConversionRequest& request) {
+  if (!request.config().kotori_lm_enabled() || request.incognito_mode() ||
+      request.context().input_field_type() == commands::Context::PASSWORD ||
+      !request.kotori_input_generation().IsCurrent() ||
+      segments_.conversion_segments_size() != 1) return;
+  const Segment& original = segments_.conversion_segment(0);
+  if (original.candidates_size() == 0) return;
+  const converter::Candidate top = original.candidate(0);
+  const std::string typed_reading(original.key());
+  if (!top.kotori_ai_evaluated || top.kotori_corrected_reading.empty() ||
+      top.kotori_corrected_reading == typed_reading || top.key != typed_reading ||
+      typed_reading != request.key()) return;
+
+  ConversionRequest::Options options = request.options();
+  options.skip_slow_rewriters = true;
+  options.kotori_preview = false;
+  const ConversionRequest corrected_request = ConversionRequestBuilder()
+      .SetConversionRequestView(request)
+      .SetOptions(options)
+      .SetKey(top.kotori_corrected_reading)
+      .Build();
+  Segments corrected = segments_;
+  corrected.clear_conversion_segments();
+  if (!converter_->StartConversion(corrected_request, &corrected) ||
+      corrected.conversion_segments_size() == 0) return;
+  std::string corrected_key, base_value;
+  for (const Segment& segment : corrected.conversion_segments()) {
+    if (segment.candidates_size() == 0) return;
+    corrected_key += segment.key();
+    base_value += segment.candidate(0).value;
+  }
+  if (corrected_key != top.kotori_corrected_reading) return;
+  constexpr size_t kMaxAlternatives = 8;
+  std::vector<std::string> values;
+  auto add = [&](const std::string& value) {
+    if (!value.empty() && value != top.value && values.size() < kMaxAlternatives &&
+        std::find(values.begin(), values.end(), value) == values.end()) {
+      values.push_back(value);
