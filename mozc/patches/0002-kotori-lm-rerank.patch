+class LmRewriterDictionaryCorrectionTest : public ::testing::Test {
+ protected:
+  LmRewriterDictionaryCorrectionTest()
+      : pos_matcher_(data_manager_.GetPosMatcherData()) {}
+
+  dictionary::Token CommonToken(absl::string_view reading,
+                                absl::string_view surface) const {
+    const uint16_t id = pos_matcher_.GetGeneralNounId();
+    return dictionary::Token(reading, surface, 0, id, id,
+                             dictionary::Token::NONE);
+  }
+
+  CorrectionDictionary CommonDictionary() const {
+    CorrectionDictionary dictionary;
+    dictionary.Add(CommonToken("あし", "足"));
+    dictionary.Add(CommonToken("いためた", "炒めた"));
+    dictionary.Add(CommonToken("いためた", "痛めた"));
+    return dictionary;
+  }
+
+  bool IsSafe(const CorrectionDictionary& dictionary, absl::string_view reading,
+              absl::string_view original, absl::string_view corrected) const {
+    return kotori_internal::IsSafeDictionaryCorrection(
+        dictionary, pos_matcher_, reading, original, corrected);
+  }
+
+ private:
+  const testing::MockDataManager data_manager_;
+
+ protected:
+  const dictionary::PosMatcher pos_matcher_;
+};
