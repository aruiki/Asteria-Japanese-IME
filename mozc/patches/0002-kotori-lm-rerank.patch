+LmRewriter::LmRewriter(const dictionary::DictionaryInterface* dictionary,
+                       const dictionary::SingleKanjiDictionary* single_kanji,
+                       dictionary::PosMatcher pos_matcher)
+    : dictionary_(dictionary), single_kanji_(single_kanji),
+      pos_matcher_(pos_matcher) {
+  if (const char* v = Env("KOTORI_LM_K")) {
+    k_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_SENTENCE")) sentence_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_POST")) post_segment_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_RIGHT")) right_context_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_THREADS")) {
+    threads_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_WEIGHTS")) {
+    double a, b, t;
+    if (std::sscanf(v, "%lf,%lf,%lf", &a, &b, &t) == 3 && t > 0) {
+      lambda_lm_ = a;
+      lambda_lattice_ = b;
+      temperature_ = t;
+    }
+  }
+  if (const char* v = Env("KOTORI_ZENZ_MODEL")) env_model_path_ = v;
+  if (const char* v = Env("KOTORI_LLM_MODEL")) env_llm_path_ = v;
+  if (const char* v = Env("KOTORI_ZENZ_EXTRA_MODEL")) env_extra_path_ = v;
+  if (const char* v = Env("KOTORI_LM_BEAMS")) beams_override_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT")) predict_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_PREDICT_MODE")) predict_mode_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT_TOKENS")) {
+    predict_tokens_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_PREDICT_BEAMS")) {
+    predict_beams_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_TOP")) {
+    llm_top_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_LIGHT_BEAMS")) {
+    std::sscanf(v, "%d,%d,%d", &light_beams_, &light_head_beams_, &light_tokens_);
+  }
+  if (const char* v = Env("KOTORI_LM_LIGHT_RANK")) light_rank_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_LIGHT_DELAY")) light_delay_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_FULL_DELAY")) full_delay_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_LIVE")) live_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_LIVE_FIRST")) live_first_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_LIVE_NEXT")) live_next_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_CPU_LONG")) cpu_long_chars_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_TYPO")) typo_correct_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_TYPO_MARGIN")) typo_margin_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_TYPO_K")) typo_k_ = std::max(1, std::atoi(v));
+  if (const char* v = Env("KOTORI_LM_TYPO_GAIN")) typo_gain_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_TYPO_GATE")) typo_gate_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_TYPO_STRONG")) typo_strong_gain_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_ZENZ_LONG_MODEL")) env_long_path_ = v;
+  if (const char* v = Env("KOTORI_LM_IDLE_UNLOAD")) {
+    idle_unload_ms_ = std::max(0, std::atoi(v)) * 1000;
+  }
+  last_activity_us_ = SteadyNowUs();
+  if (const char* v = Env("KOTORI_LM_NSENT")) {
+    max_sentences_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_WEIGHT")) lambda_llm_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_GEN_PENALTY")) gen_penalty_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_GEN_PENALTY_LLM")) {
+    gen_penalty_llm_ = std::atof(v);
+  }
+  model_dir_ = SystemUtil::GetServerDirectory();
+  // llama.cpp の DLL とモデルのフォルダ(評価用に差し替えられる)。
+  runtime_dir_ = model_dir_;
+  if (const char* v = Env("KOTORI_RUNTIME_DIR")) runtime_dir_ = v;
+  if (const char* v = Env("KOTORI_MODEL_DIR")) model_dir_ = v;
+  if (const char* v = Env("KOTORI_LM_BUDGET")) budget_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PRECONVERT")) preconvert_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_TAB_BUDGET")) tab_budget_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_SPLIT")) split_generated_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_FILTER_JUNK")) filter_junk_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_TAB_SHOW")) tab_show_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_MIN_CONTINUATION")) {
+    min_continuation_chars_ = std::atoi(v);
+  }
+  // 今の設定のモデルを裏で読み込んでおく(最初の変換で 1 秒以上待たないため)。
+  // KOTORI_LM_PRELOAD=0(評価)なら、要求の中で読み込む(読み込みを待ってから変換する)。
+  const char* preload = Env("KOTORI_LM_PRELOAD");
+  sync_load_ = preload != nullptr && *preload == '0';
+  const char* correction = Env("KOTORI_LM_CORRECTION");
+  identify_correction_models_ = !sync_load_ &&
+      (correction == nullptr || std::string(correction) == "1");
+  // Kotori: 設定の初期化を終えてからワーカーを開始する。
+  worker_ = std::thread([this] { WorkerLoop(); });
+  if (!sync_load_) RequestLoad(config::ConfigHandler::GetCopiedConfig());
+}
+
+void LmRewriter::WriteStatus(const config::Config& config,
+                             const char* state) const {
+  if (sync_load_) return;  // 評価では書かない
+  // 1 行に 1 項目(キー=値)。入力した文字は書かない。
+  std::string text;
+  auto line = [&](absl::string_view key, absl::string_view value) {
+    absl::StrAppend(&text, key, "=", value, "\n");
+  };
+  auto base = [](const std::string& path) {
+    const size_t p = path.find_last_of("/\\");
+    return p == std::string::npos ? path : path.substr(p + 1);
+  };
+  const bool runtime = EnsureLlamaRuntime(runtime_dir_);
+  const std::string gpu = runtime ? LlamaGpuName() : std::string();
+  if (!config.kotori_lm_enabled()) {
+    line("state", "off");
+  } else if (std::string(state) == "loading") {
+    line("state", "loading");
+  } else if (std::string(state) == "sleep") {
+    line("state", "sleep");
+  } else if (!runtime) {
+    line("state", "error");
+    line("message", "llama.dll");
+  } else if (scorer_ == nullptr) {
+    line("state", "error");
+    line("message", base(loaded_path_));
+  } else {
+    line("state", llm_ != nullptr ? "llm" : "zenz");
+  }
+  line("device", gpu.empty() ? "CPU" : gpu);
+  if (scorer_ != nullptr) line("zenz", base(loaded_path_));
+  if (llm_ != nullptr) line("llm", base(llm_path_));
+  // Kotori: 状態と計算量のみ。入力文・読み・文脈は記録しない。
+  line("stats", ZenzScorer::Stats());
+#ifdef _WIN32
+  line("pid", std::to_string(::GetCurrentProcessId()));
+  FILETIME created, exited, kernel, user;
+  if (::GetProcessTimes(::GetCurrentProcess(), &created, &exited, &kernel,
+                        &user)) {
+    const uint64_t ticks =
+        (static_cast<uint64_t>(created.dwHighDateTime) << 32) |
+        created.dwLowDateTime;
+    line("process_started", std::to_string(ticks));
+  }
+#endif
+  const std::string path = FileUtil::JoinPath(
+      SystemUtil::GetUserProfileDirectory(), "kotori_ai_status.txt");
+  const std::string temporary = path + ".tmp";
+  {
+    OutputFileStream out(temporary, std::ios::binary | std::ios::trunc);
+    if (!out || !(out << text)) return;
+    out.flush();
+    if (!out) return;
+  }
+  FileUtil::AtomicRename(temporary, path).IgnoreError();
+}
+
+void LmRewriter::RequestLoad(const config::Config& config) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  load_job_ = config;
+  job_cv_.notify_one();
+}
+
+void LmRewriter::Touch(const config::Config& config) const {
+  last_activity_us_ = SteadyNowUs();
+  if (config.kotori_lm_enabled() && sleeping_.exchange(false)) {
+    RequestLoad(config);
+  }
+  // Kotori: 入力中の候補を取り直すまでの時間(docs/adr/0039)。GPU があれば生成と採点が速いので
+  // 早めに、ないときは先回りの変換(手が止まって 0.12 秒後に始める生成)が終わる頃にする。
+  // 2 回目以降は、裏で作る予測(手が止まって 0.6 秒後に作り直す)を待って出す。
+  int first = 0, next = 0;
+  if (live_ && config.kotori_lm_enabled()) {
+    const bool gpu = HasGpu();
+    first = live_first_ms_ >= 0 ? live_first_ms_ : (gpu ? 200 : 450);
+    if (predict_ && config.kotori_lm_predict() && UsesLlm(config)) {
+      next = live_next_ms_ >= 0 ? live_next_ms_ : 800;
+    }
+  }
+  kotori::g_live_first_ms = first;
+  kotori::g_live_next_ms = next;
+}
+
+void LmRewriter::UnloadIfIdle(const config::Config& config) const {
+  if (idle_unload_ms_ <= 0 || sync_load_ || sleeping_.load() || loading_.load()) {
+    return;
+  }
+  if (SteadyNowUs() - last_activity_us_.load() <
+      static_cast<int64_t>(idle_unload_ms_) * 1000) {
+    return;
+  }
+  // 要求の最中なら外さない(次の確かめで外す)。
+  if (!mutex_.TryLock()) return;
+  const bool any = scorer_ != nullptr || llm_ != nullptr || extra_ != nullptr ||
+                   long_scorer_ != nullptr;
+  if (any) {
+    ++model_epoch_;
+    scorer_.reset();
+    llm_.reset();
+    extra_.reset();
+    long_scorer_.reset();
+    loaded_ = llm_loaded_ = extra_loaded_ = long_loaded_ = false;
+    long_path_.clear();
+    loaded_path_.clear();
+    llm_path_.clear();
+    extra_path_.clear();
+    gen_cache_.reset();
+    sleeping_ = true;
+    WriteStatus(config, "sleep");
+  }
+  mutex_.Unlock();
+  if (!any) return;
+  // 覚えておいた予測(入力した文字を含む)も捨てる。
+  ClearPredictions();
+  std::lock_guard<std::mutex> lock(job_mu_);
+  last_converted_key_.clear();
+}
+
+bool LmRewriter::TryLockForRequest(int wait_ms) const {
+  // モデルの読み込み中は待たない(ノート PC では数秒かかり、変換が固まる。docs/adr/0024)。
+  if (loading_.load()) return false;
+  // 裏の予測は urgent_ を見て 1 トークンごとにやめるので、少しだけ待つ(同じ読みの先回りの
+  // 変換は、やめずに終わるのを待つ)。
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(wait_ms);
+  while (!mutex_.TryLock()) {
+    if (loading_.load() || std::chrono::steady_clock::now() > deadline) {
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  return true;
+}
+
+LmRewriter::~LmRewriter() {
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    stop_ = true;
+  }
+  job_cv_.notify_all();
+  if (worker_.joinable()) worker_.join();
+}
+
+void LmRewriter::EnsureLoaded(const std::string& path) const {
+  if (loaded_ && loaded_path_ == path) return;
+  ++model_epoch_;
+  loaded_ = true;
+  loaded_path_ = path;
+  scorer_.reset();
+  if (!FileUtil::FileExists(path).ok()) return;
+  scorer_ = ZenzScorer::Open(path, threads_, runtime_dir_,
+                              identify_correction_models_);
+}
+
+void LmRewriter::EnsureLlmLoaded(const std::string& path) const {
+  if (llm_loaded_ && llm_path_ == path) return;
+  ++model_epoch_;
+  llm_loaded_ = true;
+  llm_path_ = path;
+  llm_.reset();
+  if (path.empty() || !FileUtil::FileExists(path).ok()) return;
+  llm_ = ZenzScorer::Open(path, threads_, runtime_dir_,
+                           identify_correction_models_);
+}
+
+ZenzScorer* LmRewriter::Prepare(const ConversionRequest& request, size_t* k,
+                                ZenzScorer** llm, int* beams) const {
+  size_t llm_top = 0;
+  return PrepareFor(request.config(), k, llm, beams, &llm_top, false,
+                    sync_load_);
+}
+
+ZenzScorer* LmRewriter::PrepareFor(const config::Config& config, size_t* k,
+                                   ZenzScorer** llm, int* beams,
+                                   size_t* llm_top, bool for_predict,
+                                   bool may_load, size_t reading_chars) const {
+  *llm = nullptr;
+  if (!config.kotori_lm_enabled()) return nullptr;
+  // GPU のない PC(内蔵 GPU だけの PC を含む)では、品質の設定に関係なく Low にする。LLM は
+  // CPU では遅すぎ、Standard 以上の中身では変換が固まるため(docs/adr/0024)。
+  const bool gpu = HasGpu();
+  const Quality quality =
+      QualityOf(gpu ? config.kotori_lm_quality() : config::Config::KOTORI_LM_LOW);
+  *k = k_override_.value_or(quality.k);
+  *beams = beams_override_.value_or(quality.beams);
+  *llm_top = llm_top_override_.value_or(quality.llm_top);
+  if (*k < 2) return nullptr;
+  // zenz(生成と採点。常に使う): KOTORI_ZENZ_MODEL → 品質の段階の zenz → 同梱の zenz。
+  std::string path = env_model_path_;
+  if (path.empty()) {
+    path = FileUtil::JoinPath(model_dir_, quality.model);
+    if (!FileUtil::FileExists(path).ok()) {
+      path = FileUtil::JoinPath(model_dir_, kDefaultModelName);
+    }
+  }
+  // まだ読み込んでいなければ、裏のスレッドに頼んで今回は AI なしにする(待たない)。
+  if (!may_load && !(loaded_ && loaded_path_ == path)) {
+    RequestLoad(config);
+    return nullptr;
+  }
+  EnsureLoaded(path);
+  // GPU のない PC で長い読みなら、速い zenz を使う(docs/adr/0035)。品質の段階の zenz と同じなら使わない。
+  ZenzScorer* main_scorer = scorer_.get();
+  if (!gpu && cpu_long_chars_ > 0 &&
+      reading_chars > static_cast<size_t>(cpu_long_chars_)) {
+    const std::string long_path =
+        env_long_path_.empty() ? FileUtil::JoinPath(model_dir_, kDefaultModelName)
+                               : env_long_path_;
+    if (long_path != path) {
+      if (!(long_loaded_ && long_path_ == long_path)) {
+        if (!may_load) {
+          RequestLoad(config);
+        } else {
+          ++model_epoch_;
+          long_loaded_ = true;
+          long_path_ = long_path;
+          long_scorer_.reset();
+          if (FileUtil::FileExists(long_path).ok()) {
+            long_scorer_ = ZenzScorer::Open(long_path, threads_, runtime_dir_,
+                                            identify_correction_models_);
+          }
+        }
+      }
+      if (long_scorer_ != nullptr) main_scorer = long_scorer_.get();
+    }
+  }
+  // 2 つ目の zenz(Unreal、または評価用の KOTORI_ZENZ_EXTRA_MODEL)。ファイルがなければ使わない。
+  {
+    std::string extra = env_extra_path_;
+    if (extra.empty() && quality.extra != nullptr) {
+      extra = FileUtil::JoinPath(model_dir_, quality.extra);
+    }
+    if (!(extra_loaded_ && extra_path_ == extra)) {
+      if (!may_load && !extra.empty()) {
+        RequestLoad(config);
+      } else {
+        ++model_epoch_;
+        extra_loaded_ = true;
+        extra_path_ = extra;
+        extra_.reset();
+        if (!extra.empty() && FileUtil::FileExists(extra).ok()) {
+          extra_ = ZenzScorer::Open(extra, threads_, runtime_dir_);
+        }
+      }
+    }
+  }
+  // LLM(文全体の採点に加える): AI モデルが LLM か、自動で GPU があるとき(docs/adr/0016)。
+  // ファイルは設定のパス → KOTORI_LLM_MODEL → 同梱の LLM。
+  // 変換で LLM を使うのは llm_top が 1 以上のとき(品質 Standard 以上)。Tab の予測(for_predict)
+  // では品質に関係なく使う。品質 Low では最初の Tab で読み込み、その後は読み込んだままにする。
+  if (!UsesLlm(config)) {
+    EnsureLlmLoaded(std::string());  // 使わない設定なら VRAM を空ける
+    return main_scorer;
+  }
+  if (*llm_top > 0 || for_predict) {
+    std::string llm_path = config.kotori_lm_model_path();
+    if (llm_path.empty()) llm_path = env_llm_path_;
+    if (llm_path.empty()) llm_path = FileUtil::JoinPath(model_dir_, kLlmModelName);
+    if (!may_load && !(llm_loaded_ && llm_path_ == llm_path)) {
+      RequestLoad(config);
+      return main_scorer;
+    }
+    EnsureLlmLoaded(llm_path);
+    *llm = llm_.get();
+  }
+  return main_scorer;
+}
+
+std::string LmRewriter::ModelKey(const ZenzScorer* scorer) const {
+  const std::string& path =
+      scorer != nullptr && scorer == long_scorer_.get() ? long_path_ : loaded_path_;
+  return path + "|" + extra_path_;
+}
+
+std::shared_ptr<const LmRewriter::CorrectionModels>
+LmRewriter::BindCorrectionModels(const ZenzScorer* scorer,
+                                  const ZenzScorer* llm) const {
+  if (scorer == nullptr || llm == nullptr ||
+      scorer->model_sha256().empty() || llm->model_sha256().empty()) {
+    return nullptr;
+  }
+  const uint64_t epoch = model_epoch_.load();
+  std::lock_guard<std::mutex> lock(job_mu_);
+  if (!correction_models_ || correction_models_->epoch != epoch ||
+      correction_models_->zenz_sha256 != scorer->model_sha256() ||
+      correction_models_->llm_sha256 != llm->model_sha256()) {
+    correction_models_ = std::make_shared<const CorrectionModels>(
+        CorrectionModels{epoch, scorer->model_sha256(), llm->model_sha256()});
+    if (Env("KOTORI_LM_DEBUG") != nullptr) {
+      std::fprintf(stderr, "[kotori] correction models zenz=%s llm=%s\n",
+          correction_models_->zenz_sha256.c_str(),
+          correction_models_->llm_sha256.c_str());
+    }
+  }
+  return correction_models_;
+}
+
+std::string LmRewriter::MemoKey(const config::Config& config,
+                                const std::string& reading,
+                                const std::string& context) const {
+  return absl::StrCat(reading, "\t", CacheKey(config, context));
+}
+
+std::optional<std::optional<LmRewriter::Best>> LmRewriter::FindMemo(
+    const std::string& key, const ConversionRequest& request) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  for (const auto& [k, best] : memo_) {
+    if (k != key) continue;
+    if (best && best->correction) {
+      const auto& origin = *best->correction;
+      if (!origin.input.IsCurrent() ||
+          !origin.input.IsSame(request.kotori_input_generation()) ||
+          !origin.models || origin.models != correction_models_ ||
+          origin.models->epoch != model_epoch_.load()) return std::nullopt;
+    }
+    return best;
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> LmRewriter::EvaluatedPredictionBase(
+    const ConversionRequest& request, const std::string& reading,
+    const std::string& context) const {
+  if (!request.config().kotori_lm_enabled() || request.incognito_mode() ||
+      request.context().input_field_type() == commands::Context::PASSWORD ||
+      !request.kotori_input_generation().IsCurrent()) {
+    return std::nullopt;
+  }
+  const std::string key = MemoKey(request.config(), reading, context);
+  const auto memo = FindMemo(key, request);
+  if (!memo || !*memo) return std::nullopt;
+  const Best& best = **memo;
+  if (best.reading != reading || best.context != context || best.keys.empty() ||
+      best.keys.size() != best.values.size() ||
+      (best.correction && best.correction->config_key != key)) {
+    return std::nullopt;
+  }
+  std::string joined_reading, text;
+  for (size_t i = 0; i < best.keys.size(); ++i) {
+    joined_reading += best.keys[i];
+    text += best.values[i];
+  }
+  if (joined_reading != reading || text.empty()) return std::nullopt;
+  return text;
+}
+bool LmRewriter::StoreMemo(const std::string& key, std::optional<Best> best,
+                           bool background,
+                           const std::function<bool()>& cancelled) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  // 新しい入力のキュー登録やAI無効化と同じロック内で最後に検査する。
+  if (background && cancelled()) return false;
+  if (best && best->correction &&
+      (!best->correction->input.IsCurrent() ||
+       !best->correction->models ||
+       best->correction->models != correction_models_ ||
+       best->correction->models->epoch != model_epoch_.load())) return false;
+  for (auto it = memo_.begin(); it != memo_.end(); ++it) {
+    if (it->first == key) {
+      memo_.erase(it);
+      break;
+    }
+  }
+  memo_.emplace_back(key, std::move(best));
+  while (memo_.size() > 16) memo_.pop_front();
+  return true;
+}
+
+std::string LmRewriter::CacheKey(const config::Config& config,
+                                 const std::string& context) const {
+  // 予測の結果を変える設定(品質、AI モデル、LLM のファイル)。違う設定で作った予測は使わない
+  // (docs/IMPROVEMENT_PROPOSALS.md の案 04)。
+  return absl::StrCat(static_cast<int>(config.kotori_lm_quality()), ",",
+                      static_cast<int>(config.kotori_lm_model()), ",",
+                      config.kotori_lm_model_path(), ",",
+                      config.kotori_lm_correction(), "\x1f", context);
+}
+
+void LmRewriter::ClearPredictions() const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  cache_.clear();
+  if (job_ && !job_->convert && !job_->preview) job_.reset();
+}
+
+bool LmRewriter::HasGpu() const {
+  return EnsureLlamaRuntime(runtime_dir_) && LlamaHasGpu();
+}
+
+bool LmRewriter::UsesLlm(const config::Config& config) const {
+  // AI モデルが「zenz のみ」でなく、AI を載せられる GPU があるとき(docs/adr/0016、0024)。
+  return config.kotori_lm_model() != config::Config::KOTORI_LM_MODEL_ZENZ &&
+         HasGpu();
+}
+
+int LmRewriter::BudgetMs() const {
+  // 変換で AI に使う時間の上限。GPU がないときは短くする(CPU では生成が遅く、待たせないため)。
+  if (budget_ms_ >= 0) return budget_ms_;
+  return HasGpu() ? 2000 : 600;
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::CheckResizeSegmentsRequest(const ConversionRequest& request,
+                                       const Segments& segments) const {
+  // サジェストのための変換(予測の中のリアルタイム変換。1 打鍵ごとに来る)では動かない。
+  if (!request.config().kotori_lm_enabled() || request.incognito_mode() ||
+      !sentence_ || request.request_type() != ConversionRequest::CONVERSION ||
+      request.options().skip_slow_rewriters) {
+    return std::nullopt;
+  }
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] sentences=%zu segments=%zu\n",
+                 sentences.size(), segments.conversion_segments_size());
+  }
+  // 文全体の候補は、区切りが決まっていない最初の変換のときだけある(切り直した後の変換では空)。
+  if (sentences.empty()) return std::nullopt;
+  const std::string reading = ConversionReading(segments);
+  const std::string context = HistoryContext(request, segments);
+  const std::string key = reading + "\t" + context;
+  if (!HasGpu() && Util::CharsLen(reading) > kMaxCpuChars) return std::nullopt;
+  // Kotori: 入力中の候補に出した結果(または、前に同じ読みで選んだ結果)があれば、それを使う
+  // (表示と Space の結果をそろえ、裏の計算を止めない。docs/adr/0039)。
+  const std::string memo_key = MemoKey(request.config(), reading, context);
+  const bool preview = request.options().kotori_preview;
+  if (const auto memo = FindMemo(memo_key, request); memo && (*memo || preview)) {
+    {
+      std::lock_guard<std::mutex> jl(job_mu_);
+      last_converted_key_ = key;
+    }
+    if (!*memo) return std::nullopt;
+    return ResizeFor(**memo, segments);
+  }
+  if (preview) {
+    // Kotori: 入力中の取り直しは計算を待たない。文候補と設定のコピーを
+    // ワーカーへ渡し、次の取り直しで同じ読み・文脈の結果だけを使う。
+    std::lock_guard<std::mutex> jl(job_mu_);
+    const auto& input = request.kotori_input_generation();
+    if ((running_preview_ != memo_key || !running_preview_input_.IsSame(input)) &&
+        !(job_ && job_->preview && job_->input_generation.IsSame(input) &&
+          MemoKey(job_->config, job_->reading, job_->context) == memo_key)) {
+      job_ = Job{reading, context, request.config(), false,
+                 std::make_shared<Segments>(segments), input};
+      new_job_ = true;
+      job_cv_.notify_one();
+    }
+    return std::nullopt;
+  }
+  const std::optional<ResizeSegmentsRequest> resize =
+      SelectSentence(request, segments, reading, context, key);
+  // Kotori: モデルの準備中・ロック待ち・時間切れは結果ではない。
+  // 失敗を保存すると、同じ読みの取り直しでも永久に再評価できなくなる。
+  return resize;
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest> LmRewriter::ResizeFor(
+    const Best& best, const Segments& segments) {
+  std::vector<std::string> current;
+  for (const Segment& seg : segments.conversion_segments()) {
+    current.emplace_back(seg.key());
+  }
+  if (current == best.keys) return std::nullopt;
+  ResizeSegmentsRequest resize;
+  resize.segment_index = 0;
+  const size_t n = std::min(best.keys.size(), resize.segment_sizes.size());
+  for (size_t i = 0; i < n; ++i) {
+    const size_t len = Util::CharsLen(best.keys[i]);
+    if (len == 0 || len > 255) return std::nullopt;
+    resize.segment_sizes[i] = static_cast<uint8_t>(len);
+  }
+  return resize;
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::SelectSentence(const ConversionRequest& request,
+                           const Segments& segments, const std::string& reading,
+                           const std::string& context,
+                           const std::string& key, bool background) const {
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  const auto t_request = std::chrono::steady_clock::now();
+  std::unique_ptr<Urgent> urgent;
+  if (!background) urgent = std::make_unique<Urgent>(urgent_, last_request_us_);
+  // 同じ読みの先回りの変換が裏で計算中なら、捨てずに終わるのを待つ(上限まで)。
+  int wait_ms = background ? 0 : 300;
+  {
+    std::lock_guard<std::mutex> jl(job_mu_);
+    urgent_key_ = key;
+    last_converted_key_ = key;
+    if (!background && running_convert_ == key) {
+      wait_ms = std::max(wait_ms, BudgetMs());
+    }
+  }
+  if (!TryLockForRequest(wait_ms)) return std::nullopt;
+  HeldLock lock(mutex_);
+  best_.reset();
+  const auto t0 = std::chrono::steady_clock::now();
+  // AI に使う時間の上限(モデルを用意した後から数える)。超えたら生成をやめ、LLM も使わない
+  // (遅い PC で固まらないため)。
+  std::chrono::steady_clock::time_point deadline, gen_deadline;
+  int budget_ms = 0;
+  auto over = [&] {
+    return (background && (stop_.load() || new_job_.load() || urgent_.load() > 0 ||
+            (request.kotori_input_generation().IsSet() &&
+             !request.kotori_input_generation().IsCurrent()))) ||
+           (budget_ms > 0 && std::chrono::steady_clock::now() > deadline);
+  };
+  // 生成は上限の 6 割までにし、残りを採点に残す(採点の 1 回の計算は途中でやめられないため。
+  // docs/adr/0029)。
+  auto gen_over = [&] {
+    return over() ||
+           (budget_ms > 0 && std::chrono::steady_clock::now() > gen_deadline);
+  };
+  auto ms = [](auto a, auto b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+  };
+  size_t k = 0;
+  int beams = 0;
+  size_t llm_top = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = PrepareFor(request.config(), &k, &llm, &beams, &llm_top,
+                                  false, sync_load_, Util::CharsLen(reading));
+  if (scorer == nullptr) return std::nullopt;
+  const auto t_load = std::chrono::steady_clock::now();
+  const auto correction_models = background && identify_correction_models_
+      ? BindCorrectionModels(scorer, llm) : nullptr;
+  budget_ms = BudgetMs();
+  // 上限は要求が来た時点から数える(ロックを待った時間も含める)。この要求の中でモデルを読み込んだ
+  // とき(評価)は、読み込みの後から数える。
+  const auto t_budget =
+      t_load - t0 > std::chrono::milliseconds(50) ? t_load : t_request;
+  deadline = t_budget + std::chrono::milliseconds(budget_ms);
+  gen_deadline = t_budget + std::chrono::milliseconds(budget_ms * 6 / 10);
+
+  // 候補 = ラティスの文全体の候補(区切り付き)+ zenz が読みから生成した文(区切りなし)。
+  std::vector<const converter::Candidate*> cands;
+  std::vector<std::string> values;
+  for (const converter::Candidate& c : sentences) {
+    if (c.key != reading || c.inner_segment_boundary.empty()) continue;
+    if (std::find(values.begin(), values.end(), c.value) != values.end()) {
+      continue;
+    }
+    cands.push_back(&c);
+    values.push_back(c.value);
+    if (cands.size() >= max_sentences_) break;
+  }
+  // ユーザー辞書の語を含む文が Mozc の 1 位なら、利用者が登録した表記を AI で変えない
+  // (docs/adr/0027、改善案 07)。
+  if (!cands.empty() && cands.front() != nullptr &&
+      (cands.front()->attributes & converter::Attribute::USER_DICTIONARY)) {
+    return std::nullopt;
+  }
+  // ラティスの 1 位のひらがなの数。生成した文がこれより 4 文字以上多ければ、読みを漢字に変えずに
+  // 写しただけとみなして除く(zenz は読みを写した文を高く採点することがある)。
+  const size_t lattice_kana =
+      values.empty() ? SIZE_MAX : CountKana(values.front());
+  std::vector<std::string> generated;
+  if (beams > 0 && Util::CharsLen(reading) <= kMaxGenerateChars) {
+    if (gen_cache_ && gen_cache_->key == key && gen_cache_->beams == beams &&
+        gen_cache_->model == ModelKey(scorer)) {
+      generated = gen_cache_->texts;  // 先回りの変換で作ったもの
+    } else {
+      {
+        CancelScope cancel(gen_over);
+        generated = scorer->Generate(context, reading, beams);
+        // 2 つ目の zenz(Unreal)でも生成し、候補を合わせる(docs/adr/0031)。
+        {
+          if (extra_ != nullptr && !gen_over()) {
+            for (std::string& g : extra_->Generate(context, reading, beams)) {
+              if (std::find(generated.begin(), generated.end(), g) ==
+                  generated.end()) {
+                generated.push_back(std::move(g));
+              }
+            }
+          }
+        }
+      }
+      // 裏の先回りの変換が同じ読みを作り直さないように残す(途中でやめたものは残さない)。
+      if (!gen_over()) gen_cache_ = Generated{key, beams, loaded_path_ + "|" + extra_path_, generated};
+    }
+  }
+  {
+    for (const std::string& g : generated) {
+      if (std::find(values.begin(), values.end(), g) != values.end()) continue;
+      if ((lattice_kana != SIZE_MAX && CountKana(g) >= lattice_kana + 4) ||
+          HasStraySmallKana(g)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected (kana) %s\n", g.c_str());
+        }
+        continue;
+      }
+      // 読みを落とした文や、読みにない語を足した文を除く。
+      if (dictionary_ != nullptr &&
+          !MatchesReading(*dictionary_, single_kanji_, g, reading)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected %s\n", g.c_str());
+        }
+        continue;
+      }
+      cands.push_back(nullptr);
+      values.push_back(g);
+    }
+  }
+  const auto t_gen = std::chrono::steady_clock::now();
+  // 生成で時間を使い切ったら、採点もせずに Mozc の結果を出す(待たせないため)。
+  // Kotori: 生成補正は非同期の初回評価のみ。採用前に読み・保護語・入力世代・モデルを検査。
+  const bool llm_correction = background && correction_models != nullptr &&
+      request.kotori_input_generation().IsCurrent() &&
+      request.config().kotori_lm_correction() &&
+      (Env("KOTORI_LM_CORRECTION") == nullptr ||
+       std::string(Env("KOTORI_LM_CORRECTION")) == "1");
+  // 候補が1件でも、並べ替えでは作れない修正文を非同期で生成できる。
+  if (values.empty() || (values.size() < 2 && !llm_correction) || gen_over()) {
+    return std::nullopt;
+  }
+  // 点数 = zenz の log P(文 | 読み、前の文) + LLM の log P(文 | 前の文)(docs/adr/0016)。
+  // LLM がないときは zenz だけで選ぶ。
+  const std::optional<std::vector<float>> zlogp =
+      scorer->Score(context, reading, values);
+  if (!zlogp) return std::nullopt;
+  const auto t_zenz = std::chrono::steady_clock::now();
+  // LLM は zenz の点数の上位 llm_top 件だけを採点する(速さのため)。ほかは選ばない。
+  // 時間の上限を超えていたら使わない。
+  std::optional<std::vector<float>> llogp;
+  if (llm != nullptr && !over()) {
+    std::vector<size_t> order(values.size());
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+      return (*zlogp)[a] > (*zlogp)[b];
+    });
+    order.resize(std::min(order.size(), llm_top));
+    // ラティスの 1 位は必ず採点する(zenz が生成を高く見積もっても、Mozc の答えと比べられるように)。
+    if (cands.front() != nullptr &&
+        std::find(order.begin(), order.end(), 0) == order.end()) {
+      order.push_back(0);
+    }
+    std::vector<std::string> subset;
+    for (size_t i : order) subset.push_back(values[i]);
+    if (auto sub = llm->Score(context, reading, subset)) {
+      llogp.emplace(values.size(), -std::numeric_limits<float>::infinity());
+      for (size_t j = 0; j < order.size(); ++j) (*llogp)[order[j]] = (*sub)[j];
+    }
+  }
+  const auto t_llm = std::chrono::steady_clock::now();
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(stderr,
+                 "[time] chars=%zu load=%.0fms gen=%.0fms zenz=%.0fms llm=%.0fms "
+                 "total=%.0fms gpu=%d llm_on=%d beams=%d cands=%zu\n",
+                 Util::CharsLen(reading), ms(t0, t_load), ms(t_load, t_gen),
+                 ms(t_gen, t_zenz), ms(t_zenz, t_llm), ms(t0, t_llm),
+                 LlamaHasGpu() ? 1 : 0, llm != nullptr ? 1 : 0, beams,
+                 values.size());
+  }
+  size_t top = 0;
+  double top_score = 0;
+  const bool debug = Env("KOTORI_LM_DEBUG") != nullptr;
+  for (size_t i = 0; i < values.size(); ++i) {
+    double s = lambda_lm_ * (*zlogp)[i];
+    if (llogp) s += lambda_llm_ * (*llogp)[i];
+    // 生成した文は辞書の表記を通らないので、同じくらいの点ならラティスの文を選ぶ。
+    if (cands[i] == nullptr) s -= llogp ? gen_penalty_llm_ : gen_penalty_;
+    if (debug) {
+      std::fprintf(stderr, "[kotori] %s zenz=%.2f llm=%.2f %s score=%.2f\n",
+                   values[i].c_str(), (*zlogp)[i], llogp ? (*llogp)[i] : 0.f,
+                   cands[i] == nullptr ? "gen" : "lattice", s);
+    }
+    if (i == 0 || s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+
+  Best best{reading, context, {}, {}};
+  // Kotori: 打ち間違いを補った文の方がずっと自然なら、それを 1 つの文節として出す(docs/adr/0036)。
+  std::string fixed;
+  if (llm_correction && llm != nullptr && llogp && dictionary_ != nullptr && !over() &&
+      Util::CharsLen(reading) <= kMaxTypoChars &&
+      FindLlmCorrection(scorer, llm, context, reading, values[top],
+                        lambda_lm_ * (*zlogp)[top] + lambda_llm_ * (*llogp)[top],
+                        over, &fixed)) {
+    best.keys = {reading};
+    best.values = {fixed};
+    best.correction = CorrectionOrigin{request.kotori_input_generation(),
+        correction_models, MemoKey(request.config(), reading, context)};
+    if (!MatchesReading(*dictionary_, single_kanji_, fixed, reading, false)) {
+      best.corrected_reading = kotori_internal::MechanicalCorrectionReading(
+          *dictionary_, reading, fixed);
+    }
+  } else if (typo_correct_ && llm != nullptr && llogp && dictionary_ != nullptr && !over() &&
+      Util::CharsLen(reading) <= kMaxTypoChars &&
+      FindTypoCorrection(scorer, llm, context, reading, values[top],
+                         lambda_lm_ * (*zlogp)[top] + lambda_llm_ * (*llogp)[top],
+                         over, &fixed)) {
+    best.keys = {reading};
+    best.values = {fixed};
+  } else if (cands[top] == nullptr) {
+    // 生成した文は区切りを持たないので、表記と読みの対応で文節に分ける(一語だけ直しやすく
+    // するため)。対応が取れないときや分割を切ったときは、全体を 1 つの文節にする。
+    std::vector<std::pair<std::string, std::string>> units;
+    if (split_generated_ && dictionary_ != nullptr &&
+        MatchesReading(*dictionary_, single_kanji_, values[top], reading, false,
+                       &units)) {
+      SplitIntoSegmentsImpl(units, ResizeSegmentsRequest().segment_sizes.size(),
+                            &best.keys, &best.values);
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        for (const auto& [ut, ur] : units) {
+          std::fprintf(stderr, "[kotori] unit %s/%s\n", ut.c_str(), ur.c_str());
+        }
+      }
+    }
+    if (best.keys.empty() || absl::StrJoin(best.keys, "") != reading ||
+        absl::StrJoin(best.values, "") != values[top]) {
+      best.keys = {reading};
+      best.values = {values[top]};
+    }
+  } else {
+    for (const auto& inner : cands[top]->inner_segments()) {
+      best.keys.emplace_back(inner.GetKey());
+      best.values.emplace_back(inner.GetValue());
+    }
+  }
+  if (best.keys.empty() || (background && over())) return std::nullopt;
+
+  // 今の区切りと同じなら、切り直さずに Rewrite で先頭を入れ替える。
+  if (!StoreMemo(MemoKey(request.config(), reading, context), best,
+                 background, over)) return std::nullopt;
+  best_ = best;
+  return ResizeFor(best, segments);
+}
+
+bool LmRewriter::ApplyBest(const ConversionRequest& request,
+                           Segments* segments, const std::string& context,
+                           bool* changed_out) const {
+  *changed_out = false;
+  return best_ && ApplyBestFrom(*best_, request, segments, context, changed_out);
+}
+
+bool LmRewriter::ApplyBestFrom(const Best& best,
+                               const ConversionRequest& request,
+                               Segments* segments, const std::string& context,
+                               bool* changed_out) const {
+  *changed_out = false;
+  if (best.correction) {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    const auto& origin = *best.correction;
+    if (!origin.input.IsCurrent() ||
+        !origin.input.IsSame(request.kotori_input_generation()) ||
+        !origin.models || origin.models != correction_models_ ||
+        origin.models->epoch != model_epoch_.load() ||
+        origin.config_key != MemoKey(request.config(), best.reading, context)) {
+      return false;
+    }
+  }
+  if (best.context != context || best.reading != ConversionReading(*segments)) {
+    return false;
+  }
+  size_t i = 0;
+  for (const Segment& seg : segments->conversion_segments()) {
+    if (i >= best.keys.size() || seg.key() != best.keys[i]) return false;
+    ++i;
+  }
+  if (i != best.keys.size()) return false;
+
+  auto mark_top = [&](converter::Candidate* candidate) {
+    candidate->kotori_ai_evaluated = true;
+    candidate->kotori_corrected_reading = best.corrected_reading;
+    if (!best.corrected_reading.empty()) {
+      candidate->attributes |= converter::Attribute::SPELLING_CORRECTION |
+                               converter::Attribute::NO_LEARNING;
+    }
+  };
+  bool changed = false;
+  i = 0;
+  for (Segment& seg : segments->conversion_segments()) {
+    const std::string& value = best.values[i++];
+    if (seg.candidates_size() > 0) {
+      auto* current = seg.mutable_candidate(0);
+      current->kotori_ai_evaluated = true;
+      current->kotori_corrected_reading.clear();
+      // ユーザー辞書を保持したときや、元の候補が下へ残るときは補正の印を付けない。
+      if (current->value == value) mark_top(current);
+    }
+    if (seg.candidates_size() == 0 || seg.candidate(0).value == value) {
+      continue;
+    }
+    // ユーザー辞書の語は置き換えない。
+    if (seg.candidate(0).attributes & converter::Attribute::USER_DICTIONARY) {
+      continue;
+    }
+    int found = -1;
+    for (size_t j = 1; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == value) {
+        found = static_cast<int>(j);
+        break;
+      }
+    }
+    converter::Candidate c = seg.candidate(found >= 0 ? found : 0);
+    if (found >= 0) {
+      seg.erase_candidate(found);
+    } else {
+      // 文節の候補にない値(文全体の候補でだけ出たもの)は、先頭の候補を写して作る。
+      c.value = value;
+      c.content_value = value;
+      c.content_key = std::string(seg.key());
+      c.inner_segment_boundary.clear();
+    }
+    *seg.insert_candidate(0) = std::move(c);
+    mark_top(seg.mutable_candidate(0));
+    changed = true;
+  }
+  *changed_out = changed;
+  return true;
+}
+
+bool LmRewriter::RewriteEachSegment(
+    const ConversionRequest& request, ZenzScorer* scorer, size_t k,
+    bool keep_top, std::chrono::steady_clock::time_point deadline,
+    Segments* segments) const {
+  std::string context = HistoryContext(request, *segments);
+  bool changed = false;
+  const size_t num_segments = segments->conversion_segments_size();
+  for (size_t s = 0; s < num_segments; ++s) {
+    Segment& seg = *segments->mutable_conversion_segment(s);
+    const size_t n = std::min(seg.candidates_size(), k);
+    if (BudgetMs() > 0 && std::chrono::steady_clock::now() > deadline) break;
+    // ユーザー辞書の語が 1 位の文節は並べ替えない。
+    const bool user_top =
+        seg.candidates_size() > 0 &&
+        (seg.candidate(0).attributes & converter::Attribute::USER_DICTIONARY);
+    if (n >= 2 && !seg.key().empty() && !user_top) {
+      // 読みと候補の後ろに、残りの文節の読みと第 1 候補をつなぐ。「はが」だけでは
+      // 葉/歯を決められないが、「はがいたい」なら決められる。
+      std::string reading(seg.key());
+      std::string suffix;
+      if (right_context_) {
+        for (size_t t = s + 1; t < num_segments; ++t) {
+          const Segment& next = segments->conversion_segment(t);
+          if (next.candidates_size() == 0) break;
+          reading += next.key();
+          suffix += next.candidate(0).value;
+        }
+      }
+      std::vector<std::string> values;
+      values.reserve(n);
+      for (size_t i = 0; i < n; ++i) {
+        values.push_back(seg.candidate(i).value + suffix);
+      }
+      if (auto logp = scorer->Score(Tail(context), reading, values)) {
+        std::vector<double> score(n);
+        for (size_t i = 0; i < n; ++i) {
+          score[i] = Combine((*logp)[i], seg.candidate(i).cost);
+        }
+        std::vector<size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        // keep_top なら先頭(文全体で選んだもの)は動かさず、2 番目以降だけ並べる。
+        std::stable_sort(order.begin() + (keep_top ? 1 : 0), order.end(),
+                         [&](size_t a, size_t b) { return score[a] > score[b]; });
+        std::vector<converter::Candidate> copies;
+        copies.reserve(n);
+        for (size_t i = 0; i < n; ++i) copies.push_back(seg.candidate(order[i]));
+        for (size_t i = 0; i < n; ++i) {
+          *seg.mutable_candidate(i) = std::move(copies[i]);
+        }
+        changed = changed || order[0] != 0;
+      }
+    }
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return changed;
+}
+
+namespace {
+
+// 続きの先頭が小書きのかなや長音のもの(「いいて」+「ぃ～んず」)は、語の途中で切れた
+// 変換に無理につないだものなので除く。
+bool NaturalStart(absl::string_view c) {
+  static constexpr absl::string_view kSmall[] = {
+      "ぁ", "ぃ", "ぅ", "ぇ", "ぉ", "ゃ", "ゅ", "ょ", "っ", "ゎ", "ー", "～",
+      "ァ", "ィ", "ゥ", "ェ", "ォ", "ャ", "ュ", "ョ", "ッ"};
+  for (absl::string_view k : kSmall) {
+    if (absl::StartsWith(c, k)) return false;
+  }
+  return !c.empty();
+}
+
+// 予測に出さない候補(入力の邪魔になるだけのもの。docs/adr/0030)。
+// - 続き(continuation)に開き括弧・引用符がある(「日本語教育 のように別の文へ脱線したもの)。
+// - 読みにひらがながあるのに、全部カタカナ(読みを写しただけ)。
+bool IsJunkPrediction(absl::string_view text, absl::string_view continuation,
+                      absl::string_view reading) {
+  static constexpr absl::string_view kOpen[] = {
+      "\xE3\x80\x8C", "\xE3\x80\x8E", "\xEF\xBC\x88", "\xE3\x80\x90",
+      "\xE3\x80\x88", "\xE3\x80\x8A", "(", "[", "\""};  // 「『(【〈《
+  for (absl::string_view o : kOpen) {
+    if (absl::StrContains(continuation, o)) return true;
+  }
+  auto kind = [](const std::string& c) {
+    if (c.size() != 3 || static_cast<unsigned char>(c[0]) != 0xE3) return 0;
+    const uint32_t cp =
+        ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+    if (cp >= 0x3041 && cp <= 0x309F) return 1;  // ひらがな
+    if (cp >= 0x30A1 && cp <= 0x30FA) return 2;  // カタカナ
+    return 0;
+  };
+  bool reading_hira = false;
+  for (const std::string& c : Chars(reading)) reading_hira |= kind(c) == 1;
+  bool all_kata = true;
+  for (const std::string& c : Chars(text)) {
+    if (kind(c) != 2 && c != "\xE3\x83\xBC") {  // 長音はカタカナとみなす
+      all_kata = false;
+      break;
+    }
+  }
+  return reading_hira && all_kata;
+}
+
+bool HasDigit(absl::string_view v) {
+  for (const std::string& ch : Chars(v)) {
+    if ((ch.size() == 1 && std::isdigit(static_cast<unsigned char>(ch[0]))) ||
+        (ch.size() == 3 && ch >= "\xEF\xBC\x90" && ch <= "\xEF\xBC\x99")) {
+      return true;
+    }
+  }
+  return false;
+}
+
+
+}  // namespace
+
+std::vector<LmRewriter::Prediction> LmRewriter::ComputePredictions(
+    const config::Config& config, const std::string& reading,
+    const std::string& context, std::string* conv_out, bool background,
+    bool light, std::chrono::steady_clock::time_point deadline) const {
+  std::vector<Prediction> preds;
+  size_t k = 0, llm_top = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = PrepareFor(config, &k, &llm, &beams, &llm_top, true,
+                                  background || sync_load_);
+  if (scorer == nullptr || llm == nullptr) return preds;
+  // 裏で計算しているときは、変換の要求が来たらすぐやめる。light なら打鍵に間に合うよう
+  // 軽くする(続きは 2 件・6 トークン、辞書の語を試す段は省く)。重い計算(作り直し)は
+  // 次の打鍵が来てもやめる。軽い計算は最後までして、次の打鍵の候補に使う。
+  const bool timed = deadline != std::chrono::steady_clock::time_point::max();
+  auto yield = [&] {
+    if (timed && std::chrono::steady_clock::now() > deadline) return true;
+    return background && (urgent_.load() > 0 || stop_.load() ||
+                          (!light && new_job_.load()));
+  };
+  // 生成の途中(1 トークンごと)でもやめられるようにする。
+  CancelScope cancel_scope(background || timed ? std::function<bool()>(yield)
+                                               : std::function<bool()>());
+  const int mode = light ? (predict_mode_ & 3) : predict_mode_;
+  const int n_beams = light ? light_beams_ : predict_beams_;
+  // 打ちかけを除いた変換の続きの数。GPU(Vulkan)は 1 回に 3 トークン以上を渡すと 2 トークンの
+  // 2 倍ほどかかるので、軽い計算では 2 つの続きの合計を小さくする(docs/adr/0024)。
+  const int n_head_beams = light ? light_head_beams_ : predict_beams_ + 1;
+  const int n_tokens =
+      light ? std::min(predict_tokens_, light_tokens_) : predict_tokens_;
+  const std::vector<std::string> rchars = Chars(reading);
+  // 変換する読み: 読み全体と、最後の 1〜2 文字を打ちかけとみなして除いた読み(heads)。
+  const size_t max_drop = light ? 1 : 2;
+  std::vector<std::string> heads, rests;
+  for (size_t drop = 1; drop <= max_drop && rchars.size() >= drop + 2; ++drop) {
+    std::string head, rest;
+    for (size_t i = 0; i < rchars.size(); ++i) {
+      (i + drop < rchars.size() ? head : rest) += rchars[i];
+    }
+    heads.push_back(std::move(head));
+    rests.push_back(std::move(rest));
+  }
+  // zenz の変換は、すべての読みを 1 回のビームサーチでまとめて行う(GPU を呼ぶ回数を減らす。
+  // docs/adr/0024)。convs[0] が読み全体、convs[i + 1] が heads[i] の変換。
+  std::vector<std::string> to_convert = {reading};
+  to_convert.insert(to_convert.end(), heads.begin(), heads.end());
+  const auto tt0 = std::chrono::steady_clock::now();
+  const std::vector<std::vector<std::string>> gens =
+      scorer->GenerateMany(context, to_convert, 2);
+  std::vector<std::string> convs(to_convert.size());
+  for (size_t i = 0; i < gens.size() && i < convs.size(); ++i) {
+    for (const std::string& g : gens[i]) {
+      if (dictionary_ == nullptr ||
+          MatchesReading(*dictionary_, single_kanji_, g, to_convert[i])) {
+        convs[i] = g;
+        break;
+      }
+    }
+  }
+  const std::string conv = convs[0];
+  const auto tt1 = std::chrono::steady_clock::now();
+  if (conv_out != nullptr) *conv_out = conv;
+  if (conv.empty() || yield()) return preds;
+  auto add = [&](const std::string& text, const std::string& base,
+                 const std::string& covered) {
+    // Kotori: トークン上限で文字の途中に切れた生成を採点・表示へ渡さない。
+    if (!Util::IsValidUtf8(text) || !Util::IsValidUtf8(base) ||
+        !Util::IsValidUtf8(covered) || text == conv || HasDigit(text)) return;
+    const absl::string_view continuation =
+        absl::string_view(text).substr(std::min(base.size(), text.size()));
+    if (filter_junk_ && IsJunkPrediction(text, continuation, reading)) return;
+    // 続きが 1 文字以下(「かしこま」+「ら」)は、語の途中で切れていることが多く、打つ手間も減らない。
+    if (min_continuation_chars_ > 0 &&
+        Util::CharsLen(continuation) < static_cast<size_t>(min_continuation_chars_)) {
+      return;
+    }
+    for (const Prediction& p : preds) {
+      if (p.text == text) return;
+    }
+    preds.push_back({text, base, covered, std::string()});
+  };
+  // 1. 読み全体の変換に、LLM で続きを付ける。
+  // 2. 最後の 1〜2 文字が打ちかけの場合(「おせわに」→「お世話」+「になっております」、
+  //    「きょうはいいて」→「今日はいい」+「天気」)。打ちかけを除いた変換に続きを付ける。
+  // 1 と 2 は 1 回のビームサーチでまとめて作る。
+  std::vector<std::pair<std::string, int>> roots;
+  std::vector<int> root_head;  // -1 なら読み全体、i なら heads[i]
+  if ((mode & 1) && n_beams > 0) {
+    roots.push_back({Tail(context) + conv, n_beams});
+    root_head.push_back(-1);
+  }
+  if ((mode & 2) && dictionary_ != nullptr && n_head_beams > 0) {
+    for (size_t i = 0; i < heads.size(); ++i) {
+      if (convs[i + 1].empty()) continue;
+      roots.push_back({Tail(context) + convs[i + 1], n_head_beams});
+      root_head.push_back(static_cast<int>(i));
+    }
+  }
+  const std::vector<std::vector<std::string>> conts =
+      llm->ContinueMany(roots, n_tokens);
+  for (size_t r = 0; r < conts.size(); ++r) {
+    if (root_head[r] < 0) {
+      for (const std::string& c : conts[r]) {
+        if (NaturalStart(c)) add(conv + c, conv, reading);
+      }
+      continue;
+    }
+    const size_t i = root_head[r];
+    const std::string& base = convs[i + 1];
+    for (const std::string& c : conts[r]) {
+      if (NaturalStart(c) &&
+          (light ||
+           MatchesReading(*dictionary_, single_kanji_, c, rests[i], true))) {
+        add(base + c, base, heads[i]);
+      }
+    }
+  }
+  std::vector<std::pair<std::string, std::string>> partial;  // (文, 土台)
+  std::vector<std::string> partial_covered;
+  for (size_t i = 0; i < heads.size() && (mode & 4); ++i) {
+    if (yield()) return preds;
+    const std::string& base = convs[i + 1];
+    if (base.empty() || dictionary_ == nullptr) continue;
+    const std::string& head = heads[i];
+    const std::string& rest = rests[i];
+    // その読みで始まる語を辞書から出やすい順に取り、LLM が文脈に合うものを選ぶ。
+    PredictiveCollector pc;
+    dictionary_->LookupPredictive(rest, &pc);
+    std::vector<std::pair<int, std::string>> words;
+    for (auto& [key, value, cost] : pc.tokens) {
+      if (Util::CharsLen(key) > Util::CharsLen(rest)) {
+        words.emplace_back(cost, value);
+      }
+    }
+    std::sort(words.begin(), words.end());
+    size_t taken = 0;
+    for (const auto& [cost, w] : words) {
+      const std::string v = base + w;
+      bool dup = false;
+      for (const auto& pp : partial) dup = dup || pp.first == v;
+      if (dup) continue;
+      partial.emplace_back(v, base);
+      partial_covered.push_back(head);
+      if (++taken >= 12) break;
+    }
+  }
+  if (!partial.empty() && !yield()) {
+    std::vector<std::string> texts;
+    for (const auto& pp : partial) texts.push_back(pp.first);
+    if (auto logp = llm->Score(context, reading, texts)) {
+      std::vector<size_t> order(texts.size());
+      std::iota(order.begin(), order.end(), 0);
+      std::stable_sort(order.begin(), order.end(), [&](size_t x, size_t y) {
+        return (*logp)[x] / Util::CharsLen(texts[x]) >
+               (*logp)[y] / Util::CharsLen(texts[y]);
+      });
+      for (size_t n = 0; n < std::min<size_t>(2, order.size()); ++n) {
+        const size_t i = order[n];
+        add(texts[i], partial[i].second, partial_covered[i]);
+        // いちばんよいものには、さらに続きを付ける。
+        if (n == 0 && !yield()) {
+          for (const std::string& c :
+               llm->Continue(Tail(context) + texts[i], predict_tokens_, 2)) {
+            if (NaturalStart(c)) {
+              add(texts[i] + c, partial[i].second, partial_covered[i]);
+            }
+          }
+        }
+      }
+    }
+  }
+  // 3. 前の文のもとでの自然さ(1 トークンあたりの log P)で並べる。軽い計算では省ける
+  //    (KOTORI_LM_LIGHT_RANK=0。続きのビームサーチの順のまま。docs/adr/0024)。
+  if (preds.size() >= 2 && (!light || light_rank_) && !yield()) {
+    std::vector<std::string> texts;
+    for (const Prediction& p : preds) texts.push_back(p.text);
+    if (auto logp = llm->Score(context, reading, texts)) {
+      std::vector<double> avg(preds.size());
+      for (size_t i = 0; i < preds.size(); ++i) {
+        avg[i] = (*logp)[i] / std::max<size_t>(1, llm->CountTokens(texts[i]));
+      }
+      std::vector<size_t> order(preds.size());
+      std::iota(order.begin(), order.end(), 0);
+      std::stable_sort(order.begin(), order.end(),
+                       [&](size_t x, size_t y) { return avg[x] > avg[y]; });
+      // Kotori: 初回表示では弱い予測を先頭にしない。これは正解確率ではなく、
+      // 自然さの絶対値と次点との差による保守的な採用条件。
+      const size_t best = order.front();
+      // Kotori: 全文の平均は並び替えだけに使う。初回表示の確信度は後で続きだけを採点。
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        std::fprintf(stderr, "[confidence] old full=%.3f margin=%.3f text=%s\n",
+                     avg[best], avg[best] - avg[order[1]], preds[best].text.c_str());
+      }
+      std::vector<Prediction> sorted;
+      for (size_t i : order) sorted.push_back(preds[i]);
+      preds = std::move(sorted);
+    }
+  }
+  // Kotori: 入力済み本文を確信度に混ぜない。同じ土台の続きを比較し、候補が1つでも
+  // 絶対値を検査する。辞書で完全な読みが求まるかは表示時に別に検査する。
+  for (size_t i = 0; i < preds.size() && !yield(); ++i) {
+    auto& p = preds[i];
+    if (p.covered != reading || !absl::StartsWith(p.text, conv) || p.base != conv) continue;
+    std::vector<std::string> continuations;
+    for (const auto& q : preds) {
+      if (q.base == p.base && q.covered == reading)
+        continuations.push_back(q.text.substr(q.base.size()));
+    }
+    if (auto scores = llm->Score(Tail(context) + p.base, "", continuations)) {
+      double best = -std::numeric_limits<double>::infinity();
+      double second = best;
+      size_t winner = 0;
+      for (size_t j = 0; j < scores->size(); ++j) {
+        const double avg = (*scores)[j] / std::max<size_t>(1, llm->CountTokens(continuations[j]));
+        if (avg > best) { second = best; best = avg; winner = j; }
+        else if (avg > second) second = avg;
+      }
+      const auto chosen = std::find_if(preds.begin(), preds.end(), [&](const Prediction& q) {
+        return q.base == p.base && q.text == p.base + continuations[winner];
+      });
+      if (chosen != preds.end()) chosen->can_lead = std::isfinite(best) && best >= -1.4 && best - second >= 0.5 &&
+          !kotori_internal::HasRepeatedContinuation(chosen->base, continuations[winner]);
+      if (Env("KOTORI_LM_DEBUG") != nullptr)
+        std::fprintf(stderr, "[confidence] continuation=%.3f margin=%.3f lead=%d text=%s\n", best, best-second, chosen != preds.end() && chosen->can_lead, chosen == preds.end() ? "" : chosen->text.c_str());
+    }
+    break;  // 同じ土台は1回だけ採点する。
+  }
+  const auto tt2 = std::chrono::steady_clock::now();
+  // 上位の予測は、続きの読みを求めておく(打鍵ごとの確認を速くするため)。
+  if (dictionary_ != nullptr) {
+    const size_t n = light ? 3 : 6;
+    for (size_t i = 0; i < preds.size() && i < n && !yield(); ++i) {
+      const std::string cont = preds[i].text.substr(preds[i].base.size());
+      const std::string y = ReadingOf(*dictionary_, single_kanji_, cont);
+      if (!y.empty()) preds[i].yomi = preds[i].covered + y;
+    }
+    if (light) {
+      // 軽い計算では、読みが求まって今の読みで始まるものだけを残す。
+      std::vector<Prediction> kept;
+      for (Prediction& p : preds) {
+        if (!p.yomi.empty() && absl::StartsWith(p.yomi, reading)) {
+          kept.push_back(std::move(p));
+        }
+      }
+      preds = std::move(kept);
+    }
+  }
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    auto ms = [](auto a, auto z) {
+      return std::chrono::duration<double, std::milli>(z - a).count();
+    };
+    std::fprintf(stderr, "[ptime] %s conv=%.0f gen+rank=%.0f yomi=%.0f\n",
+                 light ? "bg" : background ? "bg-full" : "fg", ms(tt0, tt1),
+                 ms(tt1, tt2),
+                 ms(tt2, std::chrono::steady_clock::now()));
+  }
+  return preds;
+}
+
+bool LmRewriter::PredictionFits(const Prediction& p,
+                                const std::string& reading) const {
+  if (!Util::IsValidUtf8(p.text) || !Util::IsValidUtf8(p.base) ||
+      !Util::IsValidUtf8(p.covered) || !Util::IsValidUtf8(p.yomi) ||
+      !absl::StartsWith(reading, p.covered) ||
+      !absl::StartsWith(p.text, p.base)) {
+    return false;
+  }
+  const std::string needed = reading.substr(p.covered.size());
+  if (needed.empty()) return true;
+  // 読みを求めてあれば文字列の比較だけで決める(打鍵ごとに辞書を引かない)。
+  return !p.yomi.empty() && absl::StartsWith(p.yomi, reading);
+}
+
+void LmRewriter::InsertPredictions(Segment* seg, const std::string& reading,
+                                   const std::vector<std::string>& texts,
+                                   const std::vector<bool>& from_ai) const {
+  converter::Candidate base;
+  if (seg->candidates_size() > 0) base = seg->candidate(0);
+  for (size_t i = 0; i < texts.size(); ++i) {
+    std::optional<converter::Candidate> existing;
+    for (size_t j = 0; j < seg->candidates_size(); ++j) {
+      if (seg->candidate(j).value == texts[i]) {
+        existing = seg->candidate(j);
+        seg->erase_candidate(j);
+        break;
+      }
+    }
+    converter::Candidate c = existing.value_or(base);
+    c.kotori_confident_prediction = false;
+    c.kotori_ai_evaluated = false;
+    if (!existing) {
+      c.key = reading;
+      c.content_key = reading;
+      c.value = texts[i];
+      c.content_value = texts[i];
+      c.consumed_key_size = Util::CharsLen(reading);
+      c.inner_segment_boundary.clear();
+      c.prefix.clear();
+      c.suffix.clear();
+    }
+    if (from_ai[i] && !existing) c.description = "AI";
+    *seg->insert_candidate(static_cast<int>(i)) = std::move(c);
+  }
+}
+
+bool LmRewriter::RewritePrediction(const ConversionRequest& request,
+                                   Segments* segments) const {
+  if (!predict_ || segments->conversion_segments_size() != 1) return false;
+  if (!request.config().kotori_lm_predict()) return false;
+  // シークレットモードでは AI の予測を作らず、覚えておいた予測も使わない。
+  if (request.incognito_mode()) return false;
+  Segment& seg = *segments->mutable_conversion_segment(0);
+  const std::string reading(seg.key());
+  const size_t len = Util::CharsLen(reading);
+  if (len < 2 || len > kMaxPredictChars) return false;
+  const auto t0 = std::chrono::steady_clock::now();
+  const std::string context = HistoryContext(request, *segments);
+  const std::string key = CacheKey(request.config(), context);
+  std::string conv;
+  // 入力中の候補のために裏で計算した予測があれば使う(Tab を待たせない)。なければ計算する。
+  // その場の計算には時間の上限を設け、超えたら Mozc の予測だけを出す(案 03)。
+  std::vector<Prediction> preds = CachedPredictions(reading, key, 6);
+  const bool from_cache = !preds.empty();
+  if (!from_cache) {
+    const auto deadline = tab_budget_ms_ > 0
+                              ? t0 + std::chrono::milliseconds(tab_budget_ms_)
+                              : std::chrono::steady_clock::time_point::max();
+    preds = ComputePredictions(request.config(), reading, context, &conv, false,
+                               false, deadline);
+    if (tab_budget_ms_ > 0 && std::chrono::steady_clock::now() > deadline) {
+      return false;  // 途中でやめた予測は出さず、覚えない
+    }
+    StorePredictions(reading, key, preds);
+  }
+  size_t k = 0, llm_top = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  PrepareFor(request.config(), &k, &llm, &beams, &llm_top, true, sync_load_);
+  if (llm == nullptr) return false;
+  const auto evaluated = EvaluatedPredictionBase(request, reading, context);
+  // Mozc 自身の予測候補(上位 8 件)と読みの変換も加え、1 トークンあたりの log P で並べる。
+  std::vector<std::string> pool;
+  std::vector<bool> from_ai;
+  for (const Prediction& p : preds) {
+    pool.push_back(p.text);
+    from_ai.push_back(true);
+  }
+  for (size_t j = 0; j < seg.candidates_size() && j < 8; ++j) {
+    const std::string& v = seg.candidate(j).value;
+    if (std::find(pool.begin(), pool.end(), v) == pool.end()) {
+      pool.push_back(v);
+      from_ai.push_back(false);
+    }
+  }
+  if (!conv.empty() && std::find(pool.begin(), pool.end(), conv) == pool.end()) {
+    pool.push_back(conv);
+    from_ai.push_back(true);
+  }
+  if (evaluated && std::find(pool.begin(), pool.end(), *evaluated) == pool.end()) {
+    pool.push_back(*evaluated);
+    from_ai.push_back(true);
+  }
+  std::vector<std::string> ranked;
+  std::vector<bool> ranked_ai;
+  if (auto logp = llm->Score(context, reading, pool)) {
+    std::vector<size_t> order;
+    std::vector<double> avg(pool.size());
+    for (size_t i = 0; i < pool.size(); ++i) {
+      // Kotori: 初回評価済みの「じゅうじ→１０時」は数字の混入ではない。
+      // 未評価の数字や、勝手に数字を変えた予測には従来の制限を残す。
+      if (HasDigit(pool[i]) && !HasDigit(reading) &&
+          (!evaluated || pool[i] != *evaluated)) continue;
+      // 先頭に並べる枠には、ゴミ(IsJunkPrediction)と、読みのまま変換されていないものを入れない。
+      // Mozc の候補なら、先頭に出さないだけで、Mozc の候補の一覧には元の位置で残る。
+      if (filter_junk_ &&
+          (pool[i] == reading || IsJunkPrediction(pool[i], "", reading))) {
+        continue;
+      }
+      avg[i] = (*logp)[i] / std::max<size_t>(1, llm->CountTokens(pool[i]));
+      order.push_back(i);
+    }
+    std::stable_sort(order.begin(), order.end(),
+                     [&](size_t x, size_t y) { return avg[x] > avg[y]; });
+    for (size_t i : order) {
+      ranked.push_back(pool[i]);
+      ranked_ai.push_back(from_ai[i]);
+    }
+  }
+  if (evaluated) {
+    // Kotori: 本文を保持し、初回表示と同じ採用条件を満たす続きだけを先頭へ。
+    // 弱い予測や別表記は、明示的に選べる候補として一覧に残す。
+    std::string leading = *evaluated;
+    for (const std::string& value : ranked) {
+      const auto strong =
+          std::find_if(preds.begin(), preds.end(), [&](const Prediction& p) {
+            return p.text == value && p.can_lead && !p.yomi.empty() &&
+                   absl::StartsWith(p.yomi, reading) &&
+                   absl::StartsWith(p.text, *evaluated);
+          });
+      if (strong != preds.end()) {
+        leading = value;
+        break;
+      }
+    }
+    const auto old = std::find(ranked.begin(), ranked.end(), leading);
+    if (old != ranked.end()) {
+      const auto index = old - ranked.begin();
+      ranked.erase(old);
+      ranked_ai.erase(ranked_ai.begin() + index);
+    }
+    ranked.insert(ranked.begin(), leading);
+    ranked_ai.insert(ranked_ai.begin(), true);
+    // 採点中の取消・設定切替等で失効した補正文を追加しない。
+    if (EvaluatedPredictionBase(request, reading, context) != evaluated)
+      return false;
+  }
+  const size_t shown = std::min<size_t>(
+      ranked.size(), tab_show_ > 0 ? tab_show_ : predict_beams_ + 1);
+  ranked.resize(shown);
+  ranked_ai.resize(shown);
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(
+        stderr, "[predict] %.0fms pool=%zu shown=%zu cache=%d\n",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - t0)
+            .count(),
+        pool.size(), shown, from_cache ? 1 : 0);
+  }
+  if (shown == 0) return false;
+  InsertPredictions(&seg, reading, ranked, ranked_ai);
+  return true;
+}
+
+void LmRewriter::StorePredictions(const std::string& reading,
+                                  const std::string& context,
+                                  const std::vector<Prediction>& preds) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  for (auto it = cache_.begin(); it != cache_.end(); ++it) {
+    if (it->reading == reading && it->context == context) {
+      cache_.erase(it);
+      break;
+    }
+  }
+  cache_.push_back({reading, context, preds});
+  while (cache_.size() > 32) cache_.pop_front();
+}
+
+std::vector<LmRewriter::Prediction> LmRewriter::CachedPredictions(
+    const std::string& reading, const std::string& context, size_t max) const {
+  std::vector<Entry> entries;
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    entries.assign(cache_.begin(), cache_.end());
+  }
+  std::stable_sort(entries.begin(), entries.end(),
+                   [](const Entry& x, const Entry& y) {
+                     return x.reading.size() > y.reading.size();
+                   });
+  std::vector<Prediction> out;
+  for (const Entry& e : entries) {
+    if (e.context != context || !absl::StartsWith(reading, e.reading)) continue;
+    for (const Prediction& p : e.preds) {
+      if (out.size() >= max) break;
+      const bool dup = std::any_of(out.begin(), out.end(), [&](const Prediction& q) {
+        return q.text == p.text;
+      });
+      if (!dup && PredictionFits(p, reading)) out.push_back(p);
+    }
+    if (out.size() >= max) break;
+  }
+  return out;
+}
+
+bool LmRewriter::RewriteSuggestion(const ConversionRequest& request,
+                                   Segments* segments) const {
+  if (segments->conversion_segments_size() != 1) return false;
+  const config::Config& config = request.config();
+  // AI を切ったとき・シークレットモードでは、覚えておいた予測を捨て、新しく作らない(案 04)。
+  if (!config.kotori_lm_enabled() || request.incognito_mode() ||
+      request.context().input_field_type() == commands::Context::PASSWORD) {
+    ClearPredictions();
+    std::lock_guard<std::mutex> lock(job_mu_);
+    job_.reset();
+    new_job_ = true;
+    memo_.clear();
+    return false;
+  }
+  Segment& seg = *segments->mutable_conversion_segment(0);
+  const std::string reading(seg.key());
+  const std::vector<std::string> rchars = Chars(reading);
+  // 打ちかけのローマ字(「おせわn」)が残っているときは使わない。
+  if (rchars.size() < 2 || rchars.back().size() == 1) return false;
+  const std::string context = HistoryContext(request, *segments);
+  bool preview_pending = false;
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    const std::string memo_key = MemoKey(config, reading, context);
+    const auto& input = request.kotori_input_generation();
+    preview_pending = (running_preview_ == memo_key &&
+                       running_preview_input_.IsSame(input)) ||
+        (job_ && job_->preview && job_->input_generation.IsSame(input) &&
+         MemoKey(job_->config, job_->reading, job_->context) == memo_key);
+  }
+  // LLM の予測を使わない(GPU がない、など)ときは、今の読みの変換を裏で先に済ませておく
+  // (先回りの変換。Space で待たせないため。docs/adr/0024)。
+  if (!(predict_ && config.kotori_lm_predict() && UsesLlm(config))) {
+    ClearPredictions();
+    if (preview_pending) return false;
+    if (preconvert_ && rchars.size() <= kMaxGenerateChars &&
+        (HasGpu() || rchars.size() <= kMaxCpuChars)) {
+      std::lock_guard<std::mutex> lock(job_mu_);
+      job_ = Job{reading, context, config, true};
+      new_job_ = true;
+      job_cv_.notify_one();
+    } else {
+      new_job_ = true;  // 前の読みの先回りの変換をやめる
+    }
+    return false;
+  }
+  // 1. 計算済みの予測のうち、今の読みに合うものを出す(読みの長いものから)。
+  const std::string key = CacheKey(config, context);
+  std::vector<std::string> texts;
+  const auto evaluated = EvaluatedPredictionBase(request, reading, context);
+  // Kotori: 全文平均点1位とは別の候補が強い続きになり得る。表示件数で
+  // キャッシュを先に切るとTabだけにその強い候補が出るため、採用判定後に制限する。
+  for (const Prediction& p : CachedPredictions(reading, key, 6)) {
+    if (evaluated && p.can_lead && !p.yomi.empty() &&
+        absl::StartsWith(p.yomi, reading) && absl::StartsWith(p.text, *evaluated)) {
+      texts.push_back(p.text);
+      if (texts.size() >= suggest_count_) break;
+    }
+  }
+  // 2. 今の読みの予測を裏で計算させる(待たない)。長い読みは計算しない。
+  if (!preview_pending && rchars.size() <= kMaxPredictChars) {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    bool cached = false;
+    for (const Entry& e : cache_) {
+      cached = cached || (e.reading == reading && e.context == key);
+    }
+    if (!cached) {
+      job_ = Job{reading, context, config};
+      new_job_ = true;
+      job_cv_.notify_one();
+    }
+  }
+  if (Env("KOTORI_LM_STATS") != nullptr) {
+    std::fprintf(stderr, "[stats] %s\n", ZenzScorer::Stats().c_str());
+  }
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    std::fprintf(stderr, "[suggest] %s cache=%zu shown=%zu\n", reading.c_str(),
+                 cache_.size(), texts.size());
+  }
+  if (texts.empty()) return false;
+  InsertPredictions(&seg, reading, texts, std::vector<bool>(texts.size(), true));
+  for (size_t i = 0; i < texts.size(); ++i) {
+    seg.mutable_candidate(i)->kotori_confident_prediction = true;
+  }
+  return true;
+}
+
+void LmRewriter::RunPreconvert(const Job& job) {
+  // 続けて打っている間は計算しない(CPU では 1 回の生成が打鍵の間隔より長い)。
+  {
+    std::unique_lock<std::mutex> lock(job_mu_);
+    if (job_cv_.wait_for(lock, std::chrono::milliseconds(preconvert_delay_ms_),
+                         [&] { return stop_ || job_.has_value(); })) {
+      return;
+    }
+  }
+  const std::string key = job.reading + "\t" + job.context;
+  // 要求(変換・Tab)の最中と、終わってから 150 ms はロックを取らない(続けて来る要求を待たせない)。
+  auto now_us = [] {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  };
+  while (urgent_.load() > 0 || now_us() - last_request_us_.load() < 150000) {
+    if (stop_.load() || new_job_.load()) return;
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    if (last_converted_key_ == key) return;  // もう変換した読み
+    running_convert_ = key;
+  }
+  // 新しい打鍵・停止、または別の読みの変換の要求が来たらやめる(同じ読みの変換なら続ける)。
+  auto cancelled = [&] {
+    if (stop_.load() || new_job_.load()) return true;
+    if (urgent_.load() == 0) return false;
+    std::lock_guard<std::mutex> lock(job_mu_);
+    return urgent_key_ != key;
+  };
+  {
+    absl::MutexLock lock(mutex_);
+    size_t k = 0, llm_top = 0;
+    int beams = 0;
+    ZenzScorer* llm = nullptr;
+    ZenzScorer* scorer = PrepareFor(job.config, &k, &llm, &beams, &llm_top,
+                                    false, true, Util::CharsLen(job.reading));
+    if (scorer != nullptr && beams > 0 &&
+        !(gen_cache_ && gen_cache_->key == key && gen_cache_->beams == beams &&
+          gen_cache_->model == ModelKey(scorer))) {
+      std::vector<std::string> texts;
+      {
+        CancelScope cancel(cancelled);
+        texts = scorer->Generate(job.context, job.reading, beams);
+      }
+      if (!cancelled()) gen_cache_ = Generated{key, beams, ModelKey(scorer), texts};
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    running_convert_.clear();
+  }
+}
+
+void LmRewriter::WorkerLoop() {
+  // 最後に受けた設定(入力がないときにモデルを外し、状態を書くのに使う)。
+  std::optional<config::Config> last_config;
+  int64_t last_status_us = 0;
+  bool status_pending = false;
+  while (true) {
+    // Kotori: 状態ファイルの書き込みは非同期ワーカーだけで毎秒最大1回。
+    if (last_config && SteadyNowUs() - last_status_us >= 1000000 && mutex_.TryLock()) {
+      WriteStatus(*last_config, sleeping_.load() ? "sleep" : "ready");
+      mutex_.Unlock();
+      last_status_us = SteadyNowUs();
+      status_pending = false;
+    }
+    Job job;
+    {
+      std::unique_lock<std::mutex> lock(job_mu_);
+      const auto ready = [&] {
+        return stop_ || job_.has_value() || load_job_.has_value();
+      };
+      // 仕事がなければ 30 秒ごとに、しばらく入力がないかを見てモデルを外す(docs/adr/0034)。
+      while (!job_cv_.wait_for(lock, status_pending ? std::chrono::milliseconds(1000) : std::chrono::milliseconds(30000), ready)) {
+        if (!last_config) continue;
+        lock.unlock();
+        UnloadIfIdle(*last_config);
+        if (mutex_.TryLock()) {
+          WriteStatus(*last_config, sleeping_.load() ? "sleep" : "ready");
+          mutex_.Unlock();
+          last_status_us = SteadyNowUs();
+          status_pending = false;
+        }
+        lock.lock();
+      }
+      if (stop_) return;
+      if (load_job_) {
+        // モデルの読み込み。読み込み中の変換は待たずに AI なしで出す(TryLockForRequest)。
+        const config::Config config = std::move(*load_job_);
+        load_job_.reset();
+        last_config = config;
+        sleeping_ = false;
+        lock.unlock();
+        loading_ = true;
+        {
+          absl::MutexLock model_lock(mutex_);
+          WriteStatus(config, "loading");
+          size_t k = 0, llm_top = 0;
+          int beams = 0;
+          ZenzScorer* llm = nullptr;
+          PrepareFor(config, &k, &llm, &beams, &llm_top, false, true);
+          // GPU のない PC では、長い読みに使う zenz も読み込んでおく(docs/adr/0035)。
+          PrepareFor(config, &k, &llm, &beams, &llm_top, false, true, SIZE_MAX);
+          // 入力中の AI 予測を使うなら、予測の LLM も読み込んでおく。
+          if (predict_ && config.kotori_lm_predict()) {
+            PrepareFor(config, &k, &llm, &beams, &llm_top, true, true);
+          }
+          WriteStatus(config, "ready");
+        }
+        loading_ = false;
+        continue;
+      }
+      job = std::move(*job_);
+      job_.reset();
+      new_job_ = false;
+      if (job.preview) {
+        running_preview_ = MemoKey(job.config, job.reading, job.context);
+        running_preview_input_ = job.input_generation;
+      }
+    }
+    last_config = job.config;
+    status_pending = true;
+    if (job.preview) {
+      ConversionRequest::Options options;
+      options.request_type = ConversionRequest::CONVERSION;
+      const ConversionRequest request = ConversionRequestBuilder()
+          .SetConfigView(job.config)
+          .SetKotoriInputGeneration(job.input_generation)
+          .SetOptions(options).Build();
+      SelectSentence(request, *job.preview, job.reading, job.context,
+                     job.reading + "\t" + job.context, true);
+      std::lock_guard<std::mutex> lock(job_mu_);
+      running_preview_.clear();
+      running_preview_input_ = {};
+      continue;
+    }
+    if (job.convert) {
+      RunPreconvert(job);
+      continue;
+    }
+    // 途中でやめたか(変換の要求・停止、重い計算は次の打鍵も)。やめたときは結果を残さない。
+    auto interrupted = [&](bool light) {
+      return urgent_.load() > 0 || stop_.load() || (!light && new_job_.load());
+    };
+    // 1. 軽い計算(次の打鍵に間に合わせる)。2. 手が止まっていれば、Tab と同じ重さで
+    //    作り直す(Tab を押したときに、待たずに良い予測を出せる)。
+    // ms の間に次の打鍵(新しい仕事)が来なければ true。来たら false(その仕事から始め直す)。
+    auto quiet_for = [&](int ms) {
+      if (ms <= 0) return !new_job_.load() && !stop_.load();
+      std::unique_lock<std::mutex> lock(job_mu_);
+      return !job_cv_.wait_for(lock, std::chrono::milliseconds(ms),
+                               [&] { return stop_ || job_.has_value(); });
+    };
+    bool retried = false;  // 取り直しで止められた計算を 1 回だけやり直す
+    bool redo = false;
+    for (int step = 0; step < 2; ++step) {
+      if (redo) {
+        --step;  // 同じ段をやり直す(待ちは入れない)
+      }
+      const bool light = step == 0;
+      // 続けて打っている間は計算しない(打鍵ごとの計算の多くは次の打鍵で要らなくなる)。
+      // 作り直しは、手が止まってから(docs/adr/0024)。
+      const int delay = redo ? 0 : (light ? light_delay_ms_ : full_delay_ms_);
+      redo = false;
+      if (delay < 0 || !quiet_for(delay)) break;
+      std::vector<Prediction> preds;
+      {
+        absl::MutexLock lock(mutex_);
+        preds = ComputePredictions(job.config, job.reading, job.context, nullptr,
+                                   true, light);
+      }
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        std::fprintf(stderr, "[worker%s] %s -> %zu preds%s%s%s\n",
+                     light ? "" : " full", job.reading.c_str(), preds.size(),
+                     preds.empty() ? "" : " first=",
+                     preds.empty() ? "" : preds[0].text.c_str(),
+                     interrupted(light) ? " (interrupted)" : "");
+      }
+      if (interrupted(light)) {
+        // Kotori: 入力中の候補の取り直し(変換の要求)で止められただけなら、それが終わってから
+        // 同じ計算をやり直す(手が止まっている間に予測を出すため。docs/adr/0039)。
+        if (retried || stop_.load() || new_job_.load()) break;
+        retried = true;
+        while (urgent_.load() > 0 && !stop_.load() && !new_job_.load()) {
+          std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        if (stop_.load() || new_job_.load()) break;
+        redo = true;
+        continue;
+      }
+      StorePredictions(job.reading, CacheKey(job.config, job.context), preds);
+    }
+  }
+}
+
+bool LmRewriter::Rewrite(const ConversionRequest& request,
+                         Segments* segments) const {
+  Touch(request.config());
+  if (request.request_type() == ConversionRequest::SUGGESTION) {
+    return RewriteSuggestion(request, segments);
+  }
+  // サジェストのための変換(1 打鍵ごと)では、AI の変換を動かさない(入力が重くなるため)。
+  if (request.options().skip_slow_rewriters) return false;
+  if (!request.config().kotori_lm_enabled() || request.incognito_mode()) return false;
+  // Kotori: 文全体で選んだ結果を覚えていれば、ロックを取らずに当てはめる(入力中の候補の取り直しと、
+  // その後の Space。docs/adr/0039)。取り直しでは文節ごとの見直しもしない(先頭だけ使う)。
+  if (sentence_ && request.request_type() == ConversionRequest::CONVERSION) {
+    const std::string context = HistoryContext(request, *segments);
+    const auto memo = FindMemo(
+        MemoKey(request.config(), ConversionReading(*segments), context), request);
+    bool changed = false;
+    if (memo && *memo && ApplyBestFrom(**memo, request, segments, context, &changed) &&
+        (!post_segment_ || request.options().kotori_preview)) {
+      return changed;
+    }
+    if (request.options().kotori_preview) return changed;
+  }
+  // LLM がないときの Tab、GPU がなく長い読みでは AI を使わないので、ロックを待たない。
+  if (request.request_type() == ConversionRequest::PREDICTION &&
+      !(predict_ && request.config().kotori_lm_predict() &&
+        UsesLlm(request.config()))) {
+    return false;
+  }
+  if (!HasGpu() && Util::CharsLen(ConversionReading(*segments)) > kMaxCpuChars) {
+    return false;
+  }
+  Urgent urgent(urgent_, last_request_us_);
+  if (!TryLockForRequest(300)) return false;
+  HeldLock lock(mutex_);
+  if (request.request_type() == ConversionRequest::PREDICTION) {
+    return RewritePrediction(request, segments);
+  }
+  size_t k = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = Prepare(request, &k, &llm, &beams);
+  if (scorer == nullptr) return false;
+  // 文全体で選んだ文が今の区切りに合えば、それを先頭に置く。
+  bool changed = false;
+  const bool matched =
+      sentence_ &&
+      ApplyBest(request, segments, HistoryContext(request, *segments), &changed);
+  if (matched && !post_segment_) return changed;
+  // 文節が多いと、文節ごとの採点(文節ごとに 1 回)で数秒かかる。文全体の選択だけにする。
+  if (segments->conversion_segments_size() > kMaxSegmentsToRescore) return changed;
+  // GPU がなければ文節ごとの採点(文節ごとに 1 回、右の文脈を含む)はしない。CPU では時間の上限に
+  // 収まらないため(docs/adr/0029)。
+  if (!HasGpu()) return changed;
+  // 文節ごとにも見直す。文全体で選んだときは(LLM も見て決めたので)先頭は変えず、
+  // 2 番目以降の候補だけを並べる。時間の上限を超えたら残りの文節はそのまま。
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::milliseconds(BudgetMs());
+  return RewriteEachSegment(request, scorer, k, matched, deadline, segments) ||
+         changed;
+}
+
+bool LmRewriter::FindLlmCorrection(ZenzScorer* scorer, ZenzScorer* llm,
+                                  const std::string& context,
+                                  const std::string& reading,
+                                  const std::string& chosen, double chosen_score,
+                                  const std::function<bool()>& over,
+                                  std::string* fixed) const {
+  if (dictionary_ == nullptr) return false;
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] correction=attempt\n");
+  }
+  const char* prompt = Env("KOTORI_LM_CORRECTION_PROMPT");
+  if (prompt != nullptr && std::string(prompt) != "examples" &&
+      std::string(prompt) != "typing" && std::string(prompt) != "chat") return false;
+  kotori_internal::CorrectionOptions options;
+  options.zenz_weight = lambda_lm_;
+  options.llm_weight = lambda_llm_;
+  options.margin = typo_margin_;
+  if (prompt != nullptr && std::string(prompt) == "chat") {
+    options.prompt = ZenzScorer::CorrectionPrompt::kChat;
+  } else if (prompt != nullptr && std::string(prompt) == "examples") {
+    options.prompt = ZenzScorer::CorrectionPrompt::kExamples;
+  }
+  const auto corrected = kotori_internal::GenerateSafeCorrection(
+      *dictionary_, pos_matcher_, scorer, llm, context, reading, chosen,
+      chosen_score, options, over);
+  if (!corrected) return false;
+  *fixed = *corrected;
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    // 開発試験で生成補正の寄与を区別する。本文は追加で記録しない。
+    std::fprintf(stderr, "[kotori] correction=adopted\n");
+  }
+  return true;
+}
+
+bool LmRewriter::FindTypoCorrection(ZenzScorer* scorer, ZenzScorer* llm,
+                                    const std::string& context,
+                                    const std::string& reading,
+                                    const std::string& chosen, double chosen_score,
+                                    const std::function<bool()>& over,
+                                    std::string* fixed) const {
+  const auto t0 = std::chrono::steady_clock::now();
+  // 選んだ文が十分に自然なら(読み 1 文字あたりの点が typo_gate_ 以上)、試さない。打ち間違いのある
+  // 読みの文は不自然になりやすい。ふつうの文で毎回試すと、Space が遅くなるため。
+  const double per_char = chosen_score / std::max<size_t>(1, Util::CharsLen(reading));
+  absl::flat_hash_map<std::string, std::vector<std::pair<size_t, int>>> cache;
+  const int base = ReadingCost(*dictionary_, reading, &cache);
+  std::vector<std::pair<int, std::string>> ranked;
+  int best_cost = base;
+  for (std::string& v : TypoVariants(Chars(reading))) {
+    const int c = ReadingCost(*dictionary_, v, &cache);
+    best_cost = std::min(best_cost, c);
+    if (c <= base - typo_gain_) ranked.emplace_back(c, std::move(v));
+  }
+  // 選んだ文が十分に自然なら試さない。ただし、読みを書き換えると辞書のコストが大きく下がる
+  // (typo_strong_gain_ 以上)ときは試す(zenz が打ち間違いの読みをそのまま写した文を高く見ることがある)。
+  if (per_char >= typo_gate_ && base - best_cost < typo_strong_gain_) {
+    if (Env("KOTORI_LM_DEBUG") != nullptr || Env("KOTORI_LM_TIME") != nullptr) {
+      std::fprintf(stderr, "[typo] %s gate per_char=%.2f gain=%d %.0fms\n", reading.c_str(),
+                   per_char, base - best_cost,
+                   std::chrono::duration<double, std::milli>(
+                       std::chrono::steady_clock::now() - t0).count());
+    }
+    return false;
+  }
+  if (ranked.empty() || over()) {
+    if (Env("KOTORI_LM_DEBUG") != nullptr || Env("KOTORI_LM_TIME") != nullptr) {
+      std::fprintf(stderr, "[typo] %s cost=%d no variant\n", reading.c_str(), base);
+    }
+    return false;
+  }
+  std::stable_sort(ranked.begin(), ranked.end(),
+                   [](const auto& a, const auto& b) { return a.first < b.first; });
+  if (ranked.size() > static_cast<size_t>(typo_k_)) ranked.resize(typo_k_);
+  std::vector<std::string> readings;
+  for (const auto& [c, v] : ranked) readings.push_back(v);
+  // 1 回のビームサーチで扱える列の数に上限があるので、5 つずつ生成する。
+  std::vector<std::vector<std::string>> gens;
+  {
+    CancelScope cancel(over);
+    for (size_t i = 0; i < readings.size() && !over(); i += 5) {
+      const std::vector<std::string> part(
+          readings.begin() + i, readings.begin() + std::min(readings.size(), i + 5));
+      for (auto& g : scorer->GenerateMany(context, part, 2)) gens.push_back(std::move(g));
+    }
+  }
+  if (over()) return false;
+  // 書き換えた読みごとに、生成した文(辞書で読みに合うもの)の zenz の点を、その読みで取る。
+  std::vector<std::string> texts;
+  std::vector<double> zs;
+  for (size_t i = 0; i < gens.size() && i < readings.size(); ++i) {
+    for (const std::string& g : gens[i]) {
+      if (g == chosen || std::find(texts.begin(), texts.end(), g) != texts.end() ||
+          !MatchesReading(*dictionary_, single_kanji_, g, readings[i])) {
+        continue;
+      }
+      const std::optional<std::vector<float>> z = scorer->Score(context, readings[i], {g});
+      if (!z) continue;
+      texts.push_back(g);
+      zs.push_back((*z)[0]);
+      break;
+    }
+  }
+  if (texts.empty() || over()) {
+    if (Env("KOTORI_LM_DEBUG") != nullptr || Env("KOTORI_LM_TIME") != nullptr) {
+      std::fprintf(stderr, "[typo] %s variants=%zu no text (over=%d)\n", reading.c_str(),
+                   ranked.size(), over() ? 1 : 0);
+      for (size_t i = 0; i < gens.size() && i < readings.size(); ++i) {
+        for (const std::string& g : gens[i]) {
+          std::fprintf(stderr, "[typo]   %s -> %s\n", readings[i].c_str(), g.c_str());
+        }
+      }
+    }
+    return false;
+  }
+  const std::optional<std::vector<float>> lp = llm->Score(context, reading, texts);
+  if (!lp) return false;
+  size_t top = 0;
+  double top_score = -std::numeric_limits<double>::infinity();
+  for (size_t i = 0; i < texts.size(); ++i) {
+    const double s = lambda_lm_ * zs[i] + lambda_llm_ * (*lp)[i];
+    if (s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+  const double base_lp = chosen_score;
+  const bool apply = top_score - base_lp >= typo_margin_;
+  if (Env("KOTORI_LM_DEBUG") != nullptr || Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(stderr, "[typo] %s cost=%d variants=%zu gen=%zu best=%s %.2f vs %.2f %s %.0fms\n",
+                 reading.c_str(), base, ranked.size(), texts.size(),
+                 texts[top].c_str(), top_score, base_lp, apply ? "APPLY" : "keep",
+                 std::chrono::duration<double, std::milli>(
+                     std::chrono::steady_clock::now() - t0).count());
+  }
+  if (!apply) return false;
+  *fixed = texts[top];
+  return true;
+}
