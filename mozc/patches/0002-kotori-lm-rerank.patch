diff --git a/src/renderer/win32/kotori_candidate_snapshot.cc b/src/renderer/win32/kotori_candidate_snapshot.cc
new file mode 100644
index 000000000..97c6109f1
--- /dev/null
+++ b/src/renderer/win32/kotori_candidate_snapshot.cc
@@ -0,0 +1,73 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+// Kotori: 実際の候補描画を、非表示の専用ウィンドウで BMP に出す確認用ツール。
+// 実行中の IME や入力先アプリには接続しない。
+#include <windows.h>
+
+#include <cstdlib>
+#include <fstream>
+#include <vector>
+
+#include "base/coordinates.h"
+#include "protocol/candidate_window.pb.h"
+#include "renderer/win32/candidate_window.h"
+
+int main(int argc, char** argv) {
+  if (argc != 3) return 1;  // 出力 BMP、DPI
+  const int dpi = std::atoi(argv[2]);
+  if (dpi < 96 || dpi > 384) return 1;
+  SetProcessDPIAware();
+  mozc::renderer::win32::CandidateWindow window;
+  if (!window.Create(nullptr)) return 2;
+  window.UpdateDpi(dpi);
+  mozc::commands::CandidateWindow candidates;
+  candidates.set_size(3);
+  candidates.set_page_size(9);
+  candidates.set_focused_index(0);
+  candidates.set_category(mozc::commands::CONVERSION);
+  int index = 0;
+  for (const char* value : {"足を痛めたので", "足を傷めたので", "あしをいためたので"}) {
+    auto* candidate = candidates.add_candidate();
+    candidate->set_index(index);
+    candidate->set_id(index++);
+    candidate->set_value(value);
+    candidate->mutable_annotation()->set_shortcut(std::to_string(index));
+  }
+  candidates.mutable_footer()->set_label("Kotori");
+  window.UpdateLayout(candidates);
+  const mozc::Size size = window.GetLayoutSize();
+  if (size.width <= 0 || size.height <= 0) return 3;
+  window.SetWindowPos(nullptr, 0, 0, size.width, size.height,
+                      SWP_NOACTIVATE | SWP_NOZORDER);
+  HDC screen = GetDC(nullptr);
+  HDC dc = CreateCompatibleDC(screen);
+  BITMAPINFO info = {};
+  info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+  info.bmiHeader.biWidth = size.width;
+  info.bmiHeader.biHeight = -size.height;
+  info.bmiHeader.biPlanes = 1;
+  info.bmiHeader.biBitCount = 32;
+  info.bmiHeader.biCompression = BI_RGB;
+  void* pixels = nullptr;
+  HBITMAP bitmap = CreateDIBSection(screen, &info, DIB_RGB_COLORS,
+                                   &pixels, nullptr, 0);
+  if (!bitmap || !dc) return 4;
+  HGDIOBJ old = SelectObject(dc, bitmap);
+  window.OnPrintClient(dc, PRF_CLIENT);
+  GdiFlush();
+  const DWORD bytes = size.width * size.height * 4;
+  BITMAPFILEHEADER header = {};
+  header.bfType = 0x4d42;
+  header.bfOffBits = sizeof(header) + sizeof(BITMAPINFOHEADER);
+  header.bfSize = header.bfOffBits + bytes;
+  std::ofstream output(argv[1], std::ios::binary);
+  output.write(reinterpret_cast<const char*>(&header), sizeof(header));
+  output.write(reinterpret_cast<const char*>(&info.bmiHeader), sizeof(BITMAPINFOHEADER));
+  output.write(static_cast<const char*>(pixels), bytes);
+  const bool ok = output.good();
+  SelectObject(dc, old);
+  DeleteObject(bitmap);
+  DeleteDC(dc);
+  ReleaseDC(nullptr, screen);
+  window.DestroyWindow();
+  return ok ? 0 : 5;
+}
