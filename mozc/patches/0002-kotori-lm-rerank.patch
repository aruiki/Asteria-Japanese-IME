+#ifndef MOZC_GUI_TOOL_KOTORI_SUPPORT_REMINDER_H_
+#define MOZC_GUI_TOOL_KOTORI_SUPPORT_REMINDER_H_
+#include <QSettings>
+#include <QString>
+#include <QUrl>
+#include <functional>
+namespace mozc::gui {
+inline constexpr qint64 kSupportWeekSeconds = 7 * 24 * 60 * 60;
+class SupportReminderState {
+ public:
+  explicit SupportReminderState(const QString &path) : settings_(path, QSettings::IniFormat) {}
+  bool Enabled();
+  bool Due(qint64 now);
+  bool Defer(qint64 now);
+  bool Disable();
+ private:
+  QSettings settings_;
+};
+// Kotori: Windowsから来た引数は固定アクションのみ受け付ける。
+bool HandleSupportAction(SupportReminderState &state, const QString &action,
+    qint64 now, const std::function<bool(const QUrl &)> &open);
+QString SupportToastXml();
+}  // namespace mozc::gui
+int RunKotoriSupportReminder(int argc, char *argv[]);
+int RunKotoriSupportActivation(int argc, char *argv[]);
+#endif
diff --git a/src/gui/tool/kotori_support_reminder_test.cc b/src/gui/tool/kotori_support_reminder_test.cc
new file mode 100644
index 000000000..8fa3b53ac
--- /dev/null
+++ b/src/gui/tool/kotori_support_reminder_test.cc
@@ -0,0 +1,70 @@
+#include "gui/tool/kotori_support_reminder.h"
+#include <QTemporaryDir>
+#include "testing/gunit.h"
+namespace mozc::gui {
+class SupportReminderTest : public testing::Test {
+ protected:
+  QString Path() { return dir_.filePath("support-reminder.ini"); }
+  QTemporaryDir dir_;
+};
+TEST_F(SupportReminderTest, NewProfileAndSevenDayBoundary) {
+  SupportReminderState state(Path());
+  EXPECT_TRUE(state.Due(100));
+  ASSERT_TRUE(state.Defer(100));
+  EXPECT_FALSE(state.Due(100 + kSupportWeekSeconds - 1));
+  EXPECT_TRUE(state.Due(100 + kSupportWeekSeconds));
+}
+TEST_F(SupportReminderTest, DeferSurvivesNewProcessAndClockRollback) {
+  { SupportReminderState state(Path()); ASSERT_TRUE(state.Defer(1000)); }
+  SupportReminderState reopened(Path());
+  EXPECT_FALSE(reopened.Due(999));
+  EXPECT_FALSE(reopened.Due(1000 + kSupportWeekSeconds - 1));
+  EXPECT_TRUE(reopened.Due(1000 + kSupportWeekSeconds));
+}
+TEST_F(SupportReminderTest, GithubSuccessPermanentlyStopsAndUsesFixedUrl) {
+  SupportReminderState state(Path());
+  QUrl opened;
+  ASSERT_TRUE(HandleSupportAction(state, "github", 100, [&](const QUrl &url) { opened = url; return true; }));
+  EXPECT_EQ(opened.toString(), QStringLiteral("https://github.com/aruiki/Asteria-Japanese-IME"));
+  SupportReminderState reopened(Path());
+  EXPECT_FALSE(reopened.Enabled());
+  EXPECT_FALSE(reopened.Due(100 + 100 * kSupportWeekSeconds));
+}
+TEST_F(SupportReminderTest, BrowserFailureAllowsRetry) {
+  SupportReminderState state(Path());
+  EXPECT_FALSE(HandleSupportAction(state, "github", 100, [](const QUrl &) { return false; }));
+  EXPECT_TRUE(state.Enabled());
+  EXPECT_TRUE(state.Due(100));
+}
+TEST_F(SupportReminderTest, NoDefersOneWeek) {
+  SupportReminderState state(Path());
+  EXPECT_TRUE(HandleSupportAction(state, "later", 200, [](const QUrl &) { ADD_FAILURE(); return false; }));
+  EXPECT_TRUE(state.Enabled());
+  EXPECT_FALSE(state.Due(200 + kSupportWeekSeconds - 1));
+  EXPECT_TRUE(state.Due(200 + kSupportWeekSeconds));
+}
+TEST_F(SupportReminderTest, StorageFailureDoesNotRepeatedlyPrompt) {
+  SupportReminderState state(dir_.path());
+  EXPECT_FALSE(state.Defer(100));
+  EXPECT_FALSE(state.Due(100));
+}
+TEST_F(SupportReminderTest, RejectsUnknownAndDisabledActions) {
+  SupportReminderState state(Path());
+  int opened = 0;
+  auto open = [&](const QUrl &) { ++opened; return true; };
+  EXPECT_FALSE(HandleSupportAction(state, "https://evil.example", 100, open));
+  EXPECT_TRUE(state.Due(100));
+  ASSERT_TRUE(state.Disable());
+  EXPECT_FALSE(HandleSupportAction(state, "github", 100, open));
+  EXPECT_FALSE(HandleSupportAction(state, "later", 100, open));
+  EXPECT_EQ(opened, 0);
+}
+TEST_F(SupportReminderTest, ToastHasNativeActionsAndSilentAudio) {
+  const QString xml = SupportToastXml();
+  EXPECT_TRUE(xml.contains("ToastGeneric"));
+  EXPECT_TRUE(xml.contains("arguments='github'"));
+  EXPECT_TRUE(xml.contains("arguments='later'"));
+  EXPECT_TRUE(xml.contains("silent='true'"));
+  EXPECT_FALSE(xml.contains("activationType='protocol'"));
+}
+}  // namespace mozc::gui
