+void ApplyKotoriPalette(RendererStyle* style, bool high_contrast, bool dark) {
+  auto set = [](RendererStyle::RGBAColor* c, COLORREF v) { c->set_r(GetRValue(v)); c->set_g(GetGValue(v)); c->set_b(GetBValue(v)); };
+  if (!high_contrast && !dark) return;
+  const COLORREF background = high_contrast ? ::GetSysColor(COLOR_WINDOW) : RGB(32,32,32);
+  const COLORREF foreground = high_contrast ? ::GetSysColor(COLOR_WINDOWTEXT) : RGB(245,245,245);
+  const COLORREF selected = high_contrast ? background : RGB(54,65,80);
+  const COLORREF border = high_contrast ? foreground : RGB(80,80,80);
+  set(style->mutable_candidate_style()->mutable_background_color(), background);
+  set(style->mutable_candidate_style()->mutable_foreground_color(), foreground);
+  set(style->mutable_shortcut_style()->mutable_background_color(), background);
+  set(style->mutable_shortcut_style()->mutable_foreground_color(), foreground);
+  set(style->mutable_description_style()->mutable_foreground_color(), foreground);
+  set(style->mutable_footer_style()->mutable_foreground_color(), foreground);
+  set(style->mutable_footer_sub_label_style()->mutable_foreground_color(), foreground);
+  set(style->mutable_footer_top_color(), background); set(style->mutable_footer_bottom_color(), background);
+  set(style->mutable_focused_background_color(), selected); set(style->mutable_focused_border_color(), high_contrast ? ::GetSysColor(COLOR_HIGHLIGHT) : selected);
+  set(style->mutable_border_color(), border);
+  for (auto& c : *style->mutable_footer_border_colors()) set(&c,border);
+  set(style->mutable_scrollbar_background_color(), background);
+  set(style->mutable_scrollbar_indicator_color(), foreground);
+}
+
 void GetScaledRendererStyle(::mozc::renderer::RendererStyle* style,
                             uint32_t dpi) {
   const double scale_factor = GetDPIScalingFactor(dpi);
 
   RendererStyleHandler::GetRendererStyle(style);
 
+  // Kotori: Windows の候補欄は余白を持たせ、番号の帯と強い枠線を抑える。
+  // 拡大率を掛ける前の論理ピクセルで指定する。
+  const auto color = [](RendererStyle::RGBAColor* c, int r, int g, int b) {
+    c->set_r(r);
+    c->set_g(g);
+    c->set_b(b);
+  };
+  style->set_row_rect_padding(4);
+  color(style->mutable_border_color(), 200, 200, 200);
+  color(style->mutable_shortcut_style()->mutable_background_color(),
+        255, 255, 255);
+  color(style->mutable_shortcut_style()->mutable_foreground_color(),
+        110, 110, 110);
+  color(style->mutable_candidate_style()->mutable_foreground_color(),
+        32, 32, 32);
+  color(style->mutable_description_style()->mutable_foreground_color(),
+        100, 100, 100);
+  color(style->mutable_focused_background_color(), 232, 240, 250);
+  color(style->mutable_focused_border_color(), 232, 240, 250);
+  color(style->mutable_footer_top_color(), 250, 250, 250);
+  color(style->mutable_footer_bottom_color(), 250, 250, 250);
+  for (auto& border : *style->mutable_footer_border_colors()) {
+    color(&border, 225, 225, 225);
+  }
+  color(style->mutable_scrollbar_indicator_color(), 150, 150, 150);
+
+  HIGHCONTRAST contrast = {sizeof(contrast)};
+  const bool high_contrast = ::SystemParametersInfo(SPI_GETHIGHCONTRAST, sizeof(contrast), &contrast, 0) && (contrast.dwFlags & HCF_HIGHCONTRASTON);
+  DWORD light = 1, bytes = sizeof(light);
+  HKEY theme = nullptr;
+  if (::RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", 0, KEY_QUERY_VALUE, &theme) == ERROR_SUCCESS) {
+    ::RegQueryValueExW(theme, L"AppsUseLightTheme", nullptr, nullptr, reinterpret_cast<BYTE*>(&light), &bytes);
+    ::RegCloseKey(theme);
+  }
+  ApplyKotoriPalette(style, high_contrast, light == 0);
+
   // style->window_border is non-scalable.
   style->set_scrollbar_width(style->scrollbar_width() * scale_factor);
   style->set_row_rect_padding(style->row_rect_padding() * scale_factor);
