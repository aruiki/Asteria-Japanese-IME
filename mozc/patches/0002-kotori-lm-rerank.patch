--- /dev/null
+++ b/src/rewriter/kotori_model_identity.h
@@ -0,0 +1,26 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+#ifndef MOZC_REWRITER_KOTORI_MODEL_IDENTITY_H_
+#define MOZC_REWRITER_KOTORI_MODEL_IDENTITY_H_
+
+#include <memory>
+#include <string>
+
+namespace mozc {
+// Kotori: 非同期ロードでのみ使用する。実内容のSHA-256を取得し、所有中は
+// Windowsの共有モードで同じファイルの書き換え・置換を拒否する。
+// 開けない、読み切れない、未対応のOSの場合は識別不能としてnullptrを返す。
+class KotoriModelIdentity {
+ public:
+  static std::unique_ptr<KotoriModelIdentity> Open(const std::string& path);
+  ~KotoriModelIdentity();
+  KotoriModelIdentity(const KotoriModelIdentity&) = delete;
+  KotoriModelIdentity& operator=(const KotoriModelIdentity&) = delete;
+  const std::string& sha256() const { return sha256_; }
+
+ private:
+  KotoriModelIdentity() = default;
+  void* file_ = nullptr;
+  std::string sha256_;
+};
+}  // namespace mozc
+#endif  // MOZC_REWRITER_KOTORI_MODEL_IDENTITY_H_
diff --git a/src/rewriter/kotori_model_identity_test.cc b/src/rewriter/kotori_model_identity_test.cc
