+  EXPECT_FALSE(button_box->button(QDialogButtonBox::Apply)->isEnabled());
+  settings->click();
+  EXPECT_FALSE(button_box->button(QDialogButtonBox::Apply)->isEnabled());
+  EXPECT_EQ(tabs->currentIndex(), 1);
+  EXPECT_EQ(tabs->tabText(1), QString::fromUtf8("AI 変換"));
+  correction->click();
