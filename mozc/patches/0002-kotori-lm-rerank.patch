+// Kotori: 実測の履歴だけをGUIのメモリに持ち、閉じると破棄する。
+class KotoriUsageGraph : public QWidget {
+ public:
+  explicit KotoriUsageGraph(QWidget *parent) : QWidget(parent) {
+    clock_.start();
+    setMinimumHeight(92);
+    setAccessibleName(QString::fromUtf8("CPU使用率の推移。PC全体とAsteria。"));
+  }
+  void Add(std::optional<double> pc, std::optional<double> kotori) {
+    if (!pc && !kotori) return;
+    const qint64 now = clock_.elapsed();
+    if (!samples_.empty() && now - samples_.back().time < 300)
+      samples_.back() = {now, pc, kotori};
+    else
+      samples_.push_back({now, pc, kotori});
+    while (!samples_.empty() && now - samples_.front().time > 60000)
+      samples_.pop_front();
+    setProperty("sampleCount", static_cast<int>(samples_.size()));
+    update();
+  }
+
+ protected:
+  void paintEvent(QPaintEvent *) override {
+    QPainter painter(this);
+    painter.setRenderHint(QPainter::Antialiasing);
+    const bool contrast = KotoriHighContrast();
+    const QColor text = palette().color(QPalette::WindowText);
+    const QColor blue = contrast ? text : QColor("#0F6CBD");
+    const QColor purple =
+        contrast ? palette().color(QPalette::Highlight) : QColor("#8764B8");
+    const QRectF plot(36, 8, std::max(1, width() - 44),
+                      std::max(1, height() - 28));
+    for (int value : {0, 50, 100}) {
+      const double y = plot.bottom() - value * plot.height() / 100.0;
+      painter.setPen(contrast ? text : QColor("#E5E5E5"));
+      painter.drawLine(QPointF(plot.left(), y), QPointF(plot.right(), y));
+      painter.setPen(text);
+      painter.drawText(QRectF(0, y - 7, 30, 14),
+                       Qt::AlignRight | Qt::AlignVCenter,
+                       QString::number(value));
+    }
+    if (samples_.empty()) {
+      painter.drawText(plot, Qt::AlignCenter,
+                       QString::fromUtf8("計測を始めています"));
+      return;
+    }
+    const qint64 end = samples_.back().time;
+    const qint64 span = std::max<qint64>(2000, end - samples_.front().time);
+    const auto draw = [&](bool server, QColor color) {
+      QPainterPath path;
+      bool connected = false;
+      painter.setPen(QPen(color, 2));
+      for (const Sample &sample : samples_) {
+        const auto value = server ? sample.kotori : sample.pc;
+        if (!value) {
+          connected = false;
+          continue;
+        }
+        const QPointF point(
+            plot.right() - (end - sample.time) * plot.width() / span,
+            plot.bottom() -
+                std::clamp(*value, 0.0, 100.0) * plot.height() / 100.0);
+        if (connected)
+          path.lineTo(point);
+        else
+          path.moveTo(point);
+        connected = true;
+        painter.drawEllipse(point, 2, 2);
+      }
+      painter.drawPath(path);
+    };
+    draw(false, blue);
+    draw(true, purple);
+    painter.setPen(text);
+    painter.drawText(
+        QRectF(plot.left(), plot.bottom() + 4, plot.width(), 16),
+        Qt::AlignRight,
+        QString::fromUtf8("直近 %1 秒")
+            .arg(std::max<qint64>(1, (end - samples_.front().time) / 1000)));
+  }
+
+ private:
+  struct Sample {
+    qint64 time;
+    std::optional<double> pc, kotori;
+  };
+  std::deque<Sample> samples_;
+  QElapsedTimer clock_;
+};
+
+std::string KotoriAiStatus() {
+  KotoriDashboardSample sample;
+  sample.Update();
+  return sample.ai.toUtf8().toStdString();
+}
