+std::string EnvironmentValue(const char* name) {
+#ifdef _WIN32
+  // getenvはWindowsのANSIコードページを返す。モデル/DLL/文脈のパスは
+  // UTF-8なので、UnicodeのOS環境から取得してMozcの変換関数で揃える。
+  const std::wstring key = win32::Utf8ToWide(name);
+  DWORD size = GetEnvironmentVariableW(key.c_str(), nullptr, 0);
+  while (size > 0) {
+    std::wstring value(size, L'\0');
+    const DWORD written = GetEnvironmentVariableW(key.c_str(), value.data(), size);
+    if (written == 0) return std::string();
+    if (written < size) {
+      value.resize(written);
+      return win32::WideToUtf8(value);
+    }
+    size = written;  // 読取り中に環境変数が伸びた場合だけ再取得する。
+  }
+  return std::string();
+#else
+  const char* value = std::getenv(name);
+  return value == nullptr ? std::string() : std::string(value);
+#endif
+}
+
+
+bool HasCorrectionScoreGain(double original, double corrected, double margin) {
+  if (!std::isfinite(original) || !std::isfinite(corrected) ||
+      !std::isfinite(margin) || margin <= 0) {
+    return false;
+  }
+  const double gain = corrected - original;
+  return std::isfinite(gain) && gain >= margin;
+}
+
+bool IsLocalCorrection(absl::string_view original, absl::string_view corrected) {
+  if (original == corrected || !IsValidCorrectionText(original) ||
+      !IsValidCorrectionText(corrected)) {
+    return false;
+  }
+  const auto before = Chars(original);
+  const auto after = Chars(corrected);
+  // 数値、英字、記号、空白の書き換えは明示操作に任せる。
+  constexpr absl::string_view kKanjiNumbers =
+      "〇零一二三四五六七八九十百千万億兆京壱弐参拾廿卅卌萬阡仟壹貳參肆伍陸柒捌玖佰";
+  auto protected_text = [kKanjiNumbers](const auto& chars) {
+    std::string result;
+    for (const auto& ch : chars) {
+      const auto type = Util::GetScriptType(ch);
+      if (kKanjiNumbers.find(ch) != absl::string_view::npos ||
+          (type != Util::HIRAGANA && type != Util::KATAKANA &&
+           type != Util::KANJI)) {
+        result += ch;
+      }
+    }
+    return result;
+  };
+  if (protected_text(before) != protected_text(after)) return false;
+  // Kotori: 「一時」→「一字」のように数字を残した単位の変更も拒否する。
+  // 数字を含む連続した漢字・カタカナ・英数字を保守的に固定する。
+  // 人名や述語の意味を判定するものではないため、既定有効化には別の検査が必要。
+  auto number_units = [kKanjiNumbers](const auto& chars) {
+    std::vector<std::string> units;
+    std::string word;
+    bool has_number = false;
+    auto finish = [&] {
+      if (has_number) units.push_back(word);
+      word.clear();
+      has_number = false;
+    };
+    for (const auto& ch : chars) {
+      const auto type = Util::GetScriptType(ch);
+      const bool numeric = type == Util::NUMBER ||
+                           kKanjiNumbers.find(ch) != absl::string_view::npos;
+      if (!numeric && type != Util::KANJI && type != Util::KATAKANA &&
+          type != Util::ALPHABET) {
+        finish();
+      } else {
+        word += ch;
+        has_number = has_number || numeric;
+      }
+    }
+    finish();
+    return units;
+  };
+  if (number_units(before) != number_units(after)) return false;
+  std::vector<size_t> previous(after.size() + 1), current(after.size() + 1);
+  std::iota(previous.begin(), previous.end(), 0);
+  for (size_t i = 0; i < before.size(); ++i) {
+    current[0] = i + 1;
+    for (size_t j = 0; j < after.size(); ++j) {
+      current[j + 1] = std::min({current[j] + 1, previous[j + 1] + 1,
+          previous[j] + (before[i] == after[j] ? 0 : 1)});
+    }
+    previous.swap(current);
+  }
+  return previous.back() <= 2;
+}
+
+bool IsSafeDictionaryCorrection(
+    const dictionary::DictionaryInterface& dictionary,
+    dictionary::PosMatcher pos_matcher, absl::string_view reading,
+    absl::string_view original, absl::string_view corrected) {
+  if (!IsLocalCorrection(original, corrected)) return false;
+  const auto [before, after] = CorrectionSpans(original, corrected);
+  return HasSafeCorrectionReading(dictionary, pos_matcher, reading, original, before) &&
+         HasSafeCorrectionReading(dictionary, pos_matcher, reading, corrected, after);
+}
+
+bool IsMechanicalReadingTypo(absl::string_view reading, absl::string_view corrected) {
+  if (!IsValidCorrectionText(reading) || !IsValidCorrectionText(corrected)) return false;
+  const auto a = Chars(reading), b = Chars(corrected);
+  if (a.size() < 4 || a.size() > kMaxTypoChars || b.size() > kMaxTypoChars) return false;
+  size_t first = 0;
+  while (first < a.size() && first < b.size() && a[first] == b[first]) ++first;
+  if (a.size() == b.size()) {
+    if (first == a.size() || !std::equal(a.begin()+first+1,a.end(),b.begin()+first+1)) return false;
+    static constexpr absl::string_view pairs[] = {"かが", "きぎ", "くぐ", "けげ", "こご", "さざ", "しじ", "すず", "せぜ", "そぞ", "ただ", "ちぢ", "つづ", "てで", "とど", "はば", "ひび", "ふぶ", "へべ", "ほぼ", "はぱ", "ひぴ", "ふぷ", "へぺ", "ほぽ"};
+    for (auto pair : pairs) {
+      const auto chars = Chars(pair);
+      if ((a[first] == chars[0] && b[first] == chars[1]) || (a[first] == chars[1] && b[first] == chars[0])) return true;
+    }
+    return false;
+  }
+  if (a.size() == b.size()+1) {
+    // 重複文字か余分な促音だけを削除する。一般の一文字削除は意味を変え得る。
+    for (size_t i = 0; i < a.size(); ++i) {
+      if (a[i] != "っ" && !(i > 0 && a[i] == a[i-1]) && !(i+1 < a.size() && a[i] == a[i+1])) continue;
+      if (Util::GetScriptType(a[i]) != Util::HIRAGANA) continue;
+      auto removed = a; removed.erase(removed.begin()+i);
+      if (removed == b) return true;
+    }
+    return false;
+  }
+  if (b.size() == a.size()+1 && first < b.size() &&
+      (b[first] == "っ" || b[first] == "ー" || b[first] == "う" || b[first] == "い")) {
+    auto removed = b; removed.erase(removed.begin()+first);
+    return removed == a;
+  }
+  return false;
+}
+
+// Kotori: 逆引きの最初の読みだけでは「世話→せいわ」などを選び得る。
+// 入力から一字だけ直した読みを有限に調べ、生成文との辞書対応を確認する。
+std::string MechanicalCorrectionReading(
+    const dictionary::DictionaryInterface& dictionary, absl::string_view reading,
+    absl::string_view corrected) {
+  auto test = [&](const std::vector<std::string>& chars) {
+    const std::string yomi = absl::StrJoin(chars, "");
+    return IsMechanicalReadingTypo(reading, yomi) &&
+           MatchesReading(dictionary, nullptr, corrected, yomi, false) ? yomi : std::string();
+  };
+  const auto input = Chars(reading);
+  if (input.size() < 4 || input.size() > kMaxTypoChars) return {};
+  const auto reverse = ReadingOf(dictionary, nullptr, corrected);
+  if (IsMechanicalReadingTypo(reading, reverse)) return reverse;
+  for (size_t i = 0; i <= input.size(); ++i) {
+    for (const char* insert : {"っ", "ー", "う", "い"}) {
+      auto candidate = input;
+      candidate.insert(candidate.begin() + i, insert);
+      if (const auto yomi = test(candidate); !yomi.empty()) return yomi;
+    }
+    if (i == input.size()) continue;
+    auto removed = input;
+    removed.erase(removed.begin() + i);
+    if (const auto yomi = test(removed); !yomi.empty()) return yomi;
+    for (const auto& ch : Chars("かがきぎくぐけげこごさざしじすずせぜそぞただちぢつづてでとどはばぱひびぴふぶぷへべぺほぼぽ")) {
+      auto candidate = input;
+      candidate[i] = ch;
+      if (const auto yomi = test(candidate); !yomi.empty()) return yomi;
+    }
+  }
+  return {};
+}
+
+bool IsSafeDictionaryTypoCorrection(
+    const dictionary::DictionaryInterface& dictionary,
+    dictionary::PosMatcher pos_matcher, absl::string_view reading,
+    absl::string_view original, absl::string_view corrected, std::string* corrected_reading) {
+  if (corrected_reading == nullptr || !IsLocalCorrection(original, corrected)) return false;
+  const std::string candidate_reading = MechanicalCorrectionReading(dictionary, reading, corrected);
+  if (candidate_reading.empty()) return false;
+  const auto [before, after] = CorrectionSpans(original, corrected);
+  // Kotori: 読みの一字誤りは、表記もかなだけの一字修正に限る。
+  // 漢字・名前・利用者辞書・代名詞を保持し、正しい活用/否定/時制の断片を変えない。
+  auto kana_only = [](absl::string_view text, CorrectionSpan span) {
+    for (const auto& ch : Chars(text.substr(span.first, span.second - span.first))) {
+      if (Util::GetScriptType(ch) != Util::HIRAGANA) return false;
+    }
+    return true;
+  };
+  if (!kana_only(original, before) || !kana_only(corrected, after)) return false;
+  auto count = [](absl::string_view text, absl::string_view fragment) {
+    size_t total = 0, at = 0;
+    while ((at = text.find(fragment, at)) != absl::string_view::npos) {
+      ++total;
+      at += fragment.size();
+    }
+    return total;
+  };
+  for (absl::string_view grammar : {"って", "った", "して", "した", "ない",
+       "なかった", "ません", "ました", "でした", "だった", "れる", "せる"}) {
+    if (count(reading, grammar) != count(candidate_reading, grammar)) return false;
+  }
+  // 単語の途中に現れる一文字の助詞は誤入力の範囲の拒否理由にしない。
+  // 上の活用検査と、前後の辞書対応/保護語検査を併用する。
+  if (!HasSafeCorrectionReading(dictionary, pos_matcher, reading, original, before, false) ||
+      !HasSafeCorrectionReading(dictionary, pos_matcher, candidate_reading, corrected, after, false)) return false;
+  *corrected_reading = candidate_reading;
+  return true;
+}
+
+std::optional<std::string> ProjectMechanicalTypoCorrection(
+    const dictionary::DictionaryInterface& dictionary,
+    dictionary::PosMatcher pos_matcher, absl::string_view reading,
+    absl::string_view original, absl::string_view generated) {
+  // Kotori: LLMの修正した読みだけを元の表記へ反映する。
+  // 正しい漢字を平仮名へ戻したり、周囲の語を言い換えたりしない。
+  if (original == generated) return std::nullopt;
+  const std::string fixed_reading = MechanicalCorrectionReading(dictionary, reading, generated);
+  if (fixed_reading.empty()) return std::nullopt;
+  const auto input = Chars(reading), fixed = Chars(fixed_reading), text = Chars(original);
+  size_t at = 0;
+  while (at < input.size() && at < fixed.size() && input[at] == fixed[at]) ++at;
+  for (size_t i = 0; i <= text.size(); ++i) {
+    auto candidate = text;
+    if (fixed.size() == input.size() + 1) {
+      candidate.insert(candidate.begin() + i, fixed[at]);
+    } else {
+      if (i == text.size() || Util::GetScriptType(text[i]) != Util::HIRAGANA) continue;
+      if (fixed.size() + 1 == input.size()) candidate.erase(candidate.begin() + i);
+      else candidate[i] = fixed[at];
+    }
+    const std::string value = absl::StrJoin(candidate, "");
+    if (!MatchesReading(dictionary, nullptr, value, fixed_reading, false)) continue;
+    std::string checked_reading;
+    if (IsSafeDictionaryTypoCorrection(dictionary, pos_matcher, reading,
+                                      original, value, &checked_reading)) return value;
+  }
+  return std::nullopt;
+}
+
+void SplitIntoSegments(
+    const std::vector<std::pair<std::string, std::string>>& units, size_t max,
+    std::vector<std::string>* keys, std::vector<std::string>* values) {
+  SplitIntoSegmentsImpl(units, max, keys, values);
+}
+
+bool HasRepeatedContinuation(absl::string_view base, absl::string_view continuation) {
+  const auto b = Chars(std::string(base)), c = Chars(std::string(continuation));
+  if (b.empty() || c.empty()) return false;
+  // 境界の同じ文字と、入力済みの3文字以上の断片をそのまま繰り返す生成を抑える。
+  if (b.back() == c.front()) return true;
+  if (c.size() < 3) return false;
+  return absl::StrContains(base, c[0] + c[1] + c[2]);
+}
+
+std::optional<std::string> GenerateSafeCorrection(
+    const dictionary::DictionaryInterface& dictionary,
+    dictionary::PosMatcher pos_matcher, ZenzScorer* scorer, ZenzScorer* llm,
+    const std::string& context, const std::string& reading,
+    const std::string& original, double original_score,
+    const CorrectionOptions& options, const std::function<bool()>& cancelled) {
+  if (scorer == nullptr || llm == nullptr || !cancelled || cancelled() ||
+      !std::isfinite(original_score) || !std::isfinite(options.zenz_weight) ||
+      !std::isfinite(options.llm_weight) || options.zenz_weight <= 0 ||
+      options.llm_weight <= 0 || !std::isfinite(options.margin) ||
+      options.margin <= 0 || options.beams < 1 || options.beams > 4 ||
+      !HasSafeCorrectionReading(dictionary, pos_matcher, reading, original) ||
+      cancelled()) {
+    return std::nullopt;
+  }
+  CancelScope cancel(cancelled);
+  const auto generated = llm->Correct(reading, original, options.prompt,
+                                      options.beams);
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] correction generated=%zu cancelled=%d\n",
+                 generated.size(), cancelled() ? 1 : 0);
+  }
+  std::optional<std::string> best;
+  double best_score = original_score;
+  for (const auto& generated_value : generated) {
+    if (cancelled()) return std::nullopt;
+    const auto projected = ProjectMechanicalTypoCorrection(
+        dictionary, pos_matcher, reading, original, generated_value);
+    if (cancelled()) return std::nullopt;
+    const std::string& value = projected ? *projected : generated_value;
+    std::string candidate_reading(reading);
+    if (!IsSafeDictionaryCorrection(dictionary, pos_matcher, reading, original, value) &&
+        !IsSafeDictionaryTypoCorrection(dictionary, pos_matcher, reading, original, value, &candidate_reading)) {
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        std::fprintf(stderr, "[kotori] correction rejected=reading_or_protection\n");
+      }
+      continue;
+    }
+    if (cancelled()) return std::nullopt;
+    const auto z = scorer->Score(context, candidate_reading, {value});
+    if (Env("KOTORI_LM_DEBUG") != nullptr) {
+      std::fprintf(stderr, "[kotori] correction zenz_valid=%d cancelled=%d\n",
+                   z && z->size() == 1 && std::isfinite((*z)[0]) ? 1 : 0,
+                   cancelled() ? 1 : 0);
+    }
+    if (!z || z->size() != 1 || !std::isfinite((*z)[0]) || cancelled()) {
+      return std::nullopt;
+    }
+    const auto l = llm->Score(context, reading, {value});
+    if (Env("KOTORI_LM_DEBUG") != nullptr) {
+      std::fprintf(stderr, "[kotori] correction llm_valid=%d cancelled=%d\n",
+                   l && l->size() == 1 && std::isfinite((*l)[0]) ? 1 : 0,
+                   cancelled() ? 1 : 0);
+    }
+    if (!l || l->size() != 1 || !std::isfinite((*l)[0]) || cancelled()) {
+      return std::nullopt;
+    }
+    const double score = options.zenz_weight * (*z)[0] +
+                         options.llm_weight * (*l)[0];
+    if (Env("KOTORI_LM_DEBUG") != nullptr) {
+      std::fprintf(stderr, "[kotori] correction gain=%.2f margin=%.2f\n",
+                   score - original_score, options.margin);
+    }
+    if (score > best_score &&
+        HasCorrectionScoreGain(original_score, score, options.margin)) {
+      best_score = score;
+      best = value;
+    }
+  }
+  if (cancelled()) return std::nullopt;
+  return best;
+}
