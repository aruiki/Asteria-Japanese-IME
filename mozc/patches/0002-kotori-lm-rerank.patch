+  // 同じ ID の SetTimer は前のものを置き換えるので、続けて打てば最後の打鍵から数え直す。
+  void KotoriScheduleRefresh(ITfContext* context, uint32_t delay_ms) override {
+    if (!::IsWindow(task_window_handle_) || context == nullptr) {
+      return;
+    }
+    kotori_refresh_context_ = context;
+    ::SetTimer(task_window_handle_, kKotoriRefreshTimerId, delay_ms, nullptr);
