+class DashboardClientFactory : public client::ClientFactoryInterface {
+ public:
+  client::ClientMock* mock = nullptr;
+  std::unique_ptr<client::ClientInterface> NewClient() override {
+    auto mock = std::make_unique<::testing::NiceMock<client::ClientMock>>();
+    this->mock = mock.get();
+    EXPECT_CALL(*mock, CheckVersionOrRestartServer()).WillOnce(Return(true));
+    EXPECT_CALL(*mock, GetConfig(_))
+        .WillOnce(DoAll(SetArgPointee<0>(config::Config()), Return(true)));
+    // 画面を開く・移動するだけでは設定を保存しない。
+    EXPECT_CALL(*mock, SetConfig(_)).Times(0);
+    return mock;
+  }
+};
+class KotoriDashboardTest : public mozc::testing::TestWithTempUserProfile {
+ protected:
+  static void SetUpTestSuite() {
+    if (qEnvironmentVariableIsEmpty("QT_QPA_PLATFORM"))
+      qputenv("QT_QPA_PLATFORM", "offscreen");
+    static int argc = 1;
+    static char name[] = "kotori_dashboard_test";
+    static char* argv[] = {name, nullptr};
+    app_ = GuiUtil::InitQt(argc, argv);
+    InitializeResources();
+    GuiUtil::InstallTranslator("config_dialog");
+  }
+  static void TearDownTestSuite() { app_.reset(); }
+  void SetUp() override { client::ClientFactory::SetClientFactory(&factory_); }
+  void TearDown() override { client::ClientFactory::SetClientFactory(nullptr); }
+  static void Refresh() {
+    QEventLoop loop;
+    QTimer::singleShot(2100, &loop, &QEventLoop::quit);
+    loop.exec();
+  }
+  inline static std::unique_ptr<QApplication> app_;
+  DashboardClientFactory factory_;
+};
+// Kotori: 実際の設定保存の成功だけを表示し、保存操作を未保存扱いへ戻さない。
+TEST_F(KotoriDashboardTest, ShowsPendingAndSavedFeedback) {
+  ConfigDialog dialog;
+  dialog.setAttribute(Qt::WA_DontShowOnScreen);
+  auto* status = dialog.findChild<QLabel*>("kotoriSettingsSaveStatus");
+  ASSERT_NE(status, nullptr);
+  auto* buttons = dialog.findChild<QDialogButtonBox*>("configDialogButtonBox");
+  auto* correction = dialog.findChild<QCheckBox*>("kotoriLmCorrection");
+  ASSERT_NE(buttons, nullptr);
+  ASSERT_NE(correction, nullptr);
+  auto* apply = buttons->button(QDialogButtonBox::Apply);
+  EXPECT_FALSE(apply->isEnabled());
+  EXPECT_FALSE(status->text().contains(QString::fromUtf8("適用しました")));
+  correction->click();
+  EXPECT_TRUE(apply->isEnabled());
+  EXPECT_TRUE(status->text().contains(QString::fromUtf8("まだ適用")));
+  EXPECT_CALL(*factory_.mock, CheckVersionOrRestartServer())
+      .WillOnce(Return(true));
+  EXPECT_CALL(*factory_.mock, SetConfig(_)).WillOnce(Return(true));
+  apply->click();
+  EXPECT_FALSE(apply->isEnabled());
+  EXPECT_TRUE(status->text().contains(QString::fromUtf8("設定を適用しました")));
+  QCoreApplication::processEvents();
+  EXPECT_FALSE(apply->isEnabled());
+  const QString capture = qEnvironmentVariable("KOTORI_GUI_CAPTURE_DIR");
+  if (!capture.isEmpty()) {
+    dialog.show();
+    QCoreApplication::processEvents();
+    Refresh();
+    QDir().mkpath(capture);
+    EXPECT_TRUE(dialog.grab().save(capture + "/settings-applied.png"));
+  }
+  correction->click();
+  EXPECT_TRUE(apply->isEnabled());
+  EXPECT_FALSE(status->text().contains(QString::fromUtf8("適用しました")));
+}
+// 保存失敗でOKから閉じず、変更を保持したまま適用を再試行できる。
+TEST_F(KotoriDashboardTest, FailedSaveKeepsDialogOpenAndRetrySucceeds) {
+  ConfigDialog dialog;
+  dialog.setAttribute(Qt::WA_DontShowOnScreen);
+  dialog.show();
+  auto* status = dialog.findChild<QLabel*>("kotoriSettingsSaveStatus");
+  auto* buttons = dialog.findChild<QDialogButtonBox*>("configDialogButtonBox");
+  auto* correction = dialog.findChild<QCheckBox*>("kotoriLmCorrection");
+  ASSERT_NE(status, nullptr);
+  ASSERT_NE(buttons, nullptr);
+  ASSERT_NE(correction, nullptr);
+  correction->click();
+  const bool changed_value = correction->isChecked();
+  EXPECT_CALL(*factory_.mock, CheckVersionOrRestartServer())
+      .Times(2).WillRepeatedly(Return(true));
+  EXPECT_CALL(*factory_.mock, SetConfig(_))
+      .WillOnce(Return(false)).WillOnce(Return(true));
+  QTimer::singleShot(0, &dialog, [&dialog]() {
+    auto* error = dialog.findChild<QMessageBox*>();
+    ASSERT_NE(error, nullptr);
+    error->accept();
+  });
+  buttons->button(QDialogButtonBox::Ok)->click();
+  EXPECT_TRUE(dialog.isVisible());
+  EXPECT_EQ(correction->isChecked(), changed_value);
+  EXPECT_TRUE(buttons->button(QDialogButtonBox::Apply)->isEnabled());
+  EXPECT_EQ(status->property("saveState").toString(), "error");
+  EXPECT_FALSE(status->text().contains(QString::fromUtf8("適用しました")));
+  buttons->button(QDialogButtonBox::Apply)->click();
+  EXPECT_FALSE(buttons->button(QDialogButtonBox::Apply)->isEnabled());
+  EXPECT_EQ(status->property("saveState").toString(), "saved");
+  EXPECT_TRUE(status->text().contains(QString::fromUtf8("設定を適用しました")));
+}
