index 000000000..69fffd532
--- /dev/null
+++ b/src/base/kotori_diagnostics.cc
@@ -0,0 +1,207 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "base/kotori_diagnostics.h"
+
+#include <algorithm>
+#include <csignal>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+#include "absl/strings/match.h"
+#include "absl/strings/str_cat.h"
+#include "absl/strings/str_split.h"
+#include "absl/strings/string_view.h"
+#include "absl/types/span.h"
+#include "base/file_util.h"
+#include "base/system_util.h"
+#include "base/version.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif  // _WIN32
+
+namespace mozc {
+namespace kotori {
+namespace {
+
+// kotori_ai_status.txt のうち、診断情報に出してよいキー(rewriter/lm_rewriter.cc の WriteStatus)。
+// どれも状態・GPU の名前・モデルのファイル名で、入力した文字は入らない。
+constexpr absl::string_view kStatusKeys[] = {"state", "device", "zenz", "llm",
+                                             "message"};
+// 異常終了の記録のうち、出してよいキー(下の WriteCrashLog が書くもの)。
+constexpr absl::string_view kCrashKeys[] = {"time",   "version", "kind",
+                                            "code",   "module",  "offset",
+                                            "frame"};
+constexpr size_t kMaxValueLength = 200;
+
+// key=value の行のうち、許可したキーの行だけを残す。値は長さを切る。
+std::string FilterLines(absl::string_view text,
+                        absl::Span<const absl::string_view> keys) {
+  std::string out;
+  for (absl::string_view line : absl::StrSplit(text, '\n')) {
+    absl::ConsumeSuffix(&line, "\r");
+    const size_t eq = line.find('=');
+    if (eq == absl::string_view::npos) continue;
+    const absl::string_view key = line.substr(0, eq);
+    if (std::find(keys.begin(), keys.end(), key) == keys.end()) continue;
+    absl::StrAppend(&out, key, "=",
+                    line.substr(eq + 1).substr(0, kMaxValueLength), "\n");
+  }
+  return out;
+}
+
+#ifdef _WIN32
+// 異常終了のときに書くので、起動時に場所を決めておく。
+wchar_t g_crash_dir[MAX_PATH] = {};
+char g_version[64] = {};
+LPTOP_LEVEL_EXCEPTION_FILTER g_previous_filter = nullptr;
+
+// address を「モジュール名 + オフセット」にする。
+void Locate(const void *address, char *module, size_t module_size,
+            unsigned long long *offset) {
+  HMODULE handle = nullptr;
+  module[0] = '\0';
+  *offset = reinterpret_cast<unsigned long long>(address);
+  if (!::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            static_cast<LPCWSTR>(address), &handle)) {
+    std::snprintf(module, module_size, "?");
+    return;
+  }
+  wchar_t path[MAX_PATH] = {};
+  ::GetModuleFileNameW(handle, path, MAX_PATH);
+  const wchar_t *base = path;
+  for (const wchar_t *p = path; *p; ++p) {
+    if (*p == L'\\' || *p == L'/') base = p + 1;
+  }
+  ::WideCharToMultiByte(CP_UTF8, 0, base, -1, module,
+                        static_cast<int>(module_size), nullptr, nullptr);
+  *offset -= reinterpret_cast<unsigned long long>(handle);
+}
+
+// 異常終了の記録を書く。メモリの中身は書かない(入力した文字が残っているため)。
+void WriteCrashLog(const char *kind, unsigned long code, const void *address) {
+  if (g_crash_dir[0] == L'\0') return;
+  SYSTEMTIME t;
+  ::GetLocalTime(&t);
+  wchar_t path[MAX_PATH] = {};
+  _snwprintf_s(path, MAX_PATH, _TRUNCATE,
+               L"%s\\crash-%04u%02u%02u-%02u%02u%02u-%lu.txt", g_crash_dir,
+               t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond,
+               ::GetCurrentProcessId());
+  static char buf[8192];
+  int n = std::snprintf(
+      buf, sizeof(buf),
+      "time=%04u-%02u-%02u %02u:%02u:%02u\nversion=%s\nkind=%s\ncode=0x%08lX\n",
+      t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond, g_version,
+      kind, code);
+  char module[MAX_PATH];
+  unsigned long long offset = 0;
+  if (address != nullptr) {
+    Locate(address, module, sizeof(module), &offset);
+    n += std::snprintf(buf + n, sizeof(buf) - n, "module=%s\noffset=0x%llX\n",
+                       module, offset);
+  }
+  // 呼び出しの道筋(この関数から上へ)。x64 では例外の処理は同じスタックで行われるので、
+  // 落ちた場所の呼び出し元までたどれる。
+  void *frames[48];
+  const USHORT count = ::RtlCaptureStackBackTrace(0, 48, frames, nullptr);
+  for (USHORT i = 0; i < count && n < static_cast<int>(sizeof(buf)) - 300;
+       ++i) {
+    Locate(frames[i], module, sizeof(module), &offset);
+    n += std::snprintf(buf + n, sizeof(buf) - n, "frame=%s+0x%llX\n", module,
+                       offset);
+  }
+  HANDLE file = ::CreateFileW(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) return;
+  DWORD written = 0;
+  ::WriteFile(file, buf, static_cast<DWORD>(n), &written, nullptr);
+  ::CloseHandle(file);
+}
+
+LONG WINAPI CrashFilter(EXCEPTION_POINTERS *info) {
+  WriteCrashLog("exception", info->ExceptionRecord->ExceptionCode,
+                info->ExceptionRecord->ExceptionAddress);
+  // Mozc の既定(base/init_mozc.cc)と同じく、その後はプロセスを終える。
+  return g_previous_filter != nullptr ? g_previous_filter(info)
+                                      : EXCEPTION_EXECUTE_HANDLER;
+}
+
+void AbortHandler(int) {
+  WriteCrashLog("abort", 0, nullptr);
+  ::ExitProcess(3);
+}
+#endif  // _WIN32
+
+}  // namespace
+
+std::string CrashLogDir() {
+  return FileUtil::JoinPath(SystemUtil::GetUserProfileDirectory(), "crash");
+}
+
+std::vector<std::string> PruneCrashLogs(const std::string &dir,
+                                        int max_files) {
+  // C++20 の u8string は char8_t なので、UTF-8 の std::string と行き来する。
+  auto to_utf8 = [](const std::filesystem::path &path) {
+    const std::u8string s = path.u8string();
+    return std::string(s.begin(), s.end());
+  };
+  std::vector<std::string> files;
+  std::error_code ec;
+  for (const auto &entry : std::filesystem::directory_iterator(
+           std::filesystem::path(std::u8string(dir.begin(), dir.end())), ec)) {
+    const std::string name = to_utf8(entry.path().filename());
+    if (absl::StartsWith(name, "crash-") && absl::EndsWith(name, ".txt")) {
+      files.push_back(to_utf8(entry.path()));
+    }
+  }
+  std::sort(files.rbegin(), files.rend());
+  while (files.size() > static_cast<size_t>(std::max(max_files, 0))) {
+    FileUtil::UnlinkOrLogError(files.back());
+    files.pop_back();
+  }
+  return files;
+}
+
+void InstallCrashLogger() { InstallCrashLoggerTo(CrashLogDir()); }
+
+void InstallCrashLoggerTo(const std::string &dir) {
+#ifdef _WIN32
+  FileUtil::CreateDirectory(dir).IgnoreError();
+  PruneCrashLogs(dir, kMaxCrashLogs - 1);
+  ::MultiByteToWideChar(CP_UTF8, 0, dir.c_str(), -1, g_crash_dir, MAX_PATH);
+  std::snprintf(g_version, sizeof(g_version), "%s",
+                Version::GetMozcVersion().c_str());
+  g_previous_filter = ::SetUnhandledExceptionFilter(CrashFilter);
+  std::signal(SIGABRT, AbortHandler);
+#endif  // _WIN32
+}
+
+std::string FormatDiagnostics(const DiagnosticsInput &input) {
+  std::string out =
+      "Kotori日本語入力 診断情報\n"
+      "入力した文字・読み・候補・前の文は含みません。Issue に貼るか添付してください。\n\n";
+  absl::StrAppend(&out, "[版と環境]\n", "version=", input.version, "\n",
+                  "os=", input.os_version, "\n", "gpu=", input.gpu_summary,
+                  "\n\n");
+  absl::StrAppend(&out, "[設定]\n", "ai=", input.lm_enabled ? "on" : "off",
+                  "\n", "predict=", input.predict_enabled ? "on" : "off", "\n",
+                  "quality=", input.quality, "\n", "model=", input.model, "\n",
+                  "model_path=", input.custom_model_path ? "指定あり" : "同梱",
+                  "\n\n");
+  absl::StrAppend(&out, "[AI の状態]\n", input.ai_status_text, "\n",
+                  FilterLines(input.ai_status_file, kStatusKeys), "\n");
+  absl::StrAppend(&out, "[異常終了の記録] ", input.crash_logs.size(), " 件\n");
+  for (const auto &[name, text] : input.crash_logs) {
+    absl::StrAppend(&out, "--- ", name, "\n", FilterLines(text, kCrashKeys));
+  }
+  return out;
+}
+
+}  // namespace kotori
+}  // namespace mozc
