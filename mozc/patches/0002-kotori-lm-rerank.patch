@@ -0,0 +1,25 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+// Kotori: 入力中の候補を、手が止まった後に取り直すまでの時間(docs/adr/0039)。
+// 変換の AI(rewriter/lm_rewriter.cc)が、設定と GPU の有無に合わせて決め、
+// セッション(session/session.cc)が Output.callback に入れてクライアントに送らせる。
+
+#ifndef MOZC_BASE_KOTORI_LIVE_H_
+#define MOZC_BASE_KOTORI_LIVE_H_
+
+#include <atomic>
+
+namespace mozc {
+namespace kotori {
+
+// 打鍵の後、最初に取り直すまでの時間(ms)。0 なら取り直さない。
+inline std::atomic<int> g_live_first_ms{0};
+// 2 回目以降に取り直すまでの時間(ms。裏で作る予測を待つ)。0 なら 1 回だけ。
+inline std::atomic<int> g_live_next_ms{0};
+// 1 回の打鍵の後に取り直す回数の上限。
+inline constexpr int kMaxLiveRefreshes = 5;
+
+}  // namespace kotori
+}  // namespace mozc
+
+#endif  // MOZC_BASE_KOTORI_LIVE_H_
diff --git a/src/bazel/BUILD.llama_cpp.bazel b/src/bazel/BUILD.llama_cpp.bazel
new file mode 100644
index 000000000..cbd6e6dc7
--- /dev/null
+++ b/src/bazel/BUILD.llama_cpp.bazel
@@ -0,0 +1,118 @@
+# llama.cpp(MIT)。Kotori の LM リランク用(docs/adr/0013、0016)。
+#
+# Windows: ヘッダーだけを使い、実行時にインストール先の公式ビルド(llama.dll、ggml*.dll。
+#          GPU は Vulkan)を読み込む(rewriter/llama_runtime.cc)。
+# それ以外(Linux での評価): CPU 版を静的にリンクする。x86-64 の AVX2 を前提にする。
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+licenses(["notice"])
+
+exports_files(["LICENSE"])
+
+# CMake が作るバージョンのヘッダー。
+write_file(
+    name = "llama_version_h",
+    out = "src/llama-version.h",
+    content = [
+        "#pragma once",
+        "#define LLAMA_VERSION \"kotori\"",
+        "#define LLAMA_COMMIT \"b11259\"",
+        "",
+    ],
+)
+
+write_file(
+    name = "ggml_version_h",
+    out = "ggml/src/ggml-version.h",
+    content = [
+        "#pragma once",
+        "#define GGML_VERSION \"kotori\"",
+        "#define GGML_COMMIT \"b11259\"",
+        "",
+    ],
+)
+
+cc_library(
+    name = "headers",
+    hdrs = glob([
+        "include/*.h",
+        "ggml/include/*.h",
+    ]),
+    includes = [
+        "ggml/include",
+        "include",
+    ],
+)
+
+cc_library(
+    name = "ggml_static",
+    srcs = glob([
+        "ggml/src/*.c",
+        "ggml/src/*.cpp",
+        "ggml/src/*.h",
+        "ggml/src/ggml-cpu/*.c",
+        "ggml/src/ggml-cpu/*.cpp",
+        "ggml/src/ggml-cpu/*.h",
+        "ggml/src/ggml-cpu/tiled/*.cpp",
+        "ggml/src/ggml-cpu/tiled/*.h",
+        "ggml/src/ggml-cpu/amx/*.cpp",
+        "ggml/src/ggml-cpu/amx/*.h",
+        "ggml/src/ggml-cpu/llamafile/*.cpp",
+        "ggml/src/ggml-cpu/llamafile/*.h",
+        "ggml/src/ggml-cpu/arch/x86/*.c",
+        "ggml/src/ggml-cpu/arch/x86/*.cpp",
+    ]) + [":ggml_version_h"],
+    copts = [
+        "-mavx2",
+        "-mfma",
+        "-mf16c",
+        "-w",
+    ],
+    defines = [
+        "GGML_USE_CPU",
+        "GGML_SCHED_MAX_COPIES=4",
+        "_GNU_SOURCE",
+        "_XOPEN_SOURCE=600",
+    ],
+    includes = [
+        "ggml/src",
+        "ggml/src/ggml-cpu",
+    ],
+    linkopts = [
+        "-lpthread",
+        "-lm",
+        "-ldl",
+    ],
+    textual_hdrs = glob(
+        ["ggml/src/**/*.inc"],
+        allow_empty = True,
+    ),
+    deps = [":headers"],
+)
+
+cc_library(
+    name = "llama_static",
+    srcs = glob([
+        "src/*.cpp",
+        "src/*.h",
+        "src/models/*.cpp",
+        "src/models/*.h",
+    ]) + [":llama_version_h"],
+    copts = ["-w"],
+    includes = ["src"],
+    deps = [
+        ":ggml_static",
+        ":headers",
+    ],
+)
+
+alias(
+    name = "llama",
+    actual = select({
+        "@platforms//os:windows": ":headers",
+        "//conditions:default": ":llama_static",
+    }),
+)
