<Window x:Class="Asteria.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asteria日本語入力 のセットアップ" Width="448" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      最近のアプリのインストーラーに合わせた画面(利用者の依頼、2026-11-25)。明るく平らで、アイコンと名前だけが
      目立ち、文は最小限。大きなボタン 1 つ → 細い進捗バー。作り手は足元に小さく。
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18181B" />
        <SolidColorBrush x:Key="Sub" Color="#71717A" />
        <SolidColorBrush x:Key="Faint" Color="#A1A1AA" />
        <SolidColorBrush x:Key="Line" Color="#E4E4E7" />
        <SolidColorBrush x:Key="Accent" Color="#131A2A" />
        <SolidColorBrush x:Key="AccentHover" Color="#24304A" />

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="{StaticResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="White"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F4F4F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Close" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource Sub}" StrokeThickness="1.2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F4F4F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12" Color="#000000" />
        </Border.Effect>
        <Grid>
            <!-- つかんで動かす・閉じる -->
            <Grid x:Name="TitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Button x:Name="CloseButton" Style="{StaticResource Close}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="OnClose" ToolTip="閉じる" />
            </Grid>

            <!-- アイコンと名前 -->
            <StackPanel Margin="32,44,32,0" VerticalAlignment="Top">
                <Border Width="72" Height="72" CornerRadius="16" HorizontalAlignment="Center" Background="#131A2A">
                    <Image Source="pack://application:,,,/moon.png" Width="50" Height="50"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="Asteria" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock FontFamily="Yu Gothic UI" FontSize="12.5" Foreground="{StaticResource Sub}"
                           HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Run Text="日本語入力" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Run x:Name="VersionRun" />
                </TextBlock>
                <TextBlock x:Name="VersionText" Visibility="Collapsed" />
            </StackPanel>

            <!-- 中身 -->
            <Grid Margin="32,0,32,40" VerticalAlignment="Bottom" Height="140">
                <TextBlock x:Name="LoadingPage" Text="準備しています…" FontFamily="Yu Gothic UI" FontSize="12.5"
                           Foreground="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- インストール -->
                <Grid x:Name="InstallPage" Visibility="Collapsed">
                    <Border x:Name="DetectChip" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="12"
                            Padding="10,4" Background="#F4F4F5" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DetectIcon" Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="DetectText" FontFamily="Yu Gothic UI" FontSize="12" Foreground="#3F3F46" />
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Primary}" Content="インストール" FontFamily="Yu Gothic UI"
                                Click="OnInstall" IsDefault="True" />
                        <TextBlock FontFamily="Yu Gothic UI" FontSize="11" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Run Text="インストールすると" />
                            <Hyperlink x:Name="LicenseLink" Foreground="{StaticResource Sub}" RequestNavigate="OnLicense"
                                       NavigateUri="https://github.com/aruiki/Asteria-Japanese-IME/blob/main/docs/licenses.md">使用許諾</Hyperlink>
                            <Run Text="に同意したことになります" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- すでに入っている -->
                <Grid x:Name="ModifyPage" Visibility="Collapsed">
                    <TextBlock Text="すでにインストールされています" FontFamily="Yu Gothic UI" FontSize="12.5"
                               Foreground="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,14,0,0" />
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Quiet}" Content="修復" FontFamily="Yu Gothic UI" Click="OnRepair"
                                Margin="0,0,0,8" />
                        <Button Style="{StaticResource Primary}" Content="アンインストール" FontFamily="Yu Gothic UI"
                                Click="OnUninstall" />
                    </StackPanel>
                </Grid>

                <!-- 進行中 -->
                <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,0">
                        <Grid>
                            <TextBlock x:Name="ProgressTitle" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" FontFamily="Yu Gothic UI" FontSize="12.5"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="PercentText" FontSize="12.5" Foreground="{StaticResource Sub}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="4" Margin="0,10,0,0">
                            <Border CornerRadius="2" Background="#F4F4F5" />
                            <Border x:Name="Bar" CornerRadius="2" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="DetailText" FontFamily="Yu Gothic UI" FontSize="11"
                                       Foreground="{StaticResource Faint}" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis" MaxWidth="250" />
                            <TextBlock x:Name="RemainingText" FontFamily="Yu Gothic UI" FontSize="11"
                                       Foreground="{StaticResource Faint}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TipText" FontFamily="Yu Gothic UI" FontSize="12" Foreground="{StaticResource Sub}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                    <Button x:Name="CancelButton" Style="{StaticResource Quiet}" Content="キャンセル" FontFamily="Yu Gothic UI"
                            Click="OnCancel" VerticalAlignment="Bottom" />
                </Grid>

                <!-- 完了 -->
                <Grid x:Name="SuccessPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                        <TextBlock x:Name="SuccessTitle" FontFamily="Yu Gothic UI" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SuccessText" FontFamily="Yu Gothic UI" FontSize="12" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="RestartText" Text="再起動すると使えるようになります" FontFamily="Yu Gothic UI"
                                   FontSize="12" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <Button Style="{StaticResource Primary}" Content="完了" FontFamily="Yu Gothic UI" Click="OnClose"
                            VerticalAlignment="Bottom" />
                </Grid>

                <!-- 失敗 -->
                <Grid x:Name="FailurePage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                        <TextBlock Text="インストールできませんでした" FontFamily="Yu Gothic UI" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#B91C1C" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" FontFamily="Yu Gothic UI" FontSize="12" Foreground="{StaticResource Sub}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxHeight="70" />
                    </StackPanel>
                    <Button Style="{StaticResource Primary}" Content="閉じる" FontFamily="Yu Gothic UI" Click="OnClose"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <!-- 足元: 作り手 -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" FontSize="10.5"
                       Foreground="{StaticResource Faint}">
                <Run Text="by aruiki" /><Run Text="      " /><Hyperlink Foreground="{StaticResource Faint}" TextDecorations="{x:Null}"
                    RequestNavigate="OnLicense" NavigateUri="https://stemstudio.jp/">stemstudio.jp</Hyperlink>
            </TextBlock>
        </Grid>
    </Border>
</Window>
